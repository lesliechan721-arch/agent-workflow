{
  "name": "codex-enhance",
  "version": "0.1.1",
  "description": "通过只读证据探索和通用子代理编排两个技能增强 Codex 的多代理工作流。",
  "compatibility": {
    "aw": {
      "minVersion": "0.0.0"
    }
  },
  "marketplace": {
    "category": "workflow",
    "tags": ["codex", "subagent", "explorer", "research", "reasoning", "wait"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": ["CODEX"]
    }
  },
  "interface": {
    "displayName": "Codex Enhance",
    "shortDescription": "Codex 只读探索与通用子代理编排增强",
    "capabilities": ["Skills", "Instructions", "Agents"]
  },
  "extensions": {
    "instructions": [
      {
        "name": "delegation-authorization",
        "title": "Codex Explore 子代理授权",
        "content": "调用 `codex-explore` 技能且 Gate 通过时，视为用户同意在该工作流中启用子代理；Gate 未通过时不得启动子代理。"
      }
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/explore-artifacts.test.mjs",
        "./scripts/subagent-artifacts.test.mjs",
        "./scripts/trigger-evals.test.mjs",
        "./scripts/model-selection-evals.test.mjs",
        "./scripts/workflow-evals.test.mjs",
        "./scripts/liveness-evals.test.mjs",
        "./scripts/subagent-trigger-evals.test.mjs",
        "./scripts/routing-evals.test.mjs",
        "./scripts/lifecycle-evals.test.mjs"
      ]
    }
  },
  "config": {
    "schema": {
      "quickModel": {
        "type": "string",
        "title": "Quick 探索模型",
        "default": "gpt-5.6-luna",
        "description": "quick 探索 role 使用的模型。"
      },
      "quickReasoningEffort": {
        "type": "enum",
        "title": "Quick 探索推理强度",
        "values": ["low", "medium", "high", "xhigh", "max", "ultra"],
        "default": "medium",
        "description": "quick 探索 role 使用的 model_reasoning_effort。"
      },
      "standardModel": {
        "type": "string",
        "title": "Standard 探索模型",
        "default": "gpt-5.6-luna",
        "description": "standard 探索 role 使用的模型。"
      },
      "standardReasoningEffort": {
        "type": "enum",
        "title": "Standard 探索推理强度",
        "values": ["low", "medium", "high", "xhigh", "max", "ultra"],
        "default": "high",
        "description": "standard 探索 role 使用的 model_reasoning_effort。"
      },
      "deepModel": {
        "type": "string",
        "title": "Deep 探索模型",
        "default": "gpt-5.6-luna",
        "description": "deep 探索 role 使用的模型。"
      },
      "deepReasoningEffort": {
        "type": "enum",
        "title": "Deep 探索推理强度",
        "values": ["low", "medium", "high", "xhigh", "max", "ultra"],
        "default": "xhigh",
        "description": "deep 探索 role 使用的 model_reasoning_effort。"
      },
      "simpleTaskModel": {
        "type": "string",
        "title": "简单任务模型",
        "default": "gpt-5.6-luna",
        "description": "简单任务 agent type 使用的模型，适用于低歧义、边界清晰、成功标准明确的探索、检索、结果验证、简单代码及其他简单任务。"
      },
      "simpleTaskReasoningEffort": {
        "type": "enum",
        "title": "简单任务推理强度",
        "values": ["low", "medium", "high", "xhigh", "max"],
        "default": "max",
        "description": "简单任务 agent type 使用的 model_reasoning_effort。"
      },
      "generalTaskModel": {
        "type": "string",
        "title": "通用任务模型",
        "default": "gpt-5.6-sol",
        "description": "通用任务 agent type 使用的模型，适用于超出简单任务范围的常规实现和其它通用交付。"
      },
      "generalTaskReasoningEffort": {
        "type": "enum",
        "title": "通用任务推理强度",
        "values": ["low", "medium", "high", "xhigh", "max"],
        "default": "medium",
        "description": "通用任务 agent type 使用的 model_reasoning_effort。"
      },
      "complexTaskModel": {
        "type": "string",
        "title": "复杂任务模型",
        "default": "gpt-5.6-sol",
        "description": "复杂任务 agent type 使用的模型，适用于复杂实现、未知根因和调试。"
      },
      "complexTaskReasoningEffort": {
        "type": "enum",
        "title": "复杂任务推理强度",
        "values": ["low", "medium", "high", "xhigh", "max"],
        "default": "high",
        "description": "复杂任务 agent type 使用的 model_reasoning_effort。"
      },
      "planningReviewTaskModel": {
        "type": "string",
        "title": "计划与审核任务模型",
        "default": "gpt-5.6-sol",
        "description": "计划与审核 agent type 使用的模型，适用于审核、架构设计和实施计划。"
      },
      "planningReviewTaskReasoningEffort": {
        "type": "enum",
        "title": "计划与审核任务推理强度",
        "values": ["low", "medium", "high", "xhigh", "max"],
        "default": "xhigh",
        "description": "计划与审核 agent type 使用的 model_reasoning_effort。"
      },
      "minimumInitialWaitMinutes": {
        "type": "number",
        "title": "首次响应式等待窗口（分钟）",
        "default": 10,
        "min": 1,
        "max": 60,
        "description": "两个技能在用户或任务专用规则未指定时使用的最小首次响应式等待窗口。"
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "codex-explore-skill",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.skill",
        "projectManagedKind": "skill",
        "states": ["present"],
        "refreshKeys": ["minimumInitialWaitMinutes"],
        "skillKey": "codex-explore",
        "sourceDirs": ["./skills/codex-explore"]
      },
      {
        "id": "codex-explore-quick-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["quickModel", "quickReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore-quick"
      },
      {
        "id": "codex-explore-standard-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["standardModel", "standardReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore-standard"
      },
      {
        "id": "codex-explore-deep-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["deepModel", "deepReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore-deep"
      },
      {
        "id": "codex-explore-custom-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": [],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore-custom"
      },
      {
        "id": "codex-subagent-guide-skill",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.skill",
        "projectManagedKind": "skill",
        "states": ["present"],
        "refreshKeys": ["minimumInitialWaitMinutes"],
        "skillKey": "codex-subagent-guide",
        "sourceDirs": ["./skills/codex-subagent-guide"]
      },
      {
        "id": "codex-subagent-simple-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["simpleTaskModel", "simpleTaskReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-subagent-simple"
      },
      {
        "id": "codex-subagent-general-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["generalTaskModel", "generalTaskReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-subagent-general"
      },
      {
        "id": "codex-subagent-complex-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["complexTaskModel", "complexTaskReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-subagent-complex"
      },
      {
        "id": "codex-subagent-plan-review-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["planningReviewTaskModel", "planningReviewTaskReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-subagent-plan-review"
      }
    ]
  }
}
