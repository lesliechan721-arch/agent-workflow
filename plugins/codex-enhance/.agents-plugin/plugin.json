              "custom": {
                "properties": {
                  "mode": {
                    "type": "string",
                    "required": true,
                    "choices": {
                      "allowCustom": false,
                      "presets": [
                        {
                          "id": "workspace",
                          "title": "workspace",
                          "value": "workspace"
                        },
                        {
                          "id": "bundle",
                          "title": "bundle",
                          "value": "bundle"
                        }
                      ]
                    }
                  },
                  "command": {
                    "type": "string",
                    "required": true,
                    "validation": {
                      "minLength": 1,
                      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
                      "maxLength": 4096
                    }
                  },
                  "entrypoint": {
                    "type": "string",
                    "validation": {
                      "minLength": 1,
                      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
                      "maxLength": 4096
                    }
                  }
                }
              }
            }
          }
        },
        "validation": {
          "uniqueBy": "key"
