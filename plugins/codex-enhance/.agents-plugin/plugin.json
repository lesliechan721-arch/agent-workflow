{
  "name": "codex-enhance",
  "version": "0.1.0",
  "description": "通过实施前关键歧义澄清、只读证据探索和通用子代理编排增强 Codex harness。",
  "compatibility": {
    "aw": {
      "minVersion": "0.1.0"
    }
  },
  "marketplace": {
    "category": "workflow",
    "tags": [
      "codex",
      "subagent",
      "explorer",
      "clarification",
      "requirements",
      "research",
      "reasoning",
      "wait"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX"
      ]
    }
  },
  "interface": {
    "displayName": "Codex Enhance",
    "shortDescription": "Codex 实施澄清、只读探索与通用子代理编排增强",
    "capabilities": [
      "Skills",
      "Instructions",
      "Agents"
    ]
  },
  "extensions": {
    "instructions": [
      {
        "name": "delegation-authorization",
        "title": "Codex Explore 子代理授权",
        "content": "调用 `codex-explore` 技能且 Gate 通过时，视为用户同意在该工作流中启用子代理；Gate 未通过时不得启动子代理。"
      }
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/clarifier-artifacts.test.mjs",
        "./scripts/clarifier-evals.test.mjs",
        "./scripts/explore-artifacts.test.mjs",
        "./scripts/subagent-artifacts.test.mjs",
        "./scripts/trigger-evals.test.mjs",
        "./scripts/model-selection-evals.test.mjs",
        "./scripts/workflow-evals.test.mjs",
        "./scripts/liveness-evals.test.mjs",
        "./scripts/subagent-trigger-evals.test.mjs",
        "./scripts/routing-evals.test.mjs",
        "./scripts/lifecycle-evals.test.mjs"
      ]
    }
  },
  "config": {
    "schema": {
      "quickModel": {
        "type": "string",
        "title": "Quick 探索模型",
        "default": "gpt-5.6-luna",
        "description": "quick 探索 role 使用的模型。"
      },
      "quickReasoningEffort": {
        "type": "enum",
        "title": "Quick 探索推理强度",
        "values": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ],
        "default": "medium",
        "description": "quick 探索 role 使用的 model_reasoning_effort。"
      },
      "standardModel": {
        "type": "string",
        "title": "Standard 探索模型",
        "default": "gpt-5.6-luna",
        "description": "standard 探索 role 使用的模型。"
      },
      "standardReasoningEffort": {
        "type": "enum",
        "title": "Standard 探索推理强度",
        "values": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ],
        "default": "high",
        "description": "standard 探索 role 使用的 model_reasoning_effort。"
      },
      "deepModel": {
        "type": "string",
        "title": "Deep 探索模型",
        "default": "gpt-5.6-luna",
        "description": "deep 探索 role 使用的模型。"
      },
      "deepReasoningEffort": {
        "type": "enum",
        "title": "Deep 探索推理强度",
        "values": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ],
        "default": "xhigh",
        "description": "deep 探索 role 使用的 model_reasoning_effort。"
      },
      "simpleTaskModel": {
        "type": "string",
        "title": "简单任务模型",
        "default": "gpt-5.6-luna",
        "description": "简单任务 agent type 使用的模型，适用于低歧义、边界清晰、成功标准明确且可机械验证的任务。"
      },
      "simpleTaskReasoningEffort": {
        "type": "enum",
        "title": "简单任务推理强度",
        "values": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "default": "max",
        "description": "简单任务 agent type 使用的 model_reasoning_effort。"
      },
      "generalTaskModel": {
        "type": "string",
        "title": "通用任务模型",
        "default": "gpt-5.6-sol",
        "description": "通用任务 agent type 使用的模型，适用于超出简单范围的常规实现、调查、文档及范围有限的计划或审核。"
      },
      "generalTaskReasoningEffort": {
        "type": "enum",
        "title": "通用任务推理强度",
        "values": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "default": "medium",
        "description": "通用任务 agent type 使用的 model_reasoning_effort。"
      },
      "complexTaskModel": {
        "type": "string",
        "title": "复杂任务模型",
        "default": "gpt-5.6-sol",
        "description": "复杂任务 agent type 使用的模型，适用于跨模块实现、未知根因、并发、生命周期、性能和复杂因果任务。"
      },
      "complexTaskReasoningEffort": {
        "type": "enum",
        "title": "复杂任务推理强度",
        "values": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "default": "high",
        "description": "复杂任务 agent type 使用的 model_reasoning_effort。"
      },
      "advancedTaskModel": {
        "type": "string",
        "title": "高难任务模型",
        "default": "gpt-5.6-sol",
        "description": "高难任务 agent type 使用的模型，适用于系统级、高歧义、高风险或要求极高完整性的任务。"
      },
      "advancedTaskReasoningEffort": {
        "type": "enum",
        "title": "高难任务推理强度",
        "values": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "default": "xhigh",
        "description": "高难任务 agent type 使用的 model_reasoning_effort。"
      },
      "minimumInitialWaitMinutes": {
        "type": "number",
        "title": "首次响应式等待窗口（分钟）",
        "default": 10,
        "min": 1,
        "max": 60,
        "description": "探索和子代理编排技能在没有更具体规则时使用的最小首次响应式等待窗口。"
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "codex-explore-skill",
        "platform": "codex",
        "scopes": [
          "user",
          "project"
        ],
        "target": "codex.skill",
        "projectManagedKind": "skill",
        "states": [
          "present"
        ],
        "refreshKeys": [
          "minimumInitialWaitMinutes"
        ],
        "skillKey": "codex-explore",
        "sourceDirs": [
          "./skills/codex-explore"
        ]
      },
