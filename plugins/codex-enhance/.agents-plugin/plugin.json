{
  "schemaVersion": 3,
  "name": "codex-enhance",
  "version": "0.2.0",
  "description": "在 Codex 中组织已授权的通用委派、只读技术第二意见和大范围事实调查。",
  "marketplace": {
    "category": "workflow",
    "tags": [
      "codex",
      "subagent",
      "explorer",
      "research",
      "reasoning",
      "wait",
      "advisor"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX"
      ]
    }
  },
  "interface": {
    "displayName": "Codex Enhance",
    "shortDescription": "Codex 通用委派、技术第二意见与只读事实调查",
    "capabilities": [
      "Skills",
      "Agents"
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/explore-artifacts.test.mjs",
        "./scripts/subagent-artifacts.test.mjs",
        "./scripts/trigger-evals.test.mjs",
        "./scripts/model-selection-evals.test.mjs",
        "./scripts/workflow-evals.test.mjs",
        "./scripts/liveness-evals.test.mjs",
        "./scripts/subagent-trigger-evals.test.mjs",
        "./scripts/routing-evals.test.mjs",
        "./scripts/lifecycle-evals.test.mjs",
        "./skills/codex-explore/evals/provider-contract.test.mjs",
        "./skills/codex-subagent-guide/evals/provider-contract.test.mjs",
        "./skills/codex-subagent-guide/evals/role-boundary-provider.test.mjs",
        "./scripts/subagent-integration-communication.test.mjs",
        "./scripts/subagent-integration-results.test.mjs",
        "./scripts/subagent-integration-recovery.test.mjs",
        "./scripts/subagent-runtime-logic.test.mjs",
        "./scripts/subagent-plan.test.mjs",
        "./scripts/codex-executable.test.mjs",
        "./scripts/codex-profile.test.mjs",
        "./scripts/antigravity-adapter.test.mjs",
        "./scripts/subagent-adapter-common.test.mjs",
        "./scripts/subagent-protocol-v5.test.mjs",
        "./scripts/subagent-bridge-v5.test.mjs",
        "./scripts/subagent-platform.test.mjs",
        "./scripts/subagent-platform-failures.test.mjs",
        "./scripts/file-selection.test.mjs",
        "./scripts/adapters-integration-inputs.test.mjs",
        "./scripts/adapters-integration-protocol.test.mjs",
        "./scripts/adapters-integration-control.test.mjs",
        "./scripts/adapter-permissions.test.mjs",
        "./scripts/antigravity-permissions.test.mjs"
      ]
    },
    "node": {
      "packageRoot": "./scripts",
      "build": {
        "runner": "node",
        "path": "./scripts/build-runtime.mjs"
      }
    }
  },
  "config": {
    "schemaVersion": 4,
    "definitions": {
      "agentProfile": {
        "type": "object",
        "properties": {
