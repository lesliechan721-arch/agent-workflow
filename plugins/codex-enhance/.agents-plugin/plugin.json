              "title": "gpt-5.6-terra",
              "value": "gpt-5.6-terra"
            },
            {
              "id": "gpt-5.6-sol",
              "title": "gpt-5.6-sol",
              "value": "gpt-5.6-sol"
            }
          ]
        },
        "validation": {
          "minLength": 1
        }
      },
      "agentReasoningEffort": {
        "type": "string",
        "choices": {
          "allowCustom": true,
          "presets": [
            {
              "id": "low",
              "title": "low",
              "value": "low"
            },
            {
              "id": "medium",
              "title": "medium",
              "value": "medium"
            },
            {
              "id": "high",
              "title": "high",
              "value": "high"
            },
            {
              "id": "xhigh",
              "title": "xhigh",
              "value": "xhigh"
            },
            {
              "id": "max",
              "title": "max",
              "value": "max"
            },
            {
              "id": "ultra",
              "title": "ultra",
              "value": "ultra"
            },
            {
              "id": "pro",
              "title": "pro",
              "value": "pro"
            }
          ]
        },
        "validation": {
          "minLength": 1
        },
        "description": "推理强度偏好；pro 可用于 Oracle ChatGPT 浏览器模式，其他后端和模型是否支持由其自身决定。"
      },
      "agentExecutor": {
        "type": "string",
        "title": "执行器",
        "description": "native 或 subagentCommands 中的稳定 key；省略时按 native 解释。",
        "valueRef": {
          "field": "subagentCommands",
          "key": "key",
          "include": [
            "native"
          ]
        },
        "validation": {
          "minLength": 1
        }
      }
    },
    "fields": {
      "quickProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Quick 探索配置",
        "description": "quick 探索 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-luna",
          "reasoningEffort": "medium"
        },
        "required": true
      },
      "standardProfile": {
        "$ref": "#/config/definitions/agentProfile",
