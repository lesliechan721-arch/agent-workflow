      "subagentCommands": {
        "type": "array",
        "title": "外部执行器",
        "description": "注册可信内建或自定义适配器；key 大小写敏感，native 为保留值。配置不替代任务授权。",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "required": true,
              "validation": {
                "minLength": 1
              }
            },
            "adapter": {
              "type": "string",
              "required": true,
              "choices": {
                "allowCustom": false,
                "presets": [
                  {
                    "id": "codex",
                    "title": "codex",
                    "value": "codex"
                  },
                  {
                    "id": "claude-code",
                    "title": "claude-code",
                    "value": "claude-code"
                  },
                  {
                    "id": "antigravity",
                    "title": "antigravity",
                    "value": "antigravity"
                  },
                  {
                    "id": "oracle",
                    "title": "oracle",
                    "value": "oracle"
                  },
                  {
                    "id": "custom",
                    "title": "custom",
                    "value": "custom"
                  }
                ]
              }
            },
            "communication": {
              "type": "boolean",
              "title": "父子通讯",
              "description": "省略时开启；设为 false 时不建立 AW 通讯桥，也不注入通讯工具和指令。开启仍须通过本次适配器能力检查。"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string",
                "validation": {
                  "pattern": "^[^\\x00]*$",
                  "maxLength": 4096
                }
              },
              "validation": {
                "maxItems": 128
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "validation": {
                  "pattern": "^[^\\x00]*$",
                  "maxLength": 4096
                }
              },
              "validation": {
                "key": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "maxLength": 4096
                }
              }
            },
            "envFrom": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "validation": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "maxLength": 4096
                }
              },
              "validation": {
                "key": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "maxLength": 4096
                }
              }
            }
          },
          "additionalProperties": false,
          "variants": {
            "discriminator": "adapter",
            "cases": {
              "codex": {
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "workspace"
                  },
                  "codexProfile": {
                    "type": "string",
                    "title": "Codex 配置 Profile",
                    "description": "从本次有效 CODEX_HOME 读取同名 .config.toml，将支持字段转换为运行时覆盖；未支持字段提示后忽略。不保留原生用户配置层身份，可能覆盖项目配置。AW 显式 model/effort 仍优先。",
                    "validation": {
                      "minLength": 1,
                      "pattern": "^[^\\x00]*[^\\s\\x00][^\\x00]*$",
                      "maxLength": 4096
                    }
                  },
                  "codexCliSource": {
                    "type": "string",
                    "title": "Codex CLI 来源",
                    "description": "省略时使用 auto：先查 PATH，仅没有可执行入口时查 App 内嵌 CLI。cli 只查 PATH；app 只查 App。选定入口失败后不切换来源。",
                    "choices": {
                      "allowCustom": false,
                      "presets": [
                        {
                          "id": "auto",
                          "title": "auto",
                          "value": "auto",
                          "recommended": true
                        },
                        {
                          "id": "cli",
                          "title": "cli",
                          "value": "cli"
                        },
                        {
                          "id": "app",
                          "title": "app",
                          "value": "app"
                        }
                      ]
                    }
                  },
                  "codexBypassHookTrust": {
                    "type": "boolean",
                    "title": "跳过 Codex Hook 信任检查",
                    "description": "省略时关闭。设为 true 会执行本次线程已启用但未受信任或内容已修改的普通 hook，范围不限于所选 profile；仍保留禁用状态和管理策略。它不授予工具审批或沙箱绕过权限。"
                  },
                  "permissionMode": {
                    "type": "string",
                    "title": "权限模式",
                    "description": "省略时为默认，保留用户和项目权限。自动使用后端自动审批；完整权限使用官方 bypass，Codex 同时取消自身沙箱。与父子通讯及 Hook 信任独立。",
                    "choices": {
                      "allowCustom": false,
                      "presets": [
                        {
                          "id": "default",
                          "title": "默认",
                          "value": "default",
                          "recommended": true
                        },
                        {
                          "id": "auto",
                          "title": "自动",
                          "value": "auto"
                        },
                        {
                          "id": "full-access",
                          "title": "完整权限",
                          "value": "full-access"
                        }
                      ]
                    }
                  }
                }
              },
              "claude-code": {
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "workspace"
                  },
                  "permissionMode": {
                    "type": "string",
                    "title": "权限模式",
                    "description": "省略时为默认，保留用户和项目权限。自动使用后端自动审批；完整权限使用官方 bypass，Codex 同时取消自身沙箱。与父子通讯及 Hook 信任独立。",
