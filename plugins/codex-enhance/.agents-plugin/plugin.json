{
  "schemaVersion": 3,
  "name": "codex-enhance",
  "version": "0.2.0",
  "description": "通过只读证据探索和通用子代理编排增强 Codex harness。",
  "marketplace": {
    "category": "workflow",
    "tags": [
      "codex",
      "subagent",
      "explorer",
      "research",
      "reasoning",
      "wait"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX"
      ]
    }
  },
  "interface": {
    "displayName": "Codex Enhance",
    "shortDescription": "Codex 只读探索与通用子代理编排增强",
    "capabilities": [
      "Skills",
      "Agents"
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/explore-artifacts.test.mjs",
        "./scripts/subagent-artifacts.test.mjs",
        "./scripts/trigger-evals.test.mjs",
        "./scripts/model-selection-evals.test.mjs",
        "./scripts/workflow-evals.test.mjs",
        "./scripts/liveness-evals.test.mjs",
        "./scripts/subagent-trigger-evals.test.mjs",
        "./scripts/routing-evals.test.mjs",
        "./scripts/lifecycle-evals.test.mjs",
        "./skills/codex-explore/evals/provider-contract.test.mjs",
        "./skills/codex-subagent-guide/evals/provider-contract.test.mjs"
      ]
    }
  },
  "config": {
    "schemaVersion": 3,
    "definitions": {
      "agentProfile": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "required": true,
            "validation": {
              "minLength": 1
            }
          },
          "reasoningEffort": {
            "type": "string",
            "required": true,
            "choices": {
              "allowCustom": false,
              "presets": [
                {
                  "id": "low",
                  "title": "low",
                  "value": "low"
                },
                {
                  "id": "medium",
                  "title": "medium",
                  "value": "medium"
                },
                {
                  "id": "high",
                  "title": "high",
                  "value": "high"
                },
                {
                  "id": "xhigh",
                  "title": "xhigh",
                  "value": "xhigh"
                },
                {
                  "id": "max",
                  "title": "max",
                  "value": "max"
                },
                {
                  "id": "ultra",
                  "title": "ultra",
                  "value": "ultra"
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "fields": {
      "quickProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Quick 探索配置",
        "description": "quick 探索 调度的模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "model": "gpt-6-luna",
          "reasoningEffort": "medium"
        },
        "required": true
      },
      "standardProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Standard 探索配置",
        "description": "standard 探索 调度的模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "model": "gpt-6-luna",
          "reasoningEffort": "high"
        },
        "required": true
      },
      "deepProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Deep 探索配置",
        "description": "deep 探索 调度的模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "model": "gpt-6-luna",
          "reasoningEffort": "xhigh"
        },
        "required": true
      },
      "simpleTaskProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "简单任务配置",
        "description": "简单任务 调度的模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "model": "gpt-6-luna",
          "reasoningEffort": "max"
        },
        "required": true
      },
      "generalTaskProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "常规任务配置",
        "description": "常规任务 调度的模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "model": "gpt-6-sol",
          "reasoningEffort": "medium"
        },
        "required": true
      },
      "complexTaskProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "复杂任务配置",
        "description": "复杂任务 调度的模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "model": "gpt-6-sol",
          "reasoningEffort": "xhigh"
        },
        "required": true
      },
      "advancedTaskProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "高难任务配置",
        "description": "高难任务 调度的模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "model": "gpt-6-astra",
          "reasoningEffort": "medium"
        },
        "required": true
      }
    },
    "presentation": {
      "groups": [
        {
          "id": "codex-explore",
          "title": "codex-explore",
          "fields": [
            "quickProfile",
            "standardProfile",
            "deepProfile"
          ]
        },
        {
          "id": "codex-subagent-guide",
          "title": "codex-subagent-guide",
          "fields": [
            "simpleTaskProfile",
            "generalTaskProfile",
            "complexTaskProfile",
            "advancedTaskProfile"
          ]
        }
      ],
      "summaries": {
        "modelAndEffort": {
          "kind": "join",
          "parts": [
            {
              "path": "/model"
            },
            {
              "path": "/reasoningEffort"
            }
          ],
          "separator": "/",
          "missing": "未设置"
        }
      },
      "fieldViews": {
        "quickProfile": {
          "summary": "modelAndEffort"
        },
        "standardProfile": {
          "summary": "modelAndEffort"
        },
        "deepProfile": {
          "summary": "modelAndEffort"
        },
        "simpleTaskProfile": {
          "summary": "modelAndEffort"
        },
        "generalTaskProfile": {
          "summary": "modelAndEffort"
        },
        "complexTaskProfile": {
          "summary": "modelAndEffort"
        },
        "advancedTaskProfile": {
          "summary": "modelAndEffort"
        }
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "codex-explore-skill",
        "platform": "codex",
        "scopes": [
          "user",
          "project"
        ],
        "target": "codex.skill",
        "delivery": {
          "mode": "codex-native",
          "identity": "shared",
          "renderProfile": "user"
        },
        "projectManagedKind": "skill",
        "states": [
          "present"
        ],
        "refreshKeys": [
          "quickProfile",
          "standardProfile",
          "deepProfile"
        ],
        "skillKey": "codex-explore",
        "sourceDirs": [
          "./skills/codex-explore"
        ]
      },
      {
        "id": "codex-explore-role",
        "platform": "codex",
        "scopes": [
          "user",
          "project"
        ],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": [
          "present"
        ],
        "refreshKeys": [],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore"
      },
      {
        "id": "codex-subagent-guide-skill",
        "platform": "codex",
        "scopes": [
          "user",
          "project"
        ],
        "target": "codex.skill",
        "delivery": {
          "mode": "codex-native",
          "identity": "shared",
          "renderProfile": "user"
        },
        "projectManagedKind": "skill",
        "states": [
          "present"
        ],
        "refreshKeys": [
          "simpleTaskProfile",
          "generalTaskProfile",
          "complexTaskProfile",
          "advancedTaskProfile"
        ],
        "skillKey": "codex-subagent-guide",
        "sourceDirs": [
          "./skills/codex-subagent-guide"
        ]
      },
      {
        "id": "codex-subagent-role",
        "platform": "codex",
        "scopes": [
          "user",
          "project"
        ],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": [
          "present"
        ],
        "refreshKeys": [],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-subagent"
      }
    ]
  }
}
