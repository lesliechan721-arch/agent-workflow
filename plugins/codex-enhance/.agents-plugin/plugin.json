{
  "schemaVersion": 3,
  "name": "codex-enhance",
  "version": "0.2.0",
  "description": "在 Codex 中组织已授权的通用委派、只读技术第二意见和大范围事实调查。",
  "marketplace": {
    "category": "workflow",
    "tags": [
      "codex",
      "subagent",
      "explorer",
      "research",
      "reasoning",
      "wait",
      "advisor"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX"
      ]
    }
  },
  "interface": {
    "displayName": "Codex Enhance",
    "shortDescription": "Codex 通用委派、技术第二意见与只读事实调查",
    "capabilities": [
      "Skills",
      "Agents"
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/explore-artifacts.test.mjs",
        "./scripts/subagent-artifacts.test.mjs",
        "./scripts/trigger-evals.test.mjs",
        "./scripts/model-selection-evals.test.mjs",
        "./scripts/workflow-evals.test.mjs",
        "./scripts/liveness-evals.test.mjs",
        "./scripts/subagent-trigger-evals.test.mjs",
        "./scripts/routing-evals.test.mjs",
        "./scripts/lifecycle-evals.test.mjs",
        "./skills/codex-explore/evals/provider-contract.test.mjs",
        "./skills/codex-subagent-guide/evals/provider-contract.test.mjs",
        "./skills/codex-subagent-guide/evals/role-boundary-provider.test.mjs",
        "./scripts/subagent-runtime.test.mjs"
      ]
    }
  },
  "config": {
    "schemaVersion": 3,
    "definitions": {
      "agentProfile": {
        "type": "object",
        "properties": {
          "executor": {
            "type": "string",
            "title": "执行器",
            "description": "native 或 subagentCommands 中的稳定 key；旧 profile 省略时按 native 解释。",
            "valueRef": {
              "field": "subagentCommands",
              "key": "key",
              "label": "title",
              "include": [
                "native"
              ]
            },
            "validation": {
              "minLength": 1
            }
          },
          "model": {
            "type": "string",
            "required": true,
            "choices": {
              "allowCustom": true,
              "presets": [
                {
                  "id": "gpt-6.1-sol",
                  "title": "gpt-6.1-sol",
                  "value": "gpt-6.1-sol"
                },
                {
                  "id": "gpt-6-luna",
                  "title": "gpt-6-luna",
                  "value": "gpt-6-luna"
                },
                {
                  "id": "gpt-6-astra",
                  "title": "gpt-6-astra",
                  "value": "gpt-6-astra"
                },
                {
                  "id": "gpt-6-sol",
                  "title": "gpt-6-sol",
                  "value": "gpt-6-sol"
                },
                {
                  "id": "gpt-5.6-luna",
                  "title": "gpt-5.6-luna",
                  "value": "gpt-5.6-luna"
                },
                {
                  "id": "gpt-5.6-terra",
                  "title": "gpt-5.6-terra",
                  "value": "gpt-5.6-terra"
                },
                {
                  "id": "gpt-5.6-sol",
                  "title": "gpt-5.6-sol",
                  "value": "gpt-5.6-sol"
                }
              ]
            },
            "validation": {
              "minLength": 1
            }
          },
          "reasoningEffort": {
            "type": "string",
            "required": true,
            "choices": {
              "allowCustom": true,
              "presets": [
                {
                  "id": "low",
                  "title": "low",
                  "value": "low"
                },
                {
                  "id": "medium",
                  "title": "medium",
                  "value": "medium"
                },
                {
                  "id": "high",
                  "title": "high",
                  "value": "high"
                },
                {
                  "id": "xhigh",
                  "title": "xhigh",
                  "value": "xhigh"
                },
                {
                  "id": "max",
                  "title": "max",
                  "value": "max"
                },
                {
                  "id": "ultra",
                  "title": "ultra",
                  "value": "ultra"
                }
              ]
            },
            "validation": {
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "fields": {
      "quickProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Quick 探索配置",
        "description": "quick 探索 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-luna",
          "reasoningEffort": "medium"
        },
        "required": true
      },
      "standardProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Standard 探索配置",
        "description": "standard 探索 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-luna",
          "reasoningEffort": "high"
        },
        "required": true
      },
      "deepProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Deep 探索配置",
        "description": "deep 探索 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-luna",
          "reasoningEffort": "xhigh"
        },
        "required": true
      },
      "simpleTaskProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "简单任务配置",
        "description": "简单任务 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-luna",
          "reasoningEffort": "max"
        },
        "required": true
      },
      "generalTaskProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "常规任务配置",
        "description": "常规任务 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6.1-sol",
          "reasoningEffort": "medium"
        },
        "required": true
      },
      "complexTaskProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "复杂任务配置",
        "description": "复杂任务 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6.1-sol",
          "reasoningEffort": "xhigh"
        },
        "required": true
      },
      "advancedTaskProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "高难任务配置",
        "description": "高难任务 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-astra",
          "reasoningEffort": "high"
        },
        "required": true
      },
      "advisorProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "General 咨询配置",
        "description": "通用第二意见的完整执行配置；专属配置缺省时使用，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-astra",
          "reasoningEffort": "high"
        },
        "required": true
      },
      "subagentCommands": {
        "type": "array",
        "title": "外部执行器",
        "description": "注册可信适配器的绝对路径；key 大小写敏感，native 为保留值。支持声明不能替代实际环境验证。",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "required": true,
              "validation": {
                "minLength": 1
              }
            },
            "title": {
              "type": "string",
              "required": true,
              "validation": {
                "minLength": 1
              }
            },
            "mode": {
              "type": "string",
              "required": true,
              "choices": {
                "allowCustom": false,
                "presets": [
                  {
                    "id": "workspace",
                    "title": "workspace",
                    "value": "workspace"
                  },
                  {
                    "id": "bundle",
                    "title": "bundle",
                    "value": "bundle"
                  }
                ]
              }
            },
            "command": {
              "type": "string",
              "required": true,
              "validation": {
                "minLength": 1,
                "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
                "maxLength": 4096
              }
            },
            "entrypoint": {
              "type": "string",
              "validation": {
                "minLength": 1,
                "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
                "maxLength": 4096
              }
            },
            "supportsSystemInstructions": {
              "type": "boolean"
            },
            "supportsReadOnly": {
              "type": "boolean"
            },
            "supportsWorkspaceWrite": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "validation": {
          "uniqueBy": "key"
        },
        "default": [],
        "required": true
      },
      "advisorDesignProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Design 设计咨询配置",
        "description": "design 咨询的完整执行配置；缺省时使用 advisorProfile，不继承其属性，仅支持 user scope。"
      },
      "advisorDebugProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Debug 诊断咨询配置",
        "description": "debug 咨询的完整执行配置；缺省时使用 advisorProfile，不继承其属性，仅支持 user scope。"
      },
      "advisorReviewProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Review 审查咨询配置",
        "description": "review 咨询的完整执行配置；缺省时使用 advisorProfile，不继承其属性，仅支持 user scope。"
      }
    },
    "presentation": {
      "groups": [
        {
          "id": "codex-explore",
          "title": "codex-explore",
          "fields": [
            "quickProfile",
            "standardProfile",
            "deepProfile"
          ]
        },
        {
          "id": "codex-subagent-guide",
          "title": "codex-subagent-guide",
          "fields": [
            "simpleTaskProfile",
            "generalTaskProfile",
            "complexTaskProfile",
            "advancedTaskProfile"
          ]
        },
        {
          "id": "codex-advisor",
          "title": "codex-advisor",
          "fields": [
            "advisorProfile",
            "advisorDesignProfile",
            "advisorDebugProfile",
            "advisorReviewProfile"
          ]
        },
        {
          "id": "executors",
          "title": "外部执行器",
          "fields": [
            "subagentCommands"
          ],
          "advanced": true
        }
      ],
      "summaries": {
        "modelAndEffort": {
          "kind": "join",
          "parts": [
            {
              "path": "/executor"
            },
            {
              "path": "/model"
            },
            {
              "path": "/reasoningEffort"
            }
          ],
          "separator": "/",
          "missing": "未设置"
        }
      },
      "fieldViews": {
        "quickProfile": {
          "summary": "modelAndEffort"
        },
        "standardProfile": {
          "summary": "modelAndEffort"
        },
        "deepProfile": {
          "summary": "modelAndEffort"
        },
        "simpleTaskProfile": {
          "summary": "modelAndEffort"
        },
        "generalTaskProfile": {
          "summary": "modelAndEffort"
        },
        "complexTaskProfile": {
          "summary": "modelAndEffort"
        },
        "advancedTaskProfile": {
          "summary": "modelAndEffort"
        },
        "advisorProfile": {
          "summary": "modelAndEffort"
        },
        "advisorDesignProfile": {
          "summary": "modelAndEffort"
        },
        "advisorDebugProfile": {
          "summary": "modelAndEffort"
        },
        "advisorReviewProfile": {
          "summary": "modelAndEffort"
        }
      }
    }
  },
  "artifacts": {
    "targets": [
