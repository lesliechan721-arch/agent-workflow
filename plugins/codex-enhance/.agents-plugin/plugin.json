              "oracle": {
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "bundle"
                  },
                  "oracleEngine": {
                    "type": "string",
                    "title": "Oracle 引擎",
                    "description": "browser 使用已登录浏览器会话，api 使用服务 API。留空跟随 Oracle；设置 reasoningEffort 时须明确选择引擎。安装和登录由 Oracle 管理。",
                    "choices": {
                      "allowCustom": false,
                      "presets": [
                        {
                          "id": "browser",
