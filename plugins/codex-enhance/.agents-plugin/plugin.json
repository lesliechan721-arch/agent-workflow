            "$ref": "#/config/definitions/agentExecutor"
          }
        },
        "additionalProperties": false,
        "variants": {
          "discriminator": "executor",
          "missing": "native",
          "cases": {
            "native": {
              "properties": {
                "model": {
                  "$ref": "#/config/definitions/agentModel",
                  "required": true
                },
                "reasoningEffort": {
                  "$ref": "#/config/definitions/agentReasoningEffort",
                  "required": true
                }
              }
            }
          },
          "otherwise": {
            "properties": {
              "model": {
                "$ref": "#/config/definitions/agentModel"
              },
              "reasoningEffort": {
                "$ref": "#/config/definitions/agentReasoningEffort"
              }
