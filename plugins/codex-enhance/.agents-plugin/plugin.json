{
  "schemaVersion": 3,
  "name": "codex-enhance",
  "version": "0.2.0",
  "description": "在 Codex 中组织只读技术第二意见和大范围事实调查。",
  "platforms": [
    "codex"
  ],
  "marketplace": {
    "category": "workflow",
    "tags": [
      "codex",
      "subagent",
      "explorer",
      "research",
      "reasoning",
      "wait",
      "advisor"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "interface": {
    "displayName": "Codex Enhance",
    "shortDescription": "Codex 技术第二意见与只读事实调查",
    "capabilities": [
      "Skills",
      "Agents"
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/explore-artifacts.test.mjs",
        "./scripts/profile-artifacts.test.mjs",
        "./scripts/trigger-evals.test.mjs",
        "./scripts/model-selection-evals.test.mjs",
        "./scripts/workflow-evals.test.mjs",
        "./scripts/liveness-evals.test.mjs",
        "./skills/codex-explore/evals/provider-contract.test.mjs"
      ]
    }
  },
  "config": {
    "schemaVersion": 5,
    "definitions": {
      "agentProfile": {
        "type": "object",
        "properties": {
          "executor": {
            "$ref": "#/config/definitions/agentExecutor"
          }
        },
        "additionalProperties": false,
        "variants": {
          "discriminator": "executor",
          "missing": "native",
          "cases": {
            "native": {
              "properties": {
                "model": {
                  "$ref": "#/config/definitions/agentModel",
                  "required": true
                },
                "reasoningEffort": {
                  "$ref": "#/config/definitions/agentReasoningEffort",
                  "required": true
                }
              }
            }
          },
          "otherwise": {
            "properties": {
              "model": {
                "$ref": "#/config/definitions/agentModel"
              },
              "reasoningEffort": {
                "$ref": "#/config/definitions/agentReasoningEffort"
              }
            }
          }
        }
      },
      "agentModel": {
        "type": "string",
        "choices": {
          "allowCustom": true,
          "presets": [
            {
              "id": "gpt-6.1-sol",
              "title": "gpt-6.1-sol",
              "value": "gpt-6.1-sol"
            },
            {
              "id": "gpt-6-luna",
              "title": "gpt-6-luna",
              "value": "gpt-6-luna"
            },
            {
              "id": "gpt-6-astra",
              "title": "gpt-6-astra",
              "value": "gpt-6-astra"
            },
            {
              "id": "gpt-6-sol",
              "title": "gpt-6-sol",
              "value": "gpt-6-sol"
            },
            {
              "id": "gpt-5.6-luna",
              "title": "gpt-5.6-luna",
              "value": "gpt-5.6-luna"
            },
            {
              "id": "gpt-5.6-terra",
              "title": "gpt-5.6-terra",
              "value": "gpt-5.6-terra"
            },
            {
              "id": "gpt-5.6-sol",
              "title": "gpt-5.6-sol",
              "value": "gpt-5.6-sol"
            }
          ]
        },
        "validation": {
          "minLength": 1
        }
      },
      "agentReasoningEffort": {
        "type": "string",
        "choices": {
          "allowCustom": true,
          "presets": [
            {
              "id": "low",
              "title": "low",
              "value": "low"
            },
            {
              "id": "medium",
              "title": "medium",
              "value": "medium"
            },
            {
              "id": "high",
              "title": "high",
              "value": "high"
            },
            {
              "id": "xhigh",
              "title": "xhigh",
              "value": "xhigh"
            },
            {
              "id": "max",
              "title": "max",
              "value": "max"
            },
            {
              "id": "ultra",
              "title": "ultra",
              "value": "ultra"
            },
            {
              "id": "pro",
              "title": "pro",
              "value": "pro"
            }
          ]
        },
        "validation": {
          "minLength": 1
        },
        "description": "推理强度偏好；pro 可用于 Oracle ChatGPT 浏览器模式，其他后端和模型是否支持由其自身决定。"
      },
      "agentExecutor": {
        "type": "string",
        "title": "执行器",
        "description": "native 或 subagentCommands 中的稳定 key；省略时按 native 解释。",
        "valueRef": {
          "field": "subagentCommands",
          "key": "key",
          "include": [
            "native"
          ],
          "plugin": "agent-subagent"
        },
        "validation": {
          "minLength": 1
        }
      }
    },
    "fields": {
      "quickProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Quick 探索配置",
        "description": "quick 探索 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-luna",
          "reasoningEffort": "medium"
        },
        "required": true
      },
      "standardProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Standard 探索配置",
        "description": "standard 探索 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-luna",
          "reasoningEffort": "high"
        },
        "required": true
      },
      "deepProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "Deep 探索配置",
        "description": "deep 探索 调度的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-luna",
          "reasoningEffort": "xhigh"
        },
        "required": true
      },
      "advisorGeneralProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "general 咨询配置",
        "description": "general 难度咨询的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-astra",
          "reasoningEffort": "high"
        },
        "required": true
      },
      "advisorAdvancedProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "advanced 咨询配置",
        "description": "advanced 难度咨询的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-astra",
          "reasoningEffort": "xhigh"
        },
        "required": true
      },
      "advisorExpertProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "title": "expert 咨询配置",
        "description": "expert 难度咨询的执行器、模型与推理强度偏好，仅支持 user scope。",
        "default": {
          "executor": "native",
          "model": "gpt-6-astra",
          "reasoningEffort": "max"
        },
        "required": true
      },
      "exploreCustomProfiles": {
        "type": "array",
        "title": "探索自定义配置",
        "description": "按数组顺序采用首个适用范围匹配项；未匹配时使用内建档位，仅支持 user scope。",
        "items": {
          "type": "object",
          "properties": {
            "applicability": {
              "type": "string",
              "title": "适用范围",
              "required": true,
              "validation": {
                "minLength": 1
              }
            },
            "executor": {
              "$ref": "#/config/definitions/agentExecutor"
            }
          },
          "additionalProperties": false,
          "variants": {
            "discriminator": "executor",
            "missing": "native",
            "cases": {
              "native": {
                "properties": {
                  "model": {
                    "$ref": "#/config/definitions/agentModel",
                    "required": true
                  },
                  "reasoningEffort": {
                    "$ref": "#/config/definitions/agentReasoningEffort",
                    "required": true
                  }
                }
              }
            },
            "otherwise": {
              "properties": {
                "model": {
                  "$ref": "#/config/definitions/agentModel"
                },
                "reasoningEffort": {
                  "$ref": "#/config/definitions/agentReasoningEffort"
                }
              }
            }
          }
        },
        "default": [],
        "required": true
      },
      "advisorCustomProfiles": {
        "type": "array",
        "title": "咨询自定义配置",
        "description": "按数组顺序采用首个适用范围匹配项；未匹配时使用内建档位，仅支持 user scope。",
        "items": {
          "type": "object",
          "properties": {
            "applicability": {
              "type": "string",
              "title": "适用范围",
              "required": true,
              "validation": {
                "minLength": 1
              }
            },
            "executor": {
              "$ref": "#/config/definitions/agentExecutor"
            }
          },
          "additionalProperties": false,
          "variants": {
            "discriminator": "executor",
            "missing": "native",
            "cases": {
              "native": {
                "properties": {
                  "model": {
                    "$ref": "#/config/definitions/agentModel",
                    "required": true
                  },
                  "reasoningEffort": {
                    "$ref": "#/config/definitions/agentReasoningEffort",
                    "required": true
                  }
                }
              }
            },
            "otherwise": {
              "properties": {
                "model": {
                  "$ref": "#/config/definitions/agentModel"
                },
                "reasoningEffort": {
                  "$ref": "#/config/definitions/agentReasoningEffort"
                }
              }
            }
          }
        },
        "default": [],
        "required": true
      }
    },
    "presentation": {
      "groups": [
        {
          "id": "codex-explore",
          "title": "codex-explore",
          "fields": [
            "quickProfile",
            "standardProfile",
            "deepProfile",
            "exploreCustomProfiles"
          ]
        },
        {
          "id": "codex-advisor",
          "title": "codex-advisor",
          "fields": [
            "advisorGeneralProfile",
            "advisorAdvancedProfile",
            "advisorExpertProfile",
            "advisorCustomProfiles"
          ]
        }
      ],
      "summaries": {
        "modelAndEffort": {
          "kind": "join",
          "parts": [
            {
              "path": "/executor"
            },
            {
              "path": "/model"
            },
            {
              "path": "/reasoningEffort"
            }
          ],
          "separator": "/",
          "missing": "未设置"
        }
      },
      "fieldViews": {
        "quickProfile": {
          "summary": "modelAndEffort"
        },
        "standardProfile": {
          "summary": "modelAndEffort"
        },
        "deepProfile": {
          "summary": "modelAndEffort"
        },
        "advisorGeneralProfile": {
          "summary": "modelAndEffort"
        },
        "advisorAdvancedProfile": {
          "summary": "modelAndEffort"
        },
        "advisorExpertProfile": {
          "summary": "modelAndEffort"
        }
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "codex-explore-skill",
        "platform": "codex",
        "scopes": [
          "user",
          "project"
        ],
        "target": "codex.skill",
        "projectManagedKind": "skill",
        "states": [
          "present"
        ],
        "refreshKeys": [
          "quickProfile",
          "standardProfile",
          "deepProfile",
          "exploreCustomProfiles"
        ],
        "skillKey": "codex-explore",
        "sourceDirs": [
          "./skills/codex-explore"
        ]
      },
      {
        "id": "codex-explore-role",
        "platform": "codex",
        "scopes": [
          "user",
          "project"
        ],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": [
          "present"
        ],
        "refreshKeys": [],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore"
      },
      {
        "id": "codex-advisor-skill",
        "platform": "codex",
        "scopes": [
          "user",
          "project"
        ],
        "target": "codex.skill",
        "projectManagedKind": "skill",
        "states": [
          "present"
        ],
        "refreshKeys": [
          "advisorGeneralProfile",
          "advisorAdvancedProfile",
          "advisorExpertProfile",
          "advisorCustomProfiles"
        ],
        "skillKey": "codex-advisor",
        "sourceDirs": [
          "./skills/codex-advisor"
        ]
      },
      {
        "id": "codex-advisor-role",
        "platform": "codex",
        "scopes": [
          "user",
          "project"
        ],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": [
          "present"
        ],
        "refreshKeys": [],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-advisor"
      }
    ]
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-config.v5",
        "aw.plugin-config-value-ref.v1",
        "aw.plugin-config-cross-plugin-value-ref.v1"
      ]
    }
  },
  "dependencies": [
    "agent-subagent"
  ]
}
