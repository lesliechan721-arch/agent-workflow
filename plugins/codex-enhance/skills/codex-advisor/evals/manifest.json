{
  "version": 1,
  "defaults": {
    "profile": "project-default"
  },
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {}
      }
    },
    "user-default": {
      "scope": "user",
      "plugins": {
        "codex-enhance": {}
      }
    },
    "user-custom": {
      "scope": "user",
      "plugins": {
        "codex-enhance": {
          "advisorCustomProfiles": [
            {
              "applicability": "数据库锁与事务语义的咨询",
              "executor": "native",
              "model": "gpt-6.1-sol",
              "reasoningEffort": "high"
            },
            {
              "applicability": "涉及数据库的咨询",
              "executor": "native",
              "model": "gpt-6-astra",
              "reasoningEffort": "max"
            }
          ],
          "taskCustomProfiles": [
            {
              "applicability": "任何任务",
              "executor": "native",
              "model": "gpt-6-luna",
              "reasoningEffort": "low"
            }
          ]
        }
      }
    }
  },
  "suites": [
    {
      "id": "role-boundary-trigger",
      "kind": "trigger",
      "cases": "role-boundary-trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000
    },
    {
      "id": "coordinator-behavior",
      "kind": "conversation",
      "cases": "coordinator-behavior-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 900000
    },
    {
      "id": "execution-configuration",
      "kind": "conversation",
      "cases": "execution-configuration-cases.json",
      "profiles": [
        "user-custom"
      ],
      "runs": 1,
      "timeoutMs": 900000
    }
  ]
}
