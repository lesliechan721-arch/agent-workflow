{
  "version": 1,
  "suite": {
    "kind": "codex-workflow",
    "unitUnderTest": "codex-explore",
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "medium",
      "falsePositiveCost": "medium",
      "rationale": "该 suite 只比较长等待期间是否需要主动状态探测，不参与发布门禁，也不得单独驱动生产 Skill 修改。"
    }
  },
  "cases": [
    {
      "id": "v2_long_progress",
      "split": "validation",
      "tags": [
        "diagnostic"
      ],
      "input": {
        "prompt": "$codex-explore 当前没有其它可并行的本地工作。请委派 standard role，先运行只读命令 `node docs/liveness/verify-records.mjs`，等待它完成，再核验 docs/liveness/records/ 下全部记录中的 timeout 分布并给出可复核文件证据；不得绕过该校验，也不要修改文件。最终答复末尾逐行输出：`FACT records=<记录总数>`、`FACT timeout_values=<升序逗号分隔值>`。",
        "codex_config": {
          "features.multi_agent_v2.enabled": true,
          "features.multi_agent_v2.hide_spawn_agent_metadata": true,
          "features.multi_agent_v2.expose_spawn_agent_model_overrides": true
        }
      },
      "expected": {
        "criteria": {
          "agent_type": "codex-explore-standard",
          "final_message_includes_all": [
            "docs/liveness/records/",
            "FACT records=120",
            "FACT timeout_values=30,45,60"
          ],
          "delegated_source_prefixes": [
            "docs/liveness/"
          ],
          "workspace_unchanged": true,
          "lifecycle": {
            "minimum_initial_wait_timeout_ms": 60000,
            "allow_liveness_probe": false,
            "max_recoveries": 1
          }
        }
      }
    },
    {
      "id": "v2_late_blocked",
      "split": "validation",
      "tags": [
        "diagnostic"
      ],
      "input": {
        "prompt": "$codex-explore 当前没有其它可并行的本地工作。请委派 standard role，先运行只读命令 `node docs/liveness/verify-records.mjs`，等待它完成并核验 docs/liveness/records/ 下全部记录，再用应存在的 docs/liveness/authoritative-index.md 判断哪个 timeout 是权威值。不得绕过该校验；缺少决定性来源时不要猜，说明阻塞或证据不足并等待探索结束；不要修改文件。最终答复末尾逐行输出：`FACT records=<记录总数>`、`FACT authority_available=<true|false>`。",
        "codex_config": {
          "features.multi_agent_v2.enabled": true,
          "features.multi_agent_v2.hide_spawn_agent_metadata": true,
          "features.multi_agent_v2.expose_spawn_agent_model_overrides": true
        }
      },
      "expected": {
        "criteria": {
          "agent_type": "codex-explore-standard",
          "final_message_includes_all": [
            "docs/liveness/authoritative-index.md",
            "FACT records=120",
            "FACT authority_available=false"
          ],
          "delegated_source_prefixes": [
            "docs/liveness/"
          ],
          "workspace_unchanged": true,
          "lifecycle": {
            "minimum_initial_wait_timeout_ms": 60000,
            "allow_liveness_probe": false,
            "max_recoveries": 1
          }
        }
      }
    },
    {
      "id": "v1_long_progress",
      "split": "validation",
      "tags": [
        "diagnostic"
      ],
      "input": {
        "parent_model": "gpt-5.5",
        "prompt": "$codex-explore 当前没有其它可并行的本地工作。请使用 V1 委派 standard role，先运行只读命令 `node docs/liveness/verify-records.mjs`，等待它完成，再核验 docs/liveness/records/ 下全部记录中的 timeout 分布并给出可复核文件证据；不得绕过该校验，也不要修改文件。最终答复末尾逐行输出：`FACT records=<记录总数>`、`FACT timeout_values=<升序逗号分隔值>`。",
        "codex_config": {
          "features.multi_agent_v2.enabled": false
        }
      },
      "expected": {
        "criteria": {
          "agent_type": "codex-explore-standard",
          "final_message_includes_all": [
            "docs/liveness/records/",
            "FACT records=120",
            "FACT timeout_values=30,45,60"
          ],
          "delegated_source_prefixes": [
            "docs/liveness/"
          ],
          "workspace_unchanged": true,
          "lifecycle": {
            "minimum_initial_wait_timeout_ms": 60000,
            "allow_liveness_probe": false,
            "max_recoveries": 1
          }
        }
      }
    }
  ]
}
