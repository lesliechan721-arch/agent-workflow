{
  "version": 1,
  "defaults": {
    "profile": "project-default"
  },
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {}
      }
    },
    "user-default": {
      "scope": "user",
      "plugins": {
        "codex-enhance": {}
      }
    },
    "project-nondefault": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {
          "quickProfile": {
            "model": "eval-quick-model",
            "reasoningEffort": "high"
          },
          "standardProfile": {
            "model": "eval-standard-model",
            "reasoningEffort": "xhigh"
          },
          "deepProfile": {
            "model": "eval-deep-model",
            "reasoningEffort": "max"
          }
        }
      }
    },
    "user-nondefault": {
      "scope": "user",
      "plugins": {
        "codex-enhance": {
          "quickProfile": {
            "model": "eval-quick-model",
            "reasoningEffort": "high"
          },
          "standardProfile": {
            "model": "eval-standard-model",
            "reasoningEffort": "xhigh"
          },
          "deepProfile": {
            "model": "eval-deep-model",
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "cases": "trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000
    },
    {
      "id": "model-selection",
      "kind": "codex-workflow",
      "cases": "evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 900000,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "run-model-selection-evals.mjs"
        ],
        "allowedModels": []
      }
    },
    {
      "id": "workflow",
      "kind": "codex-workflow",
      "cases": "workflow-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 900000,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "run-workflow-evals.mjs"
        ],
        "allowedModels": []
      }
    },
    {
      "id": "output-contract",
      "kind": "codex-workflow",
      "cases": "output-contract-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 900000,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "run-workflow-evals.mjs"
        ],
        "allowedModels": []
      }
    },
    {
      "id": "liveness",
      "kind": "codex-workflow",
      "cases": "liveness-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 300000,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "run-liveness-evals.mjs"
        ],
        "allowedModels": []
      }
    },
    {
      "id": "role-boundary-trigger",
      "kind": "trigger",
      "cases": "role-boundary-trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000
    },
    {
      "id": "coordinator-behavior",
      "kind": "conversation",
      "cases": "coordinator-behavior-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 900000
    }
  ]
}
