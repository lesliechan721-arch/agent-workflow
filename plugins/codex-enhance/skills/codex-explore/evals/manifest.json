{
  "version": 1,
  "defaults": {
    "profile": "project-default"
  },
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {}
      }
    },
    "user-default": {
      "scope": "user",
      "plugins": {
        "codex-enhance": {}
      }
    },
    "project-nondefault": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {
          "quickModel": "eval-quick-model",
          "quickReasoningEffort": "high",
          "standardModel": "eval-standard-model",
          "standardReasoningEffort": "xhigh",
          "deepModel": "eval-deep-model",
          "deepReasoningEffort": "max",
          "exploreMinimumInitialWaitMinutes": 2
        }
      }
    },
    "project-short-wait": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {
          "exploreMinimumInitialWaitMinutes": 1
        }
      }
    },
    "user-nondefault": {
      "scope": "user",
      "plugins": {
        "codex-enhance": {
          "quickModel": "eval-quick-model",
          "quickReasoningEffort": "high",
          "standardModel": "eval-standard-model",
          "standardReasoningEffort": "xhigh",
          "deepModel": "eval-deep-model",
          "deepReasoningEffort": "max",
          "exploreMinimumInitialWaitMinutes": 2
        }
      }
    }
  },
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "cases": "trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation",
        "sanity"
      ]
    },
    {
      "id": "model-selection",
      "kind": "custom-process",
      "cases": "evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 900000,
      "requiredForRelease": true,
      "provider": {
        "type": "custom-process",
        "command": [
          "node",
          "run-model-selection-evals.mjs"
        ]
      }
    },
    {
      "id": "workflow",
      "kind": "custom-process",
      "cases": "workflow-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 900000,
      "requiredForRelease": true,
      "provider": {
        "type": "custom-process",
        "command": [
          "node",
          "run-workflow-evals.mjs"
        ]
      }
    },
    {
      "id": "output-contract",
      "kind": "custom-process",
      "cases": "output-contract-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 900000,
      "requiredForRelease": true,
      "provider": {
        "type": "custom-process",
        "command": [
          "node",
          "run-workflow-evals.mjs"
        ]
      }
    },
    {
      "id": "liveness",
      "kind": "custom-process",
      "cases": "liveness-evals.json",
      "profiles": [
        "project-short-wait"
      ],
      "runs": 3,
      "timeoutMs": 300000,
      "requiredForRelease": false,
      "provider": {
        "type": "custom-process",
        "command": [
          "node",
          "run-liveness-evals.mjs"
        ]
      }
    }
  ]
}
