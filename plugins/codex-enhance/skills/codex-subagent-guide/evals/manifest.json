{
  "version": 1,
  "defaults": {
    "profile": "project-default"
  },
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {}
      }
    },
    "project-timeout": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {
          "subagentMinimumInitialWaitMinutes": 1
        }
      }
    },
    "user-default": {
      "scope": "user",
      "plugins": {
        "codex-enhance": {}
      }
    },
    "project-nondefault": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {
          "simpleTaskModel": "eval-simple-model",
          "simpleTaskReasoningEffort": "high",
          "generalTaskModel": "eval-general-model",
          "generalTaskReasoningEffort": "xhigh",
          "complexTaskModel": "eval-complex-model",
          "complexTaskReasoningEffort": "max",
          "advancedTaskModel": "eval-advanced-model",
          "advancedTaskReasoningEffort": "high",
          "subagentMinimumInitialWaitMinutes": 2
        }
      }
    },
    "user-nondefault": {
      "scope": "user",
      "plugins": {
        "codex-enhance": {
          "simpleTaskModel": "eval-simple-model",
          "simpleTaskReasoningEffort": "high",
          "generalTaskModel": "eval-general-model",
          "generalTaskReasoningEffort": "xhigh",
          "complexTaskModel": "eval-complex-model",
          "complexTaskReasoningEffort": "max",
          "advancedTaskModel": "eval-advanced-model",
          "advancedTaskReasoningEffort": "high",
          "subagentMinimumInitialWaitMinutes": 2
        }
      }
    }
  },
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "cases": "trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation",
        "sanity"
      ]
    },
    {
      "id": "trigger-composition",
      "kind": "trigger",
      "cases": "trigger-composition-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": false
    },
    {
      "id": "routing",
      "kind": "custom-process",
      "cases": "provider-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "provider": {
        "type": "custom-process",
        "command": [
          "node",
          "run-routing-evals.mjs"
        ]
      }
    },
    {
      "id": "lifecycle",
      "kind": "custom-process",
      "cases": "lifecycle-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 900000,
      "requiredForRelease": true,
      "provider": {
        "type": "custom-process",
        "command": [
          "node",
          "run-lifecycle-evals.mjs"
        ]
      }
    },
    {
      "id": "lifecycle-timeout",
      "kind": "custom-process",
      "cases": "lifecycle-timeout-evals.json",
      "profiles": [
        "project-timeout"
      ],
      "runs": 1,
      "timeoutMs": 900000,
      "requiredForRelease": true,
      "provider": {
        "type": "custom-process",
        "command": [
          "node",
          "run-lifecycle-evals.mjs"
        ]
      }
    }
  ]
}
