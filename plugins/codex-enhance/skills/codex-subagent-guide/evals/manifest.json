      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "run-role-boundary-evals.mjs"
        ],
        "allowedModels": [
          "gpt-6-luna",
          "gpt-6.1-sol",
          "gpt-6-astra",
          "gpt-6-sol",
          "gpt-5.6-sol"
        ]
      }
    },
    {
      "id": "worker-instructions",
      "kind": "codex-workflow",
      "cases": "worker-instructions.cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 900000,
      "requiredForRelease": true,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "run-role-boundary-evals.mjs"
        ],
        "allowedModels": [
          "gpt-6-luna",
          "gpt-6.1-sol",
          "gpt-6-astra",
          "gpt-6-sol",
