{
  "version": 1,
  "defaults": {
    "profile": "project-default"
  },
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {}
      }
    },
    "project-dev-build": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {},
        "dev-workflow": {}
      }
    },
    "user-default": {
      "scope": "user",
      "plugins": {
        "codex-enhance": {}
      }
    },
    "project-nondefault": {
      "scope": "project",
      "plugins": {
        "codex-enhance": {
          "simpleTaskProfile": {
            "model": "eval-simple-model",
            "reasoningEffort": "high"
          },
          "generalTaskProfile": {
            "model": "eval-general-model",
            "reasoningEffort": "xhigh"
          },
          "complexTaskProfile": {
            "model": "eval-complex-model",
            "reasoningEffort": "max"
          },
          "advancedTaskProfile": {
            "model": "eval-advanced-model",
            "reasoningEffort": "high"
          }
        }
      }
    },
    "user-nondefault": {
      "scope": "user",
      "plugins": {
        "codex-enhance": {
          "simpleTaskProfile": {
            "model": "eval-simple-model",
            "reasoningEffort": "high"
          },
          "generalTaskProfile": {
            "model": "eval-general-model",
            "reasoningEffort": "xhigh"
          },
          "complexTaskProfile": {
            "model": "eval-complex-model",
            "reasoningEffort": "max"
          },
          "advancedTaskProfile": {
            "model": "eval-advanced-model",
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "cases": "trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation",
        "sanity"
      ]
    },
    {
      "id": "trigger-composition",
      "kind": "trigger",
      "cases": "trigger-composition-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": false
    },
    {
      "id": "trigger-dev-build",
      "kind": "trigger",
      "cases": "trigger-dev-build-cases.json",
      "profiles": [
        "project-dev-build"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": false
    },
    {
      "id": "routing",
      "kind": "codex-workflow",
      "cases": "provider-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "run-routing-evals.mjs"
        ],
        "allowedModels": [
          "gpt-6-luna"
        ]
      }
    },
    {
      "id": "lifecycle",
      "kind": "codex-workflow",
      "cases": "lifecycle-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 900000,
      "requiredForRelease": true,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "run-lifecycle-evals.mjs"
        ],
        "allowedModels": [
          "gpt-6-luna"
        ]
      }
    },
    {
      "id": "lifecycle-timeout",
      "kind": "codex-workflow",
      "cases": "lifecycle-timeout-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 900000,
      "requiredForRelease": true,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "run-lifecycle-evals.mjs"
        ],
        "allowedModels": [
          "gpt-6-luna"
        ]
      }
    }
  ]
}
