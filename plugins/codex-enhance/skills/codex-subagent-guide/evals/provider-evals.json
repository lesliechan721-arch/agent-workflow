    {
      "id": "custom_override_scoped_to_subtask-v1",
      "split": "validation",
      "tags": [
        "boundary"
      ],
      "input": {
        "sourceCaseId": "custom_override_scoped_to_subtask",
        "runtimeProfile": "v1",
        "prompt": "$codex-subagent-guide 委派已获准。整个请求有两个子任务：A 明确使用 model=gpt-5.6-terra 核对格式；B 负责复杂跨模块实现。当前只启动 B，A 的显式 model 不应影响 B；使用干净上下文。",
        "files": []
      },
      "expected": {
        "criteria": {
          "v1": {
            "spawn_calls": {
              "min": 1,
              "max": 1
            },
            "arguments": {
              "agent_type": "codex-subagent-complex",
              "model": null,
              "reasoning_effort": null,
              "fork_context": false,
              "fork_turns": null
            },
            "present_arguments": [
              "message"
            ]
          }
        },
        "outcome": "显式 override 只影响其作用域内的子任务；B 使用复杂任务 role，不携带 A 的 model。"
      },
      "audit": {
        "rationale": "task-scoped 显式字段必须原样保留，未指定字段不得由 preset 补齐；其它子任务的 override 不得泄漏到当前 spawn。",
        "minimalCounterexample": "把 model override 明确改为适用于当前子任务 B 后，应透传 model，并且不再选择 preset role。"
      }
    },
