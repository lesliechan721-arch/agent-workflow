{
  "version": 1,
  "suite": {
    "kind": "custom-process",
    "unitUnderTest": "codex-subagent-guide",
    "defaultGrader": "provider",
    "policy": {
      "optimization": "critical",
      "falseNegativeCost": "critical",
      "falsePositiveCost": "high",
      "rationale": "提前完成、短等待或过早清理会丢失真实结果；正常终态路径被误拒会增加成本，因此 lifecycle 不变量使用关键失败门禁。"
    }
  },
  "cases": [
    {
      "id": "wait_for_terminal_result",
      "split": "validation",
      "tags": [],
      "input": {
        "profiles": [
          "project-default"
        ],
        "prompt": "$codex-subagent-guide 委派已获准。请启动一个 simple 子代理，只读读取 src/simple.ts 并报告 retryLimit 的值。当前没有其它本地工作。你必须等待子代理的真实终态结果后再回答；超时不等于失败。只有当前 schema 提供清理工具时，才在结果已保留后清理。不要修改文件。"
      },
      "expected": {
        "criteria": {
          "minimum_initial_wait_timeout_ms": 600000,
          "spawn_count": 1,
          "require_timeout": false
        }
      }
    }
  ]
}
