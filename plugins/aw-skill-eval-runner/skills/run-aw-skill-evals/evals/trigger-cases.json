{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "run-aw-skill-evals",
    "participants": [
      "write-agent-content",
      "review-agent-content",
      "author-agent-skill",
      "review-agent-skill",
      "design-agent-skill-evals",
      "audit-agent-skill-evals"
    ],
    "defaultGrader": "mechanical",
    "policy": {
      "optimization": "precision-first",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "漏触发会跳过 aw-skill-eval 的授权和完整性检查；误触发会引入不相关的执行流程。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "run_plan",
      "split": "train",
      "tags": [
        "representative"
      ],
      "input": {
        "query": "使用 aw-skill-eval 执行这份 EvalSpec v1，并保存 EvalResult v1。",
        "expectedLoad": true
      }
    },
    {
      "id": "comparative",
      "split": "train",
      "tags": [
        "representative"
      ],
      "input": {
        "query": "用 aw-skill-eval 的 with-skill 和 baseline 配置运行这组 Skill Eval。",
        "expectedLoad": true
      }
    },
    {
      "id": "explicit_invocation",
      "split": "validation",
      "tags": [
        "representative",
        "release-critical"
      ],
      "input": {
        "query": "使用 $run-aw-skill-evals 执行 spec.json。",
        "expectedLoad": true
      },
      "audit": {
        "errorCost": "high"
      }
    },
    {
      "id": "validate_plan",
      "split": "validation",
      "tags": [
        "representative",
        "release-critical"
      ],
      "input": {
        "query": "用 aw-skill-eval 验证这份 EvalSpec v1，但先不运行。",
        "expectedLoad": true
      },
      "audit": {
        "errorCost": "high"
      }
    },
    {
      "id": "unaudited",
      "split": "validation",
      "tags": [
        "boundary",
        "release-critical"
      ],
      "input": {
        "query": "这份 Agent Skill Eval 还没有 Oracle preflight。请用默认 AW 流程处理，但不要绕过 Audit。",
        "expectedLoad": true
      },
      "audit": {
        "rationale": "默认 Runner 是 Agent-facing 编排入口；它必须在执行前取得独立 passing Audit。",
        "minimalCounterexample": "只要求审核 Oracle 且不准备或执行 Eval 时，应由 Audit 能力处理。",
        "errorCost": "high"
      }
    },
    {
      "id": "prepare_selection",
      "split": "validation",
      "tags": [
        "representative",
        "release-critical"
      ],
      "input": {
        "query": "为 agent-skill-toolkit 的 review-agent-skill 准备 behavior suite、project-default profile、validation split，然后通过默认 Runner 审核并执行。",
        "expectedLoad": true
      },
      "audit": {
        "errorCost": "high"
      }
    },
    {
      "id": "other_runner",
      "split": "validation",
      "tags": [
        "boundary",
        "release-critical"
      ],
      "input": {
        "query": "使用 another-eval-engine 执行它自己的 Eval plan。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "本 Skill 只适配 aw-skill-eval。",
        "minimalCounterexample": "改为使用 aw-skill-eval 后标签翻转。",
        "errorCost": "high"
      }
    },
    {
      "id": "design",
      "split": "train",
      "tags": [
        "boundary"
      ],
      "input": {
        "query": "为 Skill 设计一组 Eval cases。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求是设计，不是执行。",
        "minimalCounterexample": "改为执行 aw-skill-eval EvalSpec 后标签翻转。"
      }
    },
    {
      "id": "audit",
      "split": "train",
      "tags": [
        "boundary"
      ],
      "input": {
        "query": "审核 Eval Oracle 是否有效。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求是 Audit，不是执行。",
        "minimalCounterexample": "改为执行 aw-skill-eval EvalSpec 后标签翻转。"
      }
    },
    {
      "id": "review",
      "split": "train",
      "tags": [
        "boundary"
      ],
      "input": {
        "query": "评审 Skill 的设计质量，并决定是否可以发布。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求是 Review，不是执行。",
        "minimalCounterexample": "改为只执行 aw-skill-eval EvalSpec 后标签翻转。"
      }
    },
    {
      "id": "normal_command",
      "split": "validation",
      "tags": [
        "boundary",
        "release-critical"
      ],
      "input": {
        "query": "运行普通单元测试命令，不是 Agent Skill Eval。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求不属于 Agent Skill Eval。",
        "minimalCounterexample": "改为运行 aw-skill-eval 后标签翻转。",
        "errorCost": "high"
      }
    }
  ]
}
