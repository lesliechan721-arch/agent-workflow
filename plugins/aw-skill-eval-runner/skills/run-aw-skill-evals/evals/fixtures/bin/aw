#!/usr/bin/env node

const { appendFileSync } = require('node:fs');
const path = require('node:path');

const args = process.argv.slice(2);
const trace = path.join(process.cwd(), 'fixtures', 'runner-trace.txt');
appendFileSync(trace, `aw ${args.join(' ')}\n`, 'utf8');
process.stderr.write(`Unexpected fixture command: aw ${args.join(' ')}\n`);
process.exit(9);
