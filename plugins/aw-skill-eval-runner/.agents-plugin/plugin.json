{
  "schemaVersion": 2,
  "name": "aw-skill-eval-runner",
  "version": "0.1.0-beta.2",
  "description": "通过共享 aw-skill-eval CLI 执行 Agent Skill Eval plan，并生成中立的运行证据。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "skills": "./skills",
  "interface": {
    "displayName": "AW Skill Eval Runner",
    "shortDescription": "执行 Agent Skill Eval plan，并生成中立的 EvalRunBundle 证据",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {
    "timeoutMs": 30000
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-manifest.v2",
        "aw.plugin-skills.v1"
      ]
    }
  }
}
