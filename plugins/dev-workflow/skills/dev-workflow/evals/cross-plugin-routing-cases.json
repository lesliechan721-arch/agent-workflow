{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "dev-workflow",
    "participants": [
      "dev-spec",
      "dev-review-spec",
      "dev-implement",
      "dev-review-code",
      "decision-shape",
      "decision-grill",
      "decision-prototype"
    ],
    "defaultGrader": "mechanical",
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "错误路由会跳过决策、修复或复审，也会给直接专业任务增加不必要流程。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "route_fast_to_implement",
      "split": "validation",
      "tags": [
        "representative",
        "workflow-routing"
      ],
      "input": {
        "query": "使用 dev-workflow 修复一个明确的低风险 bug：用户名末尾空格未去除。范围只限现有 normalizeName；非目标是不改公开接口。没有未解决材料决定，也不需要 Prototype、实验或测量。有稳定失败测试，改动可逆且一个上下文可完成。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "dev-implement"
          ]
        }
      }
    },
    {
      "id": "route_fast_exceeds_single_context_to_spec",
      "split": "validation",
      "tags": [
        "boundary",
        "fast-readiness"
      ],
      "audit": {
        "rationale": "只有单上下文完成这一项不满足，因此任务不能进入 Fast；Shape 已完整，Standard 的最早未满足 gate 是 Spec。",
        "allowedVariance": "只加载 dev-spec，不得直接进入 dev-implement。",
        "minimalCounterexample": "同一任务若预计一个上下文可完成，则七项 Fast readiness 全部满足，可以进入 dev-implement。"
      },
      "input": {
        "query": "使用 dev-workflow 修复用户名末尾空格未去除的问题。结果、范围和非目标已清楚，没有材料未决，不需要体验或实验，改动低风险、可逆且有稳定失败测试；但仓库很大，预计需要多个上下文才能完成。Shape 已完整，当前没有 Spec。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "dev-spec"
          ]
        }
      }
    },
    {
      "id": "route_fast_verified_to_code_review",
      "split": "validation",
      "tags": [
        "regression",
        "fast-readiness"
      ],
      "audit": {
        "rationale": "Fast 的实现和验证 gate 已满足，最早未满足 gate 是正式 Code Review。",
        "allowedVariance": "只加载 dev-review-code，不得直接宣告 Delivery。",
        "minimalCounterexample": "如果当前 Code Review 已为 clean，则可以进入 Delivery，不需要再次加载 Review。"
      },
      "input": {
        "query": "使用 dev-workflow 继续这个 Fast 任务：实现已经完成，可靠验证已经通过，当前还没有 Code Review。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "dev-review-code"
          ]
        }
      }
    },
    {
      "id": "route_new_feature_intent_is_not_ready",
      "split": "validation",
      "tags": [
        "regression",
        "fast-readiness"
      ],
      "audit": {
        "rationale": "实现意图不能代替范围、材料决定和验收；最早未满足 gate 是 Shape。",
        "allowedVariance": "只加载 decision-shape，不直接加载两个叶子或 dev-implement。",
        "minimalCounterexample": "同一团队权限功能若已明确可观察结果、范围与非目标、材料决定、无需体验证据、低风险可逆边界、可靠验证方式和单上下文规模，则可以进入 dev-implement。"
      },
      "input": {
        "query": "使用 dev-workflow 实现一个新的团队权限功能。当前没有 Shape、Spec 或明确验收。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "decision-shape"
          ]
        }
      }
    },
    {
      "id": "route_material_decisions_to_shape",
      "split": "validation",
      "tags": [
        "representative",
        "workflow-routing"
      ],
      "input": {
        "query": "使用 dev-workflow 组织新的权限模型；多个材料决定相互依赖。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "decision-shape"
          ]
        }
      }
    },
    {
      "id": "route_shape_evidence_branch_stays_in_shape",
      "split": "validation",
      "tags": [
        "representative",
        "workflow-routing"
      ],
      "input": {
        "query": "使用 dev-workflow 继续：Shape 仍有一个审批页信息层级问题，必须操作候选页面后才能决定。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "decision-shape"
          ]
        }
      }
    },
    {
      "id": "route_decisions_to_spec",
      "split": "validation",
      "tags": [
        "representative",
        "workflow-routing"
      ],
      "input": {
        "query": "使用 dev-workflow 继续：Shape 已完整且没有开放材料决定，当前还没有 Spec。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "dev-spec"
          ]
        }
      }
    },
    {
      "id": "route_approved_spec_to_implement",
      "split": "validation",
      "tags": [
        "representative",
        "workflow-routing"
      ],
      "input": {
        "query": "使用 dev-workflow 继续：Spec Review 为 clean，用户已经明确批准，当前尚未实现。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "dev-implement"
          ]
        }
      }
    },
    {
      "id": "route_revised_spec_to_rereview",
      "split": "validation",
      "tags": [
        "representative",
        "review-routing"
      ],
      "input": {
        "query": "使用 dev-workflow 继续：Spec 已根据 blocked Review 修订。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "dev-review-spec"
          ]
        }
      }
    },
    {
      "id": "route_blocked_code_review_to_implement",
      "split": "validation",
      "tags": [
        "representative",
        "review-routing"
      ],
      "input": {
        "query": "使用 dev-workflow 处理 blocked Code Review；Spec 正确，问题是实现缺陷。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "dev-implement"
          ]
        }
      }
    },
    {
      "id": "route_fixed_code_to_rereview",
      "split": "validation",
      "tags": [
        "representative",
        "review-routing"
      ],
      "input": {
        "query": "使用 dev-workflow 继续：Code Review blocker 已修复并验证。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "dev-review-code"
          ]
        }
      }
    },
    {
      "id": "route_code_review_spec_defect_to_spec",
      "split": "validation",
      "tags": [
        "representative",
        "review-routing"
      ],
      "input": {
        "query": "使用 dev-workflow 处理 blocked Code Review；reviewer 发现 Spec 遗漏失败行为。",
        "expected": {
          "loadedSkills": [
            "dev-workflow",
            "dev-spec"
          ]
        }
      }
    },
    {
      "id": "direct_spec_review_bypasses_router",
      "split": "sanity",
      "tags": [
        "boundary",
        "direct-specialist"
      ],
      "audit": {
        "rationale": "直接请求专业能力时不加载宏入口。",
        "allowedVariance": "措辞可以不同，但只能加载当前阶段需要的能力。",
        "minimalCounterexample": "要求同时组织后续修订、实现和复审时，宏入口应加载。"
      },
      "input": {
        "query": "正式审查这份 Spec 是否可以批准。",
        "expected": {
          "loadedSkills": [
            "dev-review-spec"
          ]
        }
      }
    },
    {
      "id": "direct_code_review_bypasses_router",
      "split": "sanity",
      "tags": [
        "boundary",
        "direct-specialist"
      ],
      "audit": {
        "rationale": "直接请求专业能力时不加载宏入口。",
        "allowedVariance": "措辞可以不同，但只能加载当前阶段需要的能力。",
        "minimalCounterexample": "要求审查后继续修复并重新审查时，宏入口应加载。"
      },
      "input": {
        "query": "审查这个 PR 的需求符合度和工程质量。",
        "expected": {
          "loadedSkills": [
            "dev-review-code"
          ]
        }
      }
    }
  ]
}
