{
  "skill_name": "dev-workflow",
  "policy": {
    "optimization": "precision-first",
    "false_negative_cost": "high",
    "false_positive_cost": "high",
    "rationale": "跨阶段编排若遗漏风险升级、越过用户检查点、丢失稳定决定或让专业 Skill 互相接管，会造成错误写入和规格漂移。"
  },
  "evals": [
    {
      "id": "prototype-feedback-to-default-task-root",
      "eval_type": "outcome",
      "case_role": "representative",
      "provenance": "representative-synthetic",
      "scenario_family": "prototype-to-spec-handoff",
      "unit_under_test": "full-skill",
      "preconditions": {
        "workflow_explicitly_requested": true,
        "prototype_feedback_required": true,
        "subsequent_spec_authorized": true,
        "repository_has_no_artifact_convention": true,
        "production_implementation_forbidden": true
      },
      "oracle": {
        "rationale": "Standard 任务需要先取得可操作原型反馈，再把稳定结论投影到默认任务目录中的 Spec；完整原型仍是 Evidence，生产页面保持不变。",
        "rule_refs": [
          "dev-workflow/SKILL.md#2-选择保障等级",
          "dev-workflow/SKILL.md#3-确定任务目录",
          "dev-workflow/SKILL.md#消费决策结果",
          "decision-prototype/SKILL.md#工作流",
          "dev-spec/SKILL.md#工作流"
        ],
        "confidence": "high",
        "allowed_variance": "原型结构和 Spec 措辞可以不同；必须使用 docs/dev/approval-layout/，先等待反馈，只把稳定结论写入规范性章节，并保持生产文件不变。"
      },
      "prompt": "使用 dev-workflow 处理名为 approval-layout 的任务。仓库没有开发文档目录约定，我也不指定路径。先做一个可点击原型让我比较单栏和双栏；我反馈后，把稳定结论整理成轻量 Spec。不要修改 src/approval-page.ts，也不要进入生产实现。",
      "scripted_replies": [
        {
          "expected_question_count": 1,
          "answers_by_index": [
            "选择双栏，右侧保留审批历史；移动端折叠。请把稳定决定写入 Spec 后停止，不要实现生产页面。"
          ],
          "unexpected_question_answer": "只需要我选择单栏或双栏；其它事项保留为未解决。"
        }
      ],
      "expected_output": "选择 Standard 保障，使用默认任务目录，先创建可操作原型并等待反馈，再把双栏决定投影到 spec.md；生产页面保持不变。",
      "sandbox": "workspace-write",
      "workspace_files": {
        "src/approval-page.ts": "export const approvalLayout = 'existing-production-layout';\n"
      },
      "review": {
        "platforms": [
          "codex"
        ],
        "clean_session": true,
        "workspace_unchanged": false,
        "allowed_workspace_changes": [
          "docs/dev/approval-layout/**"
        ],
        "artifacts": [
          {
            "path": "docs/dev/approval-layout/prototypes/layout-choice/index.html",
            "exists": true,
            "contains": [
              "单栏",
              "双栏"
            ]
          },
          {
            "path": "docs/dev/approval-layout/prototypes/layout-choice/brief.md",
            "exists": true,
            "contains": [
              "双栏",
              "审批历史",
              "移动端"
            ]
          },
          {
            "path": "docs/dev/approval-layout/spec.md",
            "exists": true,
            "contains": [
              "双栏",
              "审批历史",
              "移动端",
              "Agent discretion",
              "Evidence"
            ]
          }
        ],
        "checks": [
          "trace 先使用 decision-prototype，用户反馈后才进入 dev-spec",
          "任务目录固定为 docs/dev/approval-layout/，没有另建 prototypes/ 或 docs/specs/ 平行目录",
          "Spec 只投影用户确认的稳定决定，并链接完整原型作为 Evidence",
          "不加载 dev-implement，不修改 src/approval-page.ts，也不把原型升级为生产实现"
        ]
      }
    },
    {
      "id": "assured-migration-stops-at-approval",
      "eval_type": "outcome",
      "case_role": "representative",
      "provenance": "representative-synthetic",
      "scenario_family": "assured-approval-gate",
      "unit_under_test": "full-skill",
      "preconditions": {
        "workflow_explicitly_requested": true,
        "persistent_data_migration": true,
        "material_decisions_confirmed": true,
        "spec_and_review_authorized": true,
        "implementation_not_authorized": true
      },
      "oracle": {
        "rationale": "持久数据迁移应升级为 Assured，生成包含回滚和验证的 Spec 与审查记录，并在明确批准前停止。",
        "rule_refs": [
          "dev-workflow/SKILL.md#assured",
          "dev-workflow/SKILL.md#spec-阶段",
          "dev-spec/SKILL.md#工作流",
          "dev-review-spec/SKILL.md#工作流"
        ],
        "confidence": "high",
        "allowed_variance": "Spec 和 Review 措辞可不同；必须标为 Assured，保存到默认任务目录，请求批准并保持生产文件不变。"
      },
      "prompt": "使用 dev-workflow 处理名为 token-key-rotation 的生产数据迁移。已确认决定在 docs/token-key-rotation-decisions.md。仓库没有开发文档目录约定；请在默认任务目录生成 Spec 和审查记录。审查 clean 后向我请求批准，但不要在批准前修改 src/token-store.js。",
      "scripted_replies": [
        {
          "expected_question_count": 1,
          "answers_by_index": [
            "我暂不批准，请停在这里。"
          ],
          "unexpected_question_answer": "不要实施，先停在批准检查点。"
        }
      ],
      "expected_output": "选择 Assured，创建包含迁移、回滚、验证和授权边界的 Spec 及 clean Review，然后停在 Spec 批准检查点。",
      "sandbox": "workspace-write",
      "workspace_files": {
        "docs/token-key-rotation-decisions.md": "# 已确认决定\n\n- 新旧密钥双读 14 天。\n- 写入只使用新密钥。\n- 按租户分批迁移，每批可回滚。\n- 验证覆盖解密成功率、错误率和回滚演练。\n- 生产执行需要单独授权。\n",
        "src/token-store.js": "export const keyVersion = 'old';\n"
      },
      "review": {
        "platforms": [
          "codex"
        ],
        "clean_session": true,
        "workspace_unchanged": false,
        "allowed_workspace_changes": [
          "docs/dev/token-key-rotation/**"
        ],
        "artifacts": [
          {
            "path": "docs/dev/token-key-rotation/spec.md",
            "exists": true,
            "contains": [
              "14 天",
              "分批",
              "回滚",
              "验证",
              "授权"
            ]
          },
          {
            "path": "docs/dev/token-key-rotation/spec-review.md",
            "exists": true,
            "contains": [
              "clean"
            ]
          }
        ],
        "checks": [
          "明确选择 Assured，而不是把迁移当作 Fast 或仅列能力",
          "Spec 包含双读窗口、分批迁移、回滚、验证和生产授权边界",
          "完成 dev-review-spec 后请求明确批准，并在用户暂不批准时停止",
          "不加载 dev-implement，不修改 src/token-store.js"
        ]
      }
    }
  ]
}
