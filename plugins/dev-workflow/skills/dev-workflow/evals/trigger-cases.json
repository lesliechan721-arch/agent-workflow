{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "dev-workflow",
    "participants": [
      "dev-repair",
      "dev-spec",
      "dev-review-spec",
      "dev-implement",
      "dev-review-code",
      "dev-build",
      "dev-breakdown"
    ],
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "漏触发会跳过风险分级和阶段恢复，误触发会给明确小任务增加流程成本。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "positive_end_to_end",
      "split": "validation",
      "tags": [
        "representative",
        "core-positive"
      ],
      "input": {
        "query": "使用 $dev-workflow 帮我把团队邀请过期功能从需求决策推进到实现审查。",
        "expectedLoad": true
      }
    },
    {
      "id": "positive_resume_spec",
      "split": "validation",
      "tags": [
        "representative",
        "stage-resume"
      ],
      "input": {
        "query": "$dev-workflow 按结构化开发工作流继续这个已有 Spec，先核对有效成果、实际风险和下一阶段。",
        "expectedLoad": true
      }
    },
    {
      "id": "positive_assured_migration",
      "split": "validation",
      "tags": [
        "representative",
        "risk-escalation"
      ],
      "input": {
        "query": "使用 $dev-workflow 组织这次生产数据库迁移，包含回滚、批准和最终审查。",
        "expectedLoad": true
      }
    },
    {
      "id": "negative_natural_language_workflow",
      "split": "validation",
      "tags": [
        "boundary",
        "manual-invocation"
      ],
      "audit": {
        "rationale": "普通文字请求不会调用手动入口。",
        "allowedVariance": "可以使用当前任务适用的其它能力，但不加载 dev-workflow。",
        "minimalCounterexample": "用户通过客户端显式调用 $dev-workflow。"
      },
      "input": {
        "query": "按结构化开发工作流继续这个已有 Spec，先核对有效成果、实际风险和下一阶段。",
        "expectedLoad": false
      }
    },
    {
      "id": "negative_direct_small_change",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-negative"
      ],
      "audit": {
        "rationale": "普通明确小改动应直接进入实现能力。",
        "allowedVariance": "可以加载相邻 Skill，但不应加载本 Skill。",
        "minimalCounterexample": "用户显式调用 $dev-workflow 后标签翻转。"
      },
      "input": {
        "query": "把设置页标题改成“团队设置”，直接修改并验证。",
        "expectedLoad": false
      }
    },
    {
      "id": "negative_direct_grill",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-negative"
      ],
      "audit": {
        "rationale": "用户直接请求一个专业决策能力，没有要求宏工作流。",
        "allowedVariance": "可以加载相邻 Skill，但不应加载本 Skill。",
        "minimalCounterexample": "用户显式调用 $dev-workflow 组织后续 Spec、实现和审查后标签翻转。"
      },
      "input": {
        "query": "逐轮提问我，把新的权限模型想透。",
        "expectedLoad": false
      }
    },
    {
      "id": "negative_direct_code_review",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-negative"
      ],
      "audit": {
        "rationale": "用户直接请求代码审查，没有要求跨阶段编排。",
        "allowedVariance": "可以加载相邻 Skill，但不应加载本 Skill。",
        "minimalCounterexample": "用户显式调用 $dev-workflow 组织修复和复审时标签翻转。"
      },
      "input": {
        "query": "审核这个 PR 的代码质量和需求符合度。",
        "expectedLoad": false
      }
    }
  ]
}
