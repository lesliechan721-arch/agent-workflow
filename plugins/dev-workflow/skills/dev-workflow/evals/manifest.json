{
  "version": 1,
  "defaults": {},
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "dev-workflow": {}
      }
    },
    "project-composed": {
      "scope": "project",
      "plugins": {
        "dev-workflow": {},
        "ask-me": {}
      }
    }
  },
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "cases": "trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "router-composed",
      "kind": "trigger",
      "cases": "cross-plugin-routing-cases.json",
      "profiles": [
        "project-composed"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation",
        "sanity"
      ]
    },
    {
      "id": "composition-composed",
      "kind": "conversation",
      "cases": "composition-behavior-cases.json",
      "profiles": [
        "project-composed"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": true
    },
    {
      "id": "decision-experience-composed",
      "kind": "conversation",
      "cases": "decision-experience-composition-cases.json",
      "profiles": [
        "project-composed"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "fast-build-routing",
      "kind": "trigger",
      "cases": "fast-build-routing-cases.json",
      "profiles": [
        "project-composed"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": false,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "fast-build-behavior",
      "kind": "conversation",
      "cases": "fast-build-behavior-cases.json",
      "profiles": [
        "project-composed"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": false
    },
    {
      "id": "independent-delivery-trigger",
      "kind": "trigger",
      "cases": "independent-delivery-trigger-cases.json",
      "profiles": [
        "project-composed"
      ],
      "runs": 1,
      "timeoutMs": 180000,
      "requiredForRelease": false
    },
    {
      "id": "independent-delivery-behavior",
      "kind": "conversation",
      "cases": "independent-delivery-behavior-cases.json",
      "profiles": [
        "project-composed"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": false
    },
    {
      "id": "continuous-alignment",
      "kind": "codex-workflow",
      "cases": "continuous-alignment-cases.json",
      "profiles": [
        "project-composed"
      ],
      "runs": 1,
      "timeoutMs": 600000,
      "requiredForRelease": false,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "runtime/workflow-evaluation.mjs"
        ],
        "allowedModels": []
      }
    },
    {
      "id": "spec-adaptive-revision",
      "kind": "conversation",
      "cases": "spec-adaptive-revision-cases.json",
      "profiles": [
        "project-composed"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": false
    },
    {
      "id": "continuous-alignment-workflow",
      "kind": "codex-workflow",
      "cases": "continuous-alignment-workflow.cases.json",
      "profiles": [
        "project-composed"
      ],
      "runs": 1,
      "timeoutMs": 600000,
      "requiredForRelease": false,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "runtime/workflow-evaluation.mjs"
        ],
        "allowedModels": []
      }
    }
  ]
}
