{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "dev-spec",
    "participants": [
      "dev-workflow",
      "dev-review-spec",
      "dev-implement",
      "dev-review-code",
      "explain-for-review",
      "decision-grill",
      "dev-design"
    ],
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "漏触发会跳过有价值的专业能力，误触发会增加流程和上下文成本。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "positive_1",
      "split": "validation",
      "tags": [
        "representative",
        "core-positive"
      ],
      "input": {
        "query": "把刚才确认的邀请过期行为整理成可交接的 Spec。",
        "expectedLoad": true
      }
    },
    {
      "id": "positive_2",
      "split": "validation",
      "tags": [
        "representative",
        "core-positive"
      ],
      "input": {
        "query": "根据已经接受的原型和已确认需求写一份轻量开发规格，别写成任务清单。",
        "expectedLoad": true
      }
    },
    {
      "id": "positive_3",
      "split": "validation",
      "tags": [
        "representative",
        "core-positive"
      ],
      "input": {
        "query": "把已经确定的 API、兼容性和验收条件记录成跨会话文档。",
        "expectedLoad": true
      }
    },
    {
      "id": "negative_1",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-negative"
      ],
      "audit": {
        "rationale": "请求属于相邻但不同的用户意图。",
        "allowedVariance": "可以加载相邻 Skill，但不应加载本 Skill。",
        "minimalCounterexample": "将交付改为本 Skill 的主要职责后标签翻转。"
      },
      "input": {
        "query": "围绕数据迁移方案逐轮提问我，先别写文档。",
        "expectedLoad": false
      }
    },
    {
      "id": "negative_2",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-negative"
      ],
      "audit": {
        "rationale": "请求属于相邻但不同的用户意图。",
        "allowedVariance": "可以加载相邻 Skill，但不应加载本 Skill。",
        "minimalCounterexample": "将交付改为本 Skill 的主要职责后标签翻转。"
      },
      "input": {
        "query": "按这个已确认且没有规范缺口的 Spec 实现一个函数，只实现并验证，不修订规格。",
        "expectedLoad": false
      }
    },
    {
      "id": "negative_3",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-negative"
      ],
      "audit": {
        "rationale": "请求属于相邻但不同的用户意图。",
        "allowedVariance": "可以加载相邻 Skill，但不应加载本 Skill。",
        "minimalCounterexample": "将交付改为本 Skill 的主要职责后标签翻转。"
      },
      "input": {
        "query": "审查这份 Spec 是否规定过度。",
        "expectedLoad": false
      }
    }
  ]
}
