{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "dev-review-spec",
    "participants": [
      "dev-workflow",
      "dev-spec",
      "dev-implement",
      "dev-review-code"
    ],
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "漏触发会跳过有价值的专业能力，误触发会增加流程和上下文成本。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "positive_1",
      "split": "validation",
      "tags": [
        "representative",
        "core-positive"
      ],
      "input": {
        "query": "只读审查这份 Spec 是否可以批准，并检查有没有写成自然语言状态机。",
        "expectedLoad": true
      }
    },
    {
      "id": "positive_2",
      "split": "validation",
      "tags": [
        "representative",
        "core-positive"
      ],
      "input": {
        "query": "判断这个设计草案是否还缺材料决定、能否实现和验证。",
        "expectedLoad": true
      }
    },
    {
      "id": "positive_3",
      "split": "validation",
      "tags": [
        "representative",
        "core-positive"
      ],
      "input": {
        "query": "对当前开发规格给出 clean 或 blocked，不要直接修改。",
        "expectedLoad": true
      }
    },
    {
      "id": "negative_1",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-negative"
      ],
      "audit": {
        "rationale": "请求属于相邻但不同的用户意图。",
        "allowedVariance": "可以加载相邻 Skill，但不应加载本 Skill。",
        "minimalCounterexample": "将交付改为本 Skill 的主要职责后标签翻转。"
      },
      "input": {
        "query": "把这份草案改写成正式 Spec。",
        "expectedLoad": false
      }
    },
    {
      "id": "negative_2",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-negative"
      ],
      "audit": {
        "rationale": "请求属于相邻但不同的用户意图。",
        "allowedVariance": "可以加载相邻 Skill，但不应加载本 Skill。",
        "minimalCounterexample": "将交付改为本 Skill 的主要职责后标签翻转。"
      },
      "input": {
        "query": "审核这个 PR 的代码正确性和安全性。",
        "expectedLoad": false
      }
    },
    {
      "id": "negative_3",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-negative"
      ],
      "audit": {
        "rationale": "请求属于相邻但不同的用户意图。",
        "allowedVariance": "可以加载相邻 Skill，但不应加载本 Skill。",
        "minimalCounterexample": "将交付改为本 Skill 的主要职责后标签翻转。"
      },
      "input": {
        "query": "按这个 Spec 开始实现功能。",
        "expectedLoad": false
      }
    }
  ]
}
