{
  "schemaVersion": 4,
  "name": "dev-workflow",
  "version": "0.1.0",
  "description": "统一开发工作流与工程验证插件：整合开发路线、调查调试、架构竞争、条件 TDD、统一分层审查、真实表面与性能验证及仓库防呆硬化，支持零必填可选跨模型面板动态渲染。",
  "platforms": [
    "codex",
    "claude",
    "antigravity",
    "cursor",
    "opencode",
    "pi",
    "copilot",
    "grok",
    "generic"
  ],
  "marketplace": {
    "category": "workflow",
    "tags": [
      "development",
      "workflow",
      "design",
      "debugging",
      "review",
      "verification",
      "benchmark"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "interface": {
    "displayName": "Dev Workflow",
    "shortDescription": "统一开发工作流、核心工程能力、真实验证与可选多模型面板路由。",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/dev-workflow-artifacts.test.mjs"
      ]
    }
  },
  "config": {
    "schemaVersion": 5,
    "definitions": {
      "agentExecutor": {
        "type": "string",
        "title": "执行器",
        "description": "native 或 agent-subagent 已注册的 subagentCommands key；省略时按 native 解释。",
        "valueRef": {
          "plugin": "agent-subagent",
          "field": "subagentCommands",
          "key": "key",
          "include": [
            "native"
          ]
        },
        "clearsOnChange": [
          "model",
          "reasoningEffort"
        ],
        "validation": {
          "minLength": 1
        }
      },
      "agentModel": {
        "type": "string",
        "title": "模型",
        "description": "留空沿用宿主/后端默认。",
        "suggestions": {
          "plugin": "agent-subagent",
          "provider": "executor-models",
          "dependsOn": [
            "executor"
          ]
        },
        "validation": {
          "minLength": 1
        }
      },
      "agentReasoningEffort": {
        "type": "string",
        "title": "推理强度",
        "description": "推理强度偏好；留空沿用宿主/后端默认，实际支持范围由所选执行器与模型决定。",
        "choices": {
          "allowCustom": true,
          "presets": [
            {
              "id": "low",
              "title": "low",
              "value": "low"
            },
            {
              "id": "medium",
              "title": "medium",
              "value": "medium"
            },
            {
              "id": "high",
              "title": "high",
              "value": "high"
            },
            {
              "id": "xhigh",
              "title": "xhigh",
              "value": "xhigh"
            },
            {
              "id": "max",
              "title": "max",
              "value": "max"
            }
          ]
        },
        "suggestions": {
          "plugin": "agent-subagent",
          "provider": "executor-efforts",
          "dependsOn": [
            "executor",
            "model"
          ]
        },
        "validation": {
          "minLength": 1
        }
      },
      "agentProfile": {
        "type": "object",
        "properties": {
          "executor": {
            "$ref": "#/config/definitions/agentExecutor"
          },
          "model": {
            "$ref": "#/config/definitions/agentModel"
          },
          "reasoningEffort": {
            "$ref": "#/config/definitions/agentReasoningEffort"
          }
        },
        "additionalProperties": false,
        "suggestions": {
          "plugin": "agent-subagent",
          "provider": "executor-model-profile",
          "title": "选择推荐模型组合",
          "description": "按当前执行器实时目录原子选择模型与推理强度。",
          "dependsOn": [
            "executor"
          ],
          "targets": [
            "model",
            "reasoningEffort"
          ]
        }
      }
    },
    "fields": {
      "arenaRunners": {
        "type": "array",
        "platformOnly": true,
        "title": "Arena 多候选面板",
        "description": "可选。dev-arena 并行候选使用的执行器与模型座次；留空且任务允许外发时优先组合异构执行器或宿主多家族模型，无可用异构能力时回退隔离运行并披露。",
        "items": {
          "type": "object",
          "properties": {
            "executor": {
              "$ref": "#/config/definitions/agentExecutor"
            },
            "model": {
              "$ref": "#/config/definitions/agentModel"
            },
            "reasoningEffort": {
              "$ref": "#/config/definitions/agentReasoningEffort"
            }
          },
          "additionalProperties": false,
          "suggestions": {
            "plugin": "agent-subagent",
            "provider": "executor-model-profile",
            "hint": "strong",
            "title": "选择推荐候选模型组合",
            "description": "优先推荐强推理与架构设计能力更强的主力组合。",
            "dependsOn": [
              "executor"
            ],
            "targets": [
              "model",
              "reasoningEffort"
            ]
          }
        },
        "validation": {
          "maxItems": 8
        }
      },
      "arenaCrossJudge": {
        "$ref": "#/config/definitions/agentProfile",
        "platformOnly": true,
        "title": "Arena 独立裁判配置",
        "description": "可选。dev-arena Phase C 独立裁判使用的模型配置；省略时仍默认启动 1 名干净独立裁判（允许外发时优先异构，无则回退高档原生并披露）。",
        "suggestions": {
          "plugin": "agent-subagent",
          "provider": "executor-model-profile",
          "hint": "deep",
          "title": "选择推荐独立裁判组合",
          "description": "优先推荐最高深度推理与审辩能力组合（可切换外部执行器固定异构裁判）。",
          "dependsOn": [
            "executor"
          ],
          "targets": [
            "model",
            "reasoningEffort"
          ]
        }
      },
      "reviewAdversaries": {
        "type": "array",
        "platformOnly": true,
        "title": "Review 对抗实测面板",
        "description": "可选。dev-review 对抗实测模式使用的多对抗者座次；留空且任务允许外发时优先组合异构执行器或宿主多家族模型，无可用异构能力时回退 2 名同源隔离对抗者并披露。",
        "items": {
          "type": "object",
          "properties": {
            "executor": {
              "$ref": "#/config/definitions/agentExecutor"
            },
            "model": {
              "$ref": "#/config/definitions/agentModel"
            },
            "reasoningEffort": {
              "$ref": "#/config/definitions/agentReasoningEffort"
            }
          },
          "additionalProperties": false,
          "suggestions": {
            "plugin": "agent-subagent",
            "provider": "executor-model-profile",
            "hint": "strong",
            "title": "选择推荐对抗审查组合",
            "description": "优先推荐缺陷排查与反例构造能力更强的主力组合。",
            "dependsOn": [
              "executor"
            ],
            "targets": [
              "model",
              "reasoningEffort"
            ]
          }
        },
        "validation": {
          "maxItems": 8
        }
      }
    },
    "presentation": {
      "groups": [
        {
          "id": "panels",
          "title": "多视角与对抗面板",
          "fields": [
            "arenaRunners",
            "arenaCrossJudge",
            "reviewAdversaries"
          ]
        }
      ],
      "summaries": {
        "modelAndEffort": {
          "kind": "join",
          "parts": [
            {
              "path": "/executor"
            },
            {
              "path": "/model"
            },
            {
              "path": "/reasoningEffort"
            }
          ],
          "separator": "/",
          "missing": "自动路由"
        }
      },
      "fieldViews": {
        "arenaRunners": {
          "itemSummary": "modelAndEffort"
        },
        "arenaCrossJudge": {
          "summary": "modelAndEffort"
        },
        "reviewAdversaries": {
          "itemSummary": "modelAndEffort"
        }
      }
    }
  },
  "artifacts": {
    "configKeys": [
      "arenaRunners",
      "arenaCrossJudge",
      "reviewAdversaries"
    ],
    "sourceDirs": [
      "./shared",
      "./skills/dev-workflow",
      "./skills/dev-design",
      "./skills/dev-investigate",
      "./skills/dev-debug",
      "./skills/dev-architect",
      "./skills/dev-arena",
      "./skills/dev-tdd",
      "./skills/dev-review",
      "./skills/dev-correct",
      "./skills/dev-verify",
      "./skills/dev-benchmark",
      "./skills/dev-verify-author"
    ]
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-config.v5",
        "aw.plugin-config-array.v1",
        "aw.plugin-config-value-ref.v1",
        "aw.plugin-config-cross-plugin-value-ref.v1",
        "aw.plugin-config-summary.v1",
        "aw.plugin-config-suggestions.v2",
        "aw.plugin-config-platform-only.v1",
        "aw.plugin-config-clears-on-change.v1",
        "aw.plugin-config-ref-override.v1"
      ]
    }
  },
  "dependencies": [
    "decision-kit",
    "human-content",
    "agent-subagent"
  ]
}
