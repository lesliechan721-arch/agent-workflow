{
  "schemaVersion": 3,
  "name": "dev-workflow",
  "version": "0.1.0-beta.14",
  "description": "从需求设计到实现交付的可组合工作流，项目规范与本地过程资料分工清楚。",
  "marketplace": {
    "category": "workflow",
    "tags": [
      "development",
      "spec",
      "implementation",
      "review"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "dependencies": [
    "decision-kit",
    "human-content"
  ],
  "skills": "./skills",
  "interface": {
    "displayName": "Dev Workflow",
    "shortDescription": "先设计或完整交付；本地恢复、独立审查和有界修复",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {},
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-build-config.v1",
        "aw.plugin-manifest.v3",
        "aw.plugin-skills.v1"
      ]
    }
  }
}
