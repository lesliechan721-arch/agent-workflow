{
  "schemaVersion": 2,
  "name": "dev-workflow",
  "version": "0.1.0-beta.3",
  "description": "按保障等级和生命周期 gate 组织开发任务，并提供可独立使用的规格、实现与审查闭环。",
  "marketplace": {
    "category": "workflow",
    "tags": [
      "development",
      "spec",
      "implementation",
      "review"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "dependencies": [
    "ask-me"
  ],
  "skills": "./skills",
  "interface": {
    "displayName": "Dev Workflow",
    "shortDescription": "从最早未满足的生命周期 gate 继续开发任务",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {
    "timeoutMs": 30000
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-manifest.v2",
        "aw.plugin-skills.v1"
      ]
    }
  }
}
