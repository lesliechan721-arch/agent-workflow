{
  "schemaVersion": 4,
  "name": "agent-explore",
  "version": "0.1.0",
  "description": "面向任意工作的大范围只读事实调查：在首轮与任务中途自发将高噪声查证卸载给隔离探索子代理，交付带出处、分证据层级与覆盖边界的事实底稿。",
  "platforms": [
    "codex",
    "claude",
    "antigravity",
    "cursor",
    "opencode",
    "pi",
    "copilot",
    "grok",
    "generic"
  ],
  "marketplace": {
    "category": "workflow",
    "tags": [
      "explore",
      "research",
      "fact-finding",
      "subagent",
      "readonly",
      "context-isolation"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "interface": {
    "displayName": "Agent Explore",
    "shortDescription": "跨平台、全领域的大范围只读事实调查与上下文隔离卸载",
    "capabilities": [
      "Skills",
      "Instructions"
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/explore-artifacts.test.mjs"
      ]
    }
  },
  "config": {
    "schemaVersion": 5,
    "definitions": {
      "agentExecutor": {
        "type": "string",
        "title": "执行器",
        "description": "native 或 agent-subagent 已注册的 subagentCommands key；省略时按 native 解释。",
        "valueRef": {
          "plugin": "agent-subagent",
          "field": "subagentCommands",
          "key": "key",
          "include": [
            "native"
          ]
        },
        "clearsOnChange": [
          "model",
          "reasoningEffort"
        ],
        "validation": {
          "minLength": 1
        }
      },
      "agentModel": {
        "type": "string",
        "title": "模型",
        "description": "留空沿用宿主/后端默认。",
        "suggestions": {
          "plugin": "agent-subagent",
          "provider": "executor-models",
          "dependsOn": [
            "executor"
          ]
        },
        "validation": {
          "minLength": 1
        }
      },
      "agentReasoningEffort": {
        "type": "string",
        "title": "推理强度",
        "description": "推理强度偏好；留空沿用宿主/后端默认，实际支持范围由所选执行器与模型决定。",
        "choices": {
          "allowCustom": true,
          "presets": [
            {
              "id": "low",
              "title": "low",
              "value": "low"
            },
            {
              "id": "medium",
              "title": "medium",
              "value": "medium"
            },
            {
              "id": "high",
              "title": "high",
              "value": "high"
            },
            {
              "id": "xhigh",
              "title": "xhigh",
              "value": "xhigh"
            },
            {
              "id": "max",
              "title": "max",
              "value": "max"
            }
          ]
        },
        "suggestions": {
          "plugin": "agent-subagent",
          "provider": "executor-efforts",
          "dependsOn": [
            "executor",
            "model"
          ]
        },
        "validation": {
          "minLength": 1
        }
      },
      "agentProfile": {
        "type": "object",
        "properties": {
          "executor": {
            "$ref": "#/config/definitions/agentExecutor"
          },
          "model": {
            "$ref": "#/config/definitions/agentModel"
          },
          "reasoningEffort": {
            "$ref": "#/config/definitions/agentReasoningEffort"
          }
        },
        "additionalProperties": false,
        "suggestions": {
          "plugin": "agent-subagent",
          "provider": "executor-model-profile",
          "title": "选择推荐模型组合",
          "description": "按当前执行器实时目录原子选择模型与推理强度。",
          "dependsOn": [
            "executor"
          ],
          "targets": [
            "model",
            "reasoningEffort"
          ]
        }
      }
    },
    "fields": {
      "exploreProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "platformOnly": true,
        "title": "常规探索配置",
        "description": "可选。用于大范围常规/快速事实调查；省略时按复杂度沿用 agent-subagent 的 simple 或 general 档位。",
        "suggestions": {
          "plugin": "agent-subagent",
          "provider": "executor-model-profile",
          "hint": "fast",
          "title": "选择推荐探索模型组合",
          "description": "优先推荐低成本、低延迟的探索模型组合。",
          "dependsOn": [
            "executor"
          ],
          "targets": [
            "model",
            "reasoningEffort"
          ]
        }
      },
      "deepExploreProfile": {
        "$ref": "#/config/definitions/agentProfile",
        "platformOnly": true,
        "title": "深度探索配置",
        "description": "可选。用于高歧义、多源强冲突或复杂因果的深度事实调查；省略时沿用 agent-subagent 的 complex 档位。",
        "suggestions": {
          "plugin": "agent-subagent",
          "provider": "executor-model-profile",
          "hint": "strong",
          "title": "选择推荐深查模型组合",
          "description": "优先推荐长链交叉核验能力更强的模型组合。",
          "dependsOn": [
            "executor"
          ],
          "targets": [
            "model",
            "reasoningEffort"
          ]
        }
      },
      "exploreCustomProfiles": {
        "type": "array",
        "platformOnly": true,
        "title": "探索自定义路由",
        "description": "可选。按数组顺序采用首个适用范围匹配项（如“长文档/PDF/网页核验”“外部仓库扫描”）；未匹配时再按常规/深度探索规则执行。",
        "items": {
          "type": "object",
          "properties": {
            "applicability": {
              "type": "string",
              "title": "适用范围",
              "required": true,
              "validation": {
                "minLength": 1
              }
            },
            "executor": {
              "$ref": "#/config/definitions/agentExecutor"
            },
            "model": {
              "$ref": "#/config/definitions/agentModel"
            },
            "reasoningEffort": {
              "$ref": "#/config/definitions/agentReasoningEffort"
            }
          },
          "additionalProperties": false,
          "suggestions": {
            "plugin": "agent-subagent",
            "provider": "executor-model-profile",
            "hint": "balanced",
            "title": "选择推荐模型组合",
            "dependsOn": [
              "executor"
            ],
            "targets": [
              "model",
              "reasoningEffort"
            ]
          }
        }
      }
    },
    "presentation": {
      "groups": [
        {
          "id": "explore-facts",
          "title": "explore-facts",
          "fields": [
            "exploreProfile",
            "deepExploreProfile",
            "exploreCustomProfiles"
          ]
        }
      ],
      "summaries": {
        "modelAndEffort": {
          "kind": "join",
          "parts": [
            {
              "path": "/executor"
            },
            {
              "path": "/model"
            },
            {
              "path": "/reasoningEffort"
            }
          ],
          "separator": "/",
          "missing": "继承默认"
        }
      },
      "fieldViews": {
        "exploreProfile": {
          "summary": "modelAndEffort"
        },
        "deepExploreProfile": {
          "summary": "modelAndEffort"
        }
      }
    }
  },
  "artifacts": {
    "configKeys": [
      "exploreProfile",
      "deepExploreProfile",
      "exploreCustomProfiles"
    ],
    "sourceDirs": [
      "./shared",
      "./skills/explore-facts"
    ]
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-config.v5",
        "aw.plugin-config-array.v1",
        "aw.plugin-config-value-ref.v1",
        "aw.plugin-config-cross-plugin-value-ref.v1",
        "aw.plugin-config-summary.v1",
        "aw.plugin-config-suggestions.v2",
        "aw.plugin-config-platform-only.v1",
        "aw.plugin-config-clears-on-change.v1",
        "aw.plugin-config-ref-override.v1"
      ]
    }
  },
  "dependencies": [
    "agent-subagent"
  ]
}
