{
  "version": 1,
  "defaults": {},
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "decision-kit": {}
      }
    },
    "user-default": {
      "scope": "user",
      "plugins": {
        "decision-kit": {}
      }
    }
  },
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "cases": "trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000
    },
    {
      "id": "router",
      "kind": "trigger",
      "cases": "decision-kit-prototype-routing-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 10,
      "timeoutMs": 180000
    },
    {
      "id": "behavior",
      "kind": "conversation",
      "cases": "decision-prototype-release-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000
    },
    {
      "id": "builder-workflow",
      "kind": "codex-workflow",
      "cases": "prototype-builder-workflow-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 600000,
      "provider": {
        "type": "codex-workflow",
        "command": [
          "node",
          "prototype-builder-workflow.mjs"
        ],
        "allowedModels": []
      }
    },
    {
      "id": "feedback",
      "kind": "conversation",
      "cases": "prototype-feedback-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000
    },
    {
      "id": "review-lifecycle",
      "kind": "conversation",
      "cases": "prototype-review-lifecycle-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000
    },
    {
      "id": "prototype-method",
      "kind": "conversation",
      "cases": "prototype-method-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000
    },
    {
      "id": "opening-policy",
      "kind": "conversation",
      "cases": "prototype-opening-policy-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000
    },
    {
      "id": "independent-delivery-trigger",
      "kind": "trigger",
      "cases": "independent-delivery-trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 180000
    },
    {
      "id": "independent-delivery-behavior",
      "kind": "conversation",
      "cases": "independent-delivery-behavior-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000
    },
    {
      "id": "context-role-behavior",
      "kind": "conversation",
      "cases": "context-role-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000
    }
  ]
}
