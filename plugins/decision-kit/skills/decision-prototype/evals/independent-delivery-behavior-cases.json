{
  "version": 1,
  "suite": {
    "kind": "conversation",
    "unitUnderTest": "decision-prototype",
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "以公开行为、已接受设计、独立证据和真实权限为依据；区分实际缺陷与等价实现。"
    },
    "runtime": {
      "isolation": "strict"
    }
  },
  "cases": [
    {
      "id": "prototype-inherits-topic-root",
      "split": "validation",
      "tags": [
        "boundary"
      ],
      "prompt": "原型已完成，不启动网页服务。请根据已确认记录在 topics/audio/prototypes/level/verdict.md 形成结论：当前r2桌面右侧预览和窄屏先预览的关系被接受；允许替换CSS，模拟保存不属于生产能力。",
      "assertions": [
        "只写给定verdict，不另建prototypes默认根。",
        "接受具体关系而非所有像素，mock保存不升级为生产承诺。"
      ],
      "input": {
        "scriptedReplies": [],
        "workspaceFiles": {
          "topics/audio/prototypes/level/artifact/index.html": "<!doctype html><html lang=\"zh-CN\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>通知偏好预览</title><style>body{font-family:system-ui;margin:24px;color:#172132}main{max-width:980px;margin:auto}.layout{display:grid;grid-template-columns:1fr 1fr;gap:24px}.card{padding:16px;border:1px solid #cbd3df;border-radius:10px}button{margin-top:16px;padding:12px}label{display:block;margin:12px 0}@media(max-width:700px){.layout{display:flex;flex-direction:column}.preview{order:0}.controls{order:1}}</style><main><h1>通知偏好</h1><div class=\"layout\"><section class=\"controls card\"><h2>声音设置</h2><label>音量 <input id=\"volume\" aria-label=\"音量\" type=\"range\" min=\"0\" max=\"100\" value=\"40\"></label><button id=\"apply\">保存偏好</button><p id=\"saved\" role=\"status\"></p></section><aside class=\"preview card\"><h2>实时预览</h2><p id=\"sample\">音量：40</p></aside></div></main><script>const slider=document.querySelector('#volume'); const preview=document.querySelector('#sample'); slider.addEventListener('input',()=>{preview.textContent='音量：'+slider.value;});document.querySelector('#apply').addEventListener('click',()=>{document.querySelector('#saved').textContent='已保存 '+slider.value;});</script></html>",
          "topics/audio/prototypes/level/accepted.md": "# 已确认设计\n接受通知偏好预览 r2。桌面 1200×800 下设置位于左侧、预览位于右侧；窄屏 420×820 下预览先于设置和保存操作出现。音量变化立即更新预览，保存反馈位于操作后。接受关系和交互，未要求像素一致；私有 DOM/CSS 可调整。原型模拟保存，生产持久化由正式需求规定。\n"
        }
      },
      "expected": {
        "output": "结论记录当前r2接受范围、允许变化和演示排除，保留现有根。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "topics/audio/prototypes/level/verdict.md"
        ],
        "artifacts": [
          {
            "path": "topics/audio/prototypes/level/verdict.md",
            "exists": true
          }
        ]
      },
      "audit": {
        "rationale": "让原型结论成为可执行设计依据，并保持当前目录。",
        "minimalCounterexample": "无调用方位置且独立需要保存原型时可采用自身默认目录。",
        "allowedVariance": "接受等价术语、布局实现和步骤选择；以实际产物、副作用和证据判断，不强制模板标题或固定返回字段。"
      }
    },
    {
      "id": "prototype-feedback-not-current",
      "split": "validation",
      "tags": [
        "boundary"
      ],
      "prompt": "原型配置当前是r3，收到的用户反馈来自r2。请判断这份反馈能否作为r3的最终接受证据，只说明，不修改原型或启动会话。",
      "assertions": [
        "不把旧revision作为新版本批准。",
        "无文件修改或重复启动运行时。"
      ],
      "input": {
        "scriptedReplies": [],
        "workspaceFiles": {
          "prototype.json": "{\"schemaVersion\": 2, \"id\": \"audio-level\", \"revision\": 3, \"question\": \"预览的位置\", \"decisionContext\": {\"goal\": \"理解结果\", \"priorities\": [\"清楚\"], \"constraints\": []}, \"options\": [{\"id\": \"one\", \"label\": \"候选\", \"kind\": \"html\", \"artifact\": \"artifact/index.html\"}], \"stopCondition\": \"用户选定当前关系\"}",
          "feedback-note.md": "反馈已由原会话校验，绑定 audio-level r2：接受。当前没有r3提交。\n",
          "artifact/index.html": "<!doctype html><html lang=\"zh-CN\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>通知偏好预览</title><style>body{font-family:system-ui;margin:24px;color:#172132}main{max-width:980px;margin:auto}.layout{display:grid;grid-template-columns:1fr 1fr;gap:24px}.card{padding:16px;border:1px solid #cbd3df;border-radius:10px}button{margin-top:16px;padding:12px}label{display:block;margin:12px 0}@media(max-width:700px){.layout{display:flex;flex-direction:column}.preview{order:0}.controls{order:1}}</style><main><h1>通知偏好</h1><div class=\"layout\"><section class=\"controls card\"><h2>声音设置</h2><label>音量 <input id=\"volume\" aria-label=\"音量\" type=\"range\" min=\"0\" max=\"100\" value=\"40\"></label><button id=\"apply\">保存偏好</button><p id=\"saved\" role=\"status\"></p></section><aside class=\"preview card\"><h2>实时预览</h2><p id=\"sample\">音量：40</p></aside></div></main><script>const slider=document.querySelector('#volume'); const preview=document.querySelector('#sample'); slider.addEventListener('input',()=>{preview.textContent='音量：'+slider.value;});document.querySelector('#apply').addEventListener('click',()=>{document.querySelector('#saved').textContent='已保存 '+slider.value;});</script></html>"
        }
      },
      "expected": {
        "output": "指出r2反馈不能被改写为r3接受，保留已有意见作为参考并说明需要当前确认。",
        "workspaceUnchanged": true,
        "allowedWorkspaceChanges": []
      },
      "audit": {
        "rationale": "原有机器反馈版本语义继续保持。",
        "minimalCounterexample": "反馈确实绑定当前r3且已校验时可以消费当前结论。",
        "allowedVariance": "接受等价术语、布局实现和步骤选择；以实际产物、副作用和证据判断，不强制模板标题或固定返回字段。"
      }
    }
  ]
