{
  "schemaVersion": 3,
  "name": "decision-kit",
  "version": "0.1.0-beta.4",
  "description": "主题对齐、可体验决策与项目领域知识维护；按需组合，保留真实确认与清楚的独立职责。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "skills": "./skills",
  "distributions": {
    "agentSkills": {
      "skills": "./agent-skills/skills"
    }
  },
  "interface": {
    "displayName": "Decision Kit",
    "shortDescription": "对齐重要选择，验证原型，维护领域语言与决定",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {},
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-manifest.v3",
        "aw.plugin-skills.v1",
        "aw.portable-skills.v1"
      ]
    }
  }
}
