{
  "name": "git-commit",
  "version": "0.1.4",
  "description": "在用户明确要求创建 Git commit 时核对变更范围，优先遵守仓库规范并完成约定式提交。",
  "compatibility": {
    "aw": {
      "minVersion": "0.0.0"
    }
  },
  "skills": "./skills",
  "skillTriggers": {
    "commit": {
      "defaultTrigger": "auto",
      "allowDynamicTrigger": true
    }
  },
  "marketplace": {
    "category": "workflow",
    "tags": ["git", "commit"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "interface": {
    "displayName": "Git Commit",
    "shortDescription": "核对变更范围、仓库规范与提交边界后创建可追溯的约定式 Git 提交",
    "capabilities": ["Skills"]
  },
  "scripts": {
    "tests": {
      "node": ["./scripts/evals.test.mjs"]
    }
  },
  "buildConfig": {
    "templates": {
      "include": ["skills/**/*.md"],
      "vars": {
        "claudeCommandOutputFill": {
          "claude": true,
          "codex": false
        }
      }
    }
  }
}
