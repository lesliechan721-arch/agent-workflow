{
  "name": "git-commit",
  "version": "0.1.1",
  "description": "在用户请求提交时，核对变更范围并生成中文约定式 Git 提交。",
  "compatibility": {
    "aw": {
      "minVersion": "0.0.0"
    }
  },
  "skills": "./skills",
  "skillTriggers": {
    "commit": {
      "defaultTrigger": "auto",
      "allowDynamicTrigger": true
    }
  },
  "marketplace": {
    "category": "workflow",
    "tags": ["git", "commit"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "interface": {
    "displayName": "Git Commit",
    "shortDescription": "中文约定式 Git 提交",
    "capabilities": ["Skills"]
  },
  "buildConfig": {
    "templates": {
      "include": ["skills/**/*.md"],
      "vars": {
        "claudeCommandOutputFill": {
          "claude": true,
          "codex": false
        },
        "gitInspectionStep": {
          "claude": "1. 优先使用上方注入的 Git 快照确认工作区变更；快照不足以判断提交范围时，再运行必要的 Git 查看命令。",
          "codex": "1. 运行 `git status` 和必要的 `git diff`，确认当前工作区变更和提交范围。"
        }
      }
    }
  }
}
