{
  "name": "git-commit",
  "version": "0.1.3",
  "description": "在用户请求提交代码、文档或其它改动时，核对变更范围并完成中文约定式 Git 提交。",
  "compatibility": {
    "aw": {
      "minVersion": "0.0.0"
    }
  },
  "skills": "./skills",
  "skillTriggers": {
    "commit": {
      "defaultTrigger": "auto",
      "allowDynamicTrigger": true
    }
  },
  "marketplace": {
    "category": "workflow",
    "tags": ["git", "commit"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "interface": {
    "displayName": "Git Commit",
    "shortDescription": "中文约定式 Git 提交",
    "capabilities": ["Skills"]
  },
  "buildConfig": {
    "templates": {
      "include": ["skills/**/*.md"],
      "vars": {
        "claudeCommandOutputFill": {
          "claude": true,
          "codex": false
        }
      }
    }
  }
}
