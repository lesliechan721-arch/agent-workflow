{
  "schemaVersion": 2,
  "name": "aw-catalog-development",
  "version": "0.1.0-beta.1",
  "description": "创建、维护和只读评审 AW Catalog Workspace，并通过显式授权发布 Catalog。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.catalog-authoring.v1",
        "aw.catalog-dev-source.v1",
        "aw.catalog-publication.v1",
        "aw.plugin-authoring.v1",
        "aw.plugin-manifest.v2",
        "aw.plugin-skills.v1",
        "aw.self-check.v1"
      ]
    }
  },
  "dependencies": [
    "aw-plugin-development"
  ],
  "skills": "./skills",
  "interface": {
    "displayName": "AW Catalog Development",
    "shortDescription": "维护、评审和显式发布 AW Catalog Workspace",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {
    "timeoutMs": 30000
  }
}
