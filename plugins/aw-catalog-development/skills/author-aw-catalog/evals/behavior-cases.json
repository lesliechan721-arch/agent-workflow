{
  "version": 1,
  "suite": {
    "kind": "conversation",
    "unitUnderTest": "author-aw-catalog",
    "participants": [
      "author-aw-plugin"
    ],
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "Catalog composition 必须完成聚合验证，但插件内部源码仍由 Plugin Author 拥有。"
    },
    "runtime": {
      "isolation": "strict"
    }
  },
  "cases": [
    {
      "id": "maintain-plugin-and-aggregate",
      "split": "validation",
      "tags": [
        "representative",
        "catalog-maintenance",
        "platform-codex"
      ],
      "prompt": "使用 $author-aw-catalog 在当前 Workspace 新增 status-tools，使它依赖 shared-rules。插件内部修改交给 author-aw-plugin；返回后验证受影响闭包，并完成普通 Catalog build/validate。不要激活 development source，也不要发布。",
      "assertions": [
        "首次 AW 命令是 run-owned 真实 CLI 的 self check；随后用静态 catalog status 从 cwd 自动发现 Workspace",
        "把 canonical status-tools target、依赖和验收条件交给 author-aw-plugin；返回后只对受影响插件和反向依赖闭包运行所需 plugin validate/test/build",
        "普通维护最终运行 catalog build 和现有 snapshot validate，生成 schema 6 snapshot；没有 catalog dev activate 或 publication 命令"
      ],
      "input": {
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"author-maintenance-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Author Fixture\"},\"catalog\":{\"version\":\"0.1.0\"}}\n",
          "plugins/shared-rules/.agents-plugin/plugin.json": "{\"schemaVersion\":2,\"name\":\"shared-rules\",\"version\":\"0.1.0\",\"description\":\"Shared rules.\",\"marketplace\":{\"category\":\"workflow\",\"strict\":true,\"policy\":{\"installation\":\"AVAILABLE\",\"authentication\":\"ON_INSTALL\",\"products\":[\"CODEX\",\"CLAUDE\"]}},\"extensions\":{\"instructions\":[{\"name\":\"shared\",\"title\":\"Shared rules\",\"content\":\"Use shared rules.\"}]},\"requires\":{\"aw\":{\"capabilities\":[]}}}\n",
          "plugins/shared-rules/README.md": "# Shared rules\n",
          "fixtures/scenario.txt": "scenario=maintenance\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "Plugin Author 完成插件内部变更；Catalog Author 重读静态 status，验证受影响闭包并完成 schema 6 Catalog build/validate。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "plugins/status-tools/**",
          ".gitignore",
          ".aw/**",
          "fixtures/author-trace.jsonl"
        ],
        "artifacts": [
          {
            "path": "plugins/status-tools/.agents-plugin/plugin.json",
            "exists": true,
            "contains": [
              "status-tools",
              "shared-rules"
            ]
          },
          {
            "path": ".aw/catalog/catalog-manifest.json",
            "exists": true,
            "contains": [
              "\"schemaVersion\": 6",
              "status-tools",
              "shared-rules"
            ]
          }
        ]
      }
    },
    {
      "id": "remove-last-plugin-safely",
      "split": "validation",
      "tags": [
        "boundary",
        "high-cost",
        "catalog-safe-delete",
        "platform-codex"
      ],
      "prompt": "使用 $author-aw-catalog 安全删除当前 Workspace 中唯一的插件 legacy-rules。先用静态 status 检查它的反向依赖，并把 canonical `plugins/legacy-rules` target、Workspace root、删除意图和验收条件交给 author-aw-plugin 的公开删除分支。返回后重新读取 status；inventory 已为空时不要运行任何 plugin validate/test/build。完成普通 Catalog build/validate；不要激活 development source 或发布。",
      "assertions": [
        "首次 AW 命令是 self check；随后静态 catalog status 识别 canonical legacy-rules target、其空反向依赖闭包和合法 Workspace",
        "交接给 author-aw-plugin 时包含同一 Workspace root、canonical `plugins/legacy-rules` target、删除意图和验收条件；Catalog Author 不直接删除目录",
        "删除 receipt 返回后重新运行静态 status；真实 trace 不对已删除 legacy-rules 运行 plugin validate/test/build，空 inventory 后也不运行任何 plugin 命令",
        "最终只运行普通 catalog build 和现有 snapshot validate，生成空 entries 的 schema 6 snapshot；没有 dev、source mutation 或 publication 命令"
      ],
      "input": {
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"author-delete-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Author Delete Fixture\"},\"catalog\":{\"version\":\"0.1.0\"}}\n",
          "plugins/legacy-rules/.agents-plugin/plugin.json": "{\"schemaVersion\":2,\"name\":\"legacy-rules\",\"version\":\"0.1.0\",\"description\":\"Legacy rules.\",\"marketplace\":{\"category\":\"workflow\",\"strict\":true,\"policy\":{\"installation\":\"AVAILABLE\",\"authentication\":\"ON_INSTALL\",\"products\":[\"CODEX\",\"CLAUDE\"]}},\"extensions\":{\"instructions\":[{\"name\":\"legacy\",\"title\":\"Legacy rules\",\"content\":\"Use legacy rules.\"}]},\"requires\":{\"aw\":{\"capabilities\":[]}}}\n",
          "plugins/legacy-rules/README.md": "# Legacy rules\n",
          "fixtures/scenario.txt": "scenario=safe-delete-empty-inventory\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "检查 legacy-rules 的反向依赖并交接 canonical target；删除后确认空 inventory，不验证已删除目标，完成空 Catalog snapshot。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "plugins/legacy-rules/**",
          ".aw/**",
          "fixtures/author-trace.jsonl"
        ],
        "artifacts": [
          {
            "path": ".aw/catalog/catalog-manifest.json",
            "exists": true,
            "contains": [
              "\"schemaVersion\": 6",
              "\"entries\": []",
              "author-delete-fixture"
            ]
          },
          {
            "path": "fixtures/author-trace.jsonl",
            "exists": true,
            "contains": [
              "\"command\":\"catalog status\"",
              "\"command\":\"plugin remove\"",
              "\"command\":\"catalog build\"",
              "\"command\":\"catalog validate\""
            ],
            "notContains": [
              "plugin validate",
              "plugin test",
              "plugin build",
              "catalog dev",
              "catalog publish"
            ]
          },
          {
            "path": "plugins/legacy-rules/.agents-plugin/plugin.json",
            "exists": false
          }
        ]
      },
      "audit": {
        "rationale": "删除唯一 Plugin Source 后误验证已删除 target 或继续遍历空 inventory，会掩盖错误交接并扩大删除后的副作用。",
        "minimalCounterexample": "删除前 status 显示存在反向依赖时，必须把该闭包和 canonical target 交接，而不能直接执行删除。",
        "errorCost": "high"
      }
    }
  ]
}
