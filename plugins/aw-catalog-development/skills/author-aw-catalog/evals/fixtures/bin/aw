#!/usr/bin/env node

import { appendFileSync, realpathSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

const fixtureBin = realpathSync(path.dirname(fileURLToPath(import.meta.url)));
const forwardedPath = (process.env.PATH ?? '').split(path.delimiter).filter((entry) => {
  if (entry === '') return true;
  try {
    return realpathSync(entry) !== fixtureBin;
  } catch {
    return path.resolve(entry) !== fixtureBin;
  }
}).join(path.delimiter);
if (forwardedPath === '') {
  process.stderr.write('Author Eval fixture could not find the next aw on PATH.\n');
  process.exit(9);
}

const args = process.argv.slice(2);
const commandLength = args[0] === 'catalog' && args[1] === 'dev' ? 3 : 2;
const tracePath = path.join(process.cwd(), 'fixtures', 'author-trace.jsonl');
appendFileSync(tracePath, `${JSON.stringify({
  command: args.slice(0, commandLength).join(' '),
  args,
})}\n`, 'utf8');

const result = spawnSync('aw', args, {
  env: { ...process.env, PATH: forwardedPath },
  stdio: 'inherit',
});
if (result.error) {
  process.stderr.write(`${result.error.message}\n`);
  process.exit(9);
}
process.exit(result.status ?? 9);
