{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "author-aw-catalog",
    "participants": [
      "publish-aw-catalog",
      "author-aw-plugin"
    ],
    "defaultGrader": "mechanical",
    "policy": {
      "optimization": "precision-first",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "Catalog composition、单插件源码和远端发布有不同 owner。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": true
    }
  },
  "cases": [
    {
      "id": "maintain_catalog_composition",
      "split": "validation",
      "tags": [
        "representative",
        "catalog-authoring"
      ],
      "input": {
        "query": "在当前 AW Catalog 中新增 status-tools，让它依赖 shared-rules，并完成受影响闭包和 Catalog 聚合验证。",
        "expected": {
          "loadedSkills": [
            "author-aw-catalog"
          ]
        }
      }
    },
    {
      "id": "activate_local_development_catalog",
      "split": "validation",
      "tags": [
        "boundary",
        "catalog-development-source"
      ],
      "input": {
        "query": "把当前 Catalog Workspace 激活为本地 CLI development source，但不要发布。",
        "expected": {
          "loadedSkills": [
            "author-aw-catalog"
          ]
        }
      },
      "audit": {
        "rationale": "Development activation 是 Catalog 作者写操作，但不是远端发布。",
        "minimalCounterexample": "只查看现有 snapshot evidence 时应加载 Catalog Reviewer。"
      }
    },
    {
      "id": "plugin_internal_change",
      "split": "validation",
      "tags": [
        "boundary",
        "plugin-only-change"
      ],
      "input": {
        "query": "只修改已有 plugins/lifecycle-tools 的 uninstall lifecycle，不改 Catalog metadata、inventory、依赖或版本。",
        "expected": {
          "loadedSkills": [
            "author-aw-plugin"
          ]
        }
      },
      "audit": {
        "rationale": "单插件内部源码由 Plugin Author 直接拥有。",
        "minimalCounterexample": "新增、删除插件或改变同 source 依赖时由 Catalog Author 编排。"
      }
    },
    {
      "id": "remote_catalog_publication",
      "split": "validation",
      "tags": [
        "boundary",
        "catalog-publication"
      ],
      "input": {
        "query": "发布 Workspace ./catalog 到 remote staging、branch catalogs/team。",
        "expected": {
          "loadedSkills": [
            "publish-aw-catalog"
          ]
        }
      },
      "audit": {
        "rationale": "远端发布只由 Publisher 拥有。",
        "minimalCounterexample": "仅 build、validate 或 dev activate 时由 Catalog Author 处理。"
      }
    }
  ]
}
