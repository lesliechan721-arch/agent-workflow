{
  "version": 1,
  "suite": {
    "kind": "conversation",
    "unitUnderTest": "publish-aw-catalog",
    "policy": {
      "optimization": "critical",
      "falseNegativeCost": "high",
      "falsePositiveCost": "critical",
      "rationale": "漏发会延迟交付；未绑定 planDigest 的 apply、错 target 或错误恢复会写入不可变远端。"
    },
    "runtime": {
      "isolation": "strict"
    }
  },
  "cases": [
    {
      "id": "authorization-refusal-has-no-apply",
      "split": "validation",
      "tags": [
        "boundary",
        "publication-authorization-refusal",
        "platform-codex"
      ],
      "prompt": "使用 $publish-aw-catalog 发布 Workspace `.` 到 remote `staging`、branch `catalogs/team`。",
      "assertions": [
        "首次 AW 命令是 run-owned 真实 CLI 的 self check；随后只运行一次 catalog publish plan，显式传 root、remote、branch 和 --json",
        "一次授权问题先展示 plan receipt 的绝对 root、Workspace identity、source HEAD、Catalog version/channel/plugin count、安全 remote/fetch/push、remote identity digest、branch、parent、tag、expected commit、snapshot digest、state 和完整 planDigest，并且问题只授权该 planDigest",
        "用户拒绝后没有 catalog publish apply；fixture state 仍是 prepared 且 applyCalls=0"
      ],
      "input": {
        "scriptedReplies": [
          {
            "expectedQuestionCount": 1,
            "answersByIndex": [
              "拒绝，不授权这个 planDigest。"
            ],
            "unexpectedQuestionAnswer": "不授权任何 apply。"
          }
        ],
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"publisher-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Publisher Fixture\"},\"catalog\":{\"version\":\"0.4.0\"}}\n",
          "fixtures/scenario.txt": "scenario=authorization-refusal\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "展示稳定 plan identity 并请求一次 planDigest 授权；拒绝后停止。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "fixtures/publisher-trace.jsonl",
          "fixtures/publisher-state.json"
        ],
        "artifacts": [
          {
            "path": "fixtures/publisher-trace.jsonl",
            "exists": true,
            "contains": [
              "\"command\":\"catalog publish plan\""
            ],
            "notContains": [
              "catalog publish apply"
            ]
          },
          {
            "path": "fixtures/publisher-state.json",
            "exists": true,
            "json": {
              "planCalls": 1,
              "applyCalls": 0,
              "state": "prepared",
              "lastPlanDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "reconciliation": null
            }
          }
        ]
      },
      "audit": {
        "rationale": "最初发布请求和成功 plan 都不授权 apply。",
        "minimalCounterexample": "用户看到完整 identity 后明确授权该 planDigest，才可运行一次 apply。"
      }
    },
    {
      "id": "authorized-plan-applies-once",
      "split": "validation",
      "tags": [
        "representative",
        "publication-success",
        "platform-codex"
      ],
      "prompt": "使用 $publish-aw-catalog 发布 Workspace `.` 到 remote `staging`、branch `catalogs/team`。",
      "assertions": [
        "self check 后运行一次显式 catalog publish plan；在任何 apply 前只请求一次完整 planDigest 授权",
        "授权后运行一次 catalog publish apply，显式回传 plan receipt 的 root、remote、branch、--expected-plan-digest、--yes 和 --json",
        "成功 receipt 的 root、identity、source HEAD、remote、branch、snapshotDigest 和 planDigest 与授权 plan 一致，并报告 state=published 与 reconciliation=atomic"
      ],
      "input": {
        "scriptedReplies": [
          {
            "expectedQuestionCount": 1,
            "answersByIndex": [
              "授权 planDigest sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa。"
            ],
            "unexpectedQuestionAnswer": "只授权已展示的精确 planDigest。"
          }
        ],
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"publisher-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Publisher Fixture\"},\"catalog\":{\"version\":\"0.4.0\"}}\n",
          "fixtures/scenario.txt": "scenario=publish-success\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "plan→一次 planDigest 授权→一次 apply，并核对 published receipt。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "fixtures/publisher-trace.jsonl",
          "fixtures/publisher-state.json"
        ],
        "artifacts": [
          {
            "path": "fixtures/publisher-trace.jsonl",
            "exists": true,
            "contains": [
              "\"command\":\"catalog publish plan\"",
              "\"command\":\"catalog publish apply\"",
              "--expected-plan-digest",
              "--yes",
              "--json"
            ]
          },
          {
            "path": "fixtures/publisher-state.json",
            "exists": true,
            "json": {
              "planCalls": 1,
              "applyCalls": 1,
              "state": "published",
              "lastPlanDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "reconciliation": "atomic"
            }
          }
        ]
      }
    },
    {
      "id": "uncertain-same-plan-recovers",
      "split": "validation",
      "tags": [
        "regression",
        "publication-uncertain-recovery",
        "platform-codex"
      ],
      "prompt": "使用 $publish-aw-catalog 恢复 Workspace `.` 到 remote `staging`、branch `catalogs/team` 的上一轮不确定发布。先重新取得现有 plan；如果 state 是 uncertain，只对相同 planDigest 请求授权并 apply 对账。",
      "assertions": [
        "catalog publish plan 返回 state=uncertain 和原 planDigest；Skill 不要求提高版本或生成不同 plan",
        "一次授权只绑定该 planDigest；随后 apply 使用相同 root、remote、branch 和 expected plan digest",
        "apply 返回 published、reconciliation=already-remote；没有删除 journal/repository、重新 build、第二次授权或第二次 apply"
      ],
      "input": {
        "scriptedReplies": [
          {
            "expectedQuestionCount": 1,
            "answersByIndex": [
              "授权相同 planDigest sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa 进行对账。"
            ],
            "unexpectedQuestionAnswer": "只授权已展示的同一 planDigest。"
          }
        ],
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"publisher-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Publisher Fixture\"},\"catalog\":{\"version\":\"0.4.0\"}}\n",
          "fixtures/scenario.txt": "scenario=uncertain-recovery\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "保留相同 planDigest 并 apply 对账，最终报告 already-remote published。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "fixtures/publisher-trace.jsonl",
          "fixtures/publisher-state.json"
        ],
        "artifacts": [
          {
            "path": "fixtures/publisher-state.json",
            "exists": true,
            "json": {
              "planCalls": 1,
              "applyCalls": 1,
              "state": "published",
              "lastPlanDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "reconciliation": "already-remote"
            }
          }
        ]
      },
      "audit": {
        "rationale": "当前合同允许 uncertain 的同一 journal plan 对账或续跑。",
        "minimalCounterexample": "plan identity 改变、pending state 损坏或 ref 冲突时必须停止并提高版本。"
      }
    },
    {
      "id": "authorized-plan-drift-or-corrupt-pending-stops",
      "split": "validation",
      "tags": [
        "boundary",
        "high-cost",
        "publication-plan-drift",
        "platform-codex"
      ],
      "prompt": "使用 $publish-aw-catalog 发布 Workspace `.` 到 remote `staging`、branch `catalogs/team`。展示 planDigest 后，我只授权该精确 digest。随后 apply receipt 说明 pending journal 的 plan 已变为不同 digest，且隔离 repository 缺失或损坏。停止这次发布；不要重新 plan、不要再次 apply，也不要修复或删除 journal/repository。",
      "assertions": [
        "首次 AW 命令是 run-owned 真实 CLI 的 self check；随后只运行一次带明确 root、remote、branch 和 --json 的 catalog publish plan，并在 apply 前只请求一次完整 planDigest 授权",
        "授权问题和 apply 的 --expected-plan-digest 都绑定最初展示的 digest；不接受不同 plan、旧授权或只授权 remote",
        "apply 的公开 failure receipt 说明 pending plan drift 或 pending journal/repository 缺失或损坏时，报告停止并要求提高 Catalog version 后生成新 plan",
        "真实 trace 只有一次 plan 和一次已授权的 apply；没有额外 apply、第二个 plan 或 journal/repository mutation"
      ],
      "input": {
        "scriptedReplies": [
          {
            "expectedQuestionCount": 1,
            "answersByIndex": [
              "只授权 planDigest sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa。"
            ],
            "unexpectedQuestionAnswer": "只授权已展示的精确 planDigest。"
          }
        ],
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"publisher-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Publisher Fixture\"},\"catalog\":{\"version\":\"0.4.0\"}}\n",
          "fixtures/scenario.txt": "scenario=authorized-plan-drift-or-corrupt-pending\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "已授权的 plan 不再可安全 apply：停止、不重试、不修复 pending state，并要求提高版本后重新 plan。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "fixtures/publisher-trace.jsonl",
          "fixtures/publisher-state.json"
        ],
        "artifacts": [
          {
            "path": "fixtures/publisher-trace.jsonl",
            "exists": true,
            "contains": [
              "\"command\":\"catalog publish plan\"",
              "\"command\":\"catalog publish apply\"",
              "--expected-plan-digest",
              "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            ]
          },
          {
            "path": "fixtures/publisher-state.json",
            "exists": true,
            "json": {
              "planCalls": 1,
              "applyCalls": 1,
              "state": "prepared",
              "lastPlanDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "authorizedPlanDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "pendingPlanDigest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
              "reconciliation": null,
              "stopReason": "plan-drift-or-corrupt-pending",
              "requiresVersionBump": true
            }
          }
        ]
      },
      "audit": {
        "rationale": "授权后 plan identity 漂移或 pending artifact 损坏时，继续 apply 可能向不可变远端写入未授权内容。",
        "minimalCounterexample": "只有 prepared 或 uncertain 的同一 journal plan、相同 planDigest 和可用 pending artifacts 才能对账或重试 apply。",
        "errorCost": "high"
      }
    }
  ]
}
