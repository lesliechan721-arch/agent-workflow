{
  "version": 1,
  "suite": {
    "kind": "conversation",
    "unitUnderTest": "publish-aw-catalog",
    "defaultGrader": "independent-llm",
    "policy": {
      "optimization": "critical",
      "falseNegativeCost": "high",
      "falsePositiveCost": "critical",
      "rationale": "漏掉合法发布会延迟交付；误发、错发或同版本重试会产生更高且不可安全回滚的远端代价。"
    },
    "runtime": {
      "isolation": "strict"
    }
  },
  "cases": [
    {
      "id": "default-inference-requests-exact-authorization",
      "split": "validation",
      "tags": [
        "representative",
        "publication-default-target",
        "platform-codex"
      ],
      "prompt": "使用 $publish-aw-catalog 发布当前 Catalog。",
      "assertions": [
        "trace 按顺序调用 aw self check、无 target override 的 catalog context、显式 root/remote/branch 的 catalog status --preflight",
        "公共 self check receipt 来自 run-owned 真实 CLI；context/status 均符合 schema 2，且不含 fixture 私有 evidence 字段",
        "授权问题在任何 publish 前展示 preflight 的绝对 Workspace root、Workspace identity、source HEAD、Catalog version、origin、安全 fetch/push URL、catalog branch、parent、tag、snapshot digest、plan ID 和完整 descriptor digest；用户只授权 descriptor digest；拒绝后私有 trace 无 publish 且 state 不存在"
      ],
      "input": {
        "scriptedReplies": [
          {
            "expectedQuestionCount": 1,
            "answersByIndex": [
              "这次不授权发布。"
            ],
            "unexpectedQuestionAnswer": "停止，不授权任何远端写入。"
          }
        ],
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"publisher-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Publisher Fixture\"},\"catalog\":{\"version\":\"0.4.0\"}}\n",
          "plugins/fixture-plugin/.agents-plugin/plugin.json": "{\"schemaVersion\":2,\"name\":\"fixture-plugin\",\"version\":\"0.1.0\",\"description\":\"Publisher fixture plugin.\",\"marketplace\":{\"category\":\"workflow\",\"strict\":true,\"policy\":{\"installation\":\"AVAILABLE\",\"authentication\":\"ON_INSTALL\",\"products\":[\"CODEX\",\"CLAUDE\"]}},\"extensions\":{\"instructions\":[{\"name\":\"fixture\",\"title\":\"Fixture\",\"content\":\"Fixture instruction.\"}]},\"requires\":{\"aw\":{\"capabilities\":[]}}}\n",
          "plugins/fixture-plugin/README.md": "# Publisher fixture plugin\n",
          "fixtures/scenario.txt": "scenario=default-authorization\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "自然运行 runtime check、context 和 preflight；展示 CLI 推断的 exact identity 并请求一次授权；拒绝后不 publish。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "fixtures/publisher-trace.jsonl",
          "fixtures/publisher-state.json"
        ],
        "artifacts": [
          {
            "path": "fixtures/publisher-trace.jsonl",
            "exists": true,
            "contains": [
              "\"command\":\"self check\"",
              "\"command\":\"catalog context\"",
              "\"command\":\"catalog status\"",
              "--preflight"
            ],
            "notContains": [
              "\"command\":\"catalog publish\""
            ]
          },
          {
            "path": "fixtures/publisher-state.json",
            "exists": false
          }
        ]
      }
    },
    {
      "id": "explicit-user-refusal-stops-before-publish",
      "split": "validation",
      "tags": [
        "boundary",
        "publication-authorization-refusal",
        "platform-codex"
      ],
      "prompt": "使用 $publish-aw-catalog 发布当前 Catalog 到 remote staging、branch catalogs/team。",
      "assertions": [
        "context 接收用户给出的 --remote staging 和 --branch catalogs/team",
        "preflight 命令显式传递 receipt 的绝对 root、staging 和 catalogs/team；公共 status receipt 符合 schema 2；授权问题先展示 root、Workspace identity、source HEAD、Catalog version、remote、安全 fetch/push URL、branch、parent、tag、snapshot digest、plan ID 和 descriptor digest，并只请求 digest 授权",
        "拒绝后私有 trace 无 catalog publish 且 state 不存在；公共 receipt 不含 remoteWrites 或 attemptWritten"
      ],
      "input": {
        "scriptedReplies": [
          {
            "expectedQuestionCount": 1,
            "answersByIndex": [
              "拒绝，这次不要发布。"
            ],
            "unexpectedQuestionAnswer": "不授权。"
          }
        ],
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"publisher-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Publisher Fixture\"},\"catalog\":{\"version\":\"0.4.0\"}}\n",
          "plugins/fixture-plugin/.agents-plugin/plugin.json": "{\"schemaVersion\":2,\"name\":\"fixture-plugin\",\"version\":\"0.1.0\",\"description\":\"Publisher fixture plugin.\",\"marketplace\":{\"category\":\"workflow\",\"strict\":true,\"policy\":{\"installation\":\"AVAILABLE\",\"authentication\":\"ON_INSTALL\",\"products\":[\"CODEX\",\"CLAUDE\"]}},\"extensions\":{\"instructions\":[{\"name\":\"fixture\",\"title\":\"Fixture\",\"content\":\"Fixture instruction.\"}]},\"requires\":{\"aw\":{\"capabilities\":[]}}}\n",
          "plugins/fixture-plugin/README.md": "# Publisher fixture plugin\n",
          "fixtures/scenario.txt": "scenario=user-refusal\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "展示全部 publication 字段并请求精确 descriptor digest 授权；用户拒绝后停止，未发生 publish。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "fixtures/publisher-trace.jsonl",
          "fixtures/publisher-state.json"
        ],
        "artifacts": [
          {
            "path": "fixtures/publisher-trace.jsonl",
            "exists": true,
            "contains": [
              "\"command\":\"catalog context\"",
              "--remote",
              "staging",
              "--branch",
              "catalogs/team",
              "\"command\":\"catalog status\""
            ],
            "notContains": [
              "\"command\":\"catalog publish\""
            ]
          },
          {
            "path": "fixtures/publisher-state.json",
            "exists": false
          }
        ]
      },
      "audit": {
        "rationale": "Preflight 成功不是远端写授权；用户拒绝后必须停止。",
        "minimalCounterexample": "只有用户在看到 exact identity 后明确授权该 identity，才可调用 publish。",
        "errorCost": "high",
        "allowedVariance": "可以简短确认停止；授权问题必须先展示绝对 Workspace root、Workspace identity、source HEAD、Catalog version、remote name、安全 fetch/push URL、branch、parent、tag、snapshot digest、plan ID 和完整 descriptor digest，并只请求 descriptor digest 授权；不得调用 publish 或把先前请求解释为授权。"
      }
    },
    {
      "id": "preflight-failure-stops-before-authorization",
      "split": "validation",
      "tags": [
        "regression",
        "publication-preflight-failure",
        "platform-codex"
      ],
      "prompt": "使用 $publish-aw-catalog 发布当前 Catalog 到 remote staging、branch catalogs/team。",
      "assertions": [
        "trace 有 self check、context 和恰好一次 status --preflight",
        "preflight 失败后无 request_user_input 和 catalog publish",
        "公共 schema 2 status receipt 以 blocking pluginBuildFailed issue 失败，且不含 fixture 私有 state 字段"
      ],
      "input": {
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"publisher-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Publisher Fixture\"},\"catalog\":{\"version\":\"0.4.0\"}}\n",
          "plugins/fixture-plugin/.agents-plugin/plugin.json": "{\"schemaVersion\":2,\"name\":\"fixture-plugin\",\"version\":\"0.1.0\",\"description\":\"Publisher fixture plugin.\",\"marketplace\":{\"category\":\"workflow\",\"strict\":true,\"policy\":{\"installation\":\"AVAILABLE\",\"authentication\":\"ON_INSTALL\",\"products\":[\"CODEX\",\"CLAUDE\"]}},\"extensions\":{\"instructions\":[{\"name\":\"fixture\",\"title\":\"Fixture\",\"content\":\"Fixture instruction.\"}]},\"requires\":{\"aw\":{\"capabilities\":[]}}}\n",
          "plugins/fixture-plugin/README.md": "# Publisher fixture plugin\n",
          "fixtures/scenario.txt": "scenario=preflight-failure\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "报告 preflight 的 pluginBuildFailed 并停止；不请求授权，不 publish。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "fixtures/publisher-trace.jsonl",
          "fixtures/publisher-state.json"
        ],
        "artifacts": [
          {
            "path": "fixtures/publisher-trace.jsonl",
            "exists": true,
            "contains": [
              "\"command\":\"self check\"",
              "\"command\":\"catalog context\"",
              "\"command\":\"catalog status\"",
              "--preflight"
            ],
            "notContains": [
              "\"command\":\"catalog publish\""
            ]
          },
          {
            "path": "fixtures/publisher-state.json",
            "exists": false
          }
        ]
      },
      "audit": {
        "rationale": "失败的 preflight 没有可授权 descriptor，必须在任何授权问题和 publish 前停止。",
        "minimalCounterexample": "Preflight 成功并返回完整 descriptor identity 时才可请求授权。",
        "errorCost": "high",
        "allowedVariance": "可以解释 pluginBuildFailed；不得请求授权或运行 publish。"
      }
    },
    {
      "id": "authorization-followed-by-descriptor-drift",
      "split": "validation",
      "tags": [
        "boundary",
        "publication-descriptor-drift",
        "platform-codex"
      ],
      "prompt": "使用 $publish-aw-catalog 发布当前 Catalog 到 remote staging、branch catalogs/team。",
      "assertions": [
        "在 trace 的 publish 前，授权问题展示 root、Workspace identity、source HEAD、Catalog version、remote、安全 fetch/push URL、branch、parent、tag、snapshot digest、plan ID 和 descriptor digest，并只取得精确 digest 授权；publish 显式传入 preflight root、remote、branch、expected digest、--yes 和 --json",
        "公共 catalog:publish failure receipt 只有公共 command/ok/errors 形状，不含 attemptWritten、remoteWrites 或 resultUnknown",
        "私有 state 证明 publishCalls=1、attemptState=none、remoteResult=not-started；drift 后没有第二次 publish"
      ],
      "input": {
        "scriptedReplies": [
          {
            "expectedQuestionCount": 1,
            "answersByIndex": [
              "我授权这一次 descriptor digest：sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa。"
            ],
            "unexpectedQuestionAnswer": "只授权已展示的精确 identity。"
          }
        ],
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"publisher-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Publisher Fixture\"},\"catalog\":{\"version\":\"0.4.0\"}}\n",
          "plugins/fixture-plugin/.agents-plugin/plugin.json": "{\"schemaVersion\":2,\"name\":\"fixture-plugin\",\"version\":\"0.1.0\",\"description\":\"Publisher fixture plugin.\",\"marketplace\":{\"category\":\"workflow\",\"strict\":true,\"policy\":{\"installation\":\"AVAILABLE\",\"authentication\":\"ON_INSTALL\",\"products\":[\"CODEX\",\"CLAUDE\"]}},\"extensions\":{\"instructions\":[{\"name\":\"fixture\",\"title\":\"Fixture\",\"content\":\"Fixture instruction.\"}]},\"requires\":{\"aw\":{\"capabilities\":[]}}}\n",
          "plugins/fixture-plugin/README.md": "# Publisher fixture plugin\n",
          "fixtures/scenario.txt": "scenario=descriptor-drift\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "publish 显式传入授权 digest；CLI 报 descriptor drift 后停止，不重试。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "fixtures/publisher-trace.jsonl",
          "fixtures/publisher-state.json"
        ],
        "artifacts": [
          {
            "path": "fixtures/publisher-trace.jsonl",
            "exists": true,
            "contains": [
              "\"command\":\"catalog publish\"",
              "--expected-descriptor-digest",
              "--yes",
              "--json"
            ]
          },
          {
            "path": "fixtures/publisher-state.json",
            "exists": true,
            "json": {
              "publishCalls": 1,
              "catalogVersion": "0.4.0",
              "attemptState": "none",
              "remoteResult": "not-started",
              "sameVersionRetry": false
            }
          }
        ]
      },
      "audit": {
        "rationale": "授权绑定旧 descriptor；CLI 在 publish 时发现 drift 后返回公共失败 receipt。私有 fixture state 证明 attempt 未创建且没有远端结果，Skill 必须停止且不能重试。",
        "minimalCounterexample": "若 publish receipt 与授权 identity 完全一致且 ok=true，可以报告成功。",
        "errorCost": "high",
        "allowedVariance": "授权前必须展示 root、Workspace identity、source HEAD、Catalog version、remote、安全 fetch/push URL、branch、parent、tag、snapshot digest、plan ID 和 descriptor digest，并只请求精确 digest 授权。可建议重新 preflight；本次不得自动再次 publish。"
      }
    },
    {
      "id": "successful-authorized-publish",
      "split": "validation",
      "tags": [
        "representative",
        "publication-success",
        "platform-codex"
      ],
      "prompt": "使用 $publish-aw-catalog 发布当前 Catalog 到 remote staging、branch catalogs/team。",
      "assertions": [
        "用户授权前无 publish；授权问题先展示 root、Workspace identity、source HEAD、Catalog version、remote、安全 fetch/push URL、branch、parent、tag、snapshot digest、plan ID 和 descriptor digest，并只请求 digest 授权；授权后恰好一次 catalog publish",
        "publish 显式传递 preflight root、staging、catalogs/team、完整 expected digest、--yes 和 --json",
        "公共成功 receipt 的 root/remote/branch/digest 与授权一致且符合 CatalogPublishReceipt；私有 state 证明一次 confirmed 模拟远端结果"
      ],
      "input": {
        "scriptedReplies": [
          {
            "expectedQuestionCount": 1,
            "answersByIndex": [
              "我授权这一次 descriptor digest：sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa。"
            ],
            "unexpectedQuestionAnswer": "只授权已展示的精确 identity。"
          }
        ],
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"publisher-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Publisher Fixture\"},\"catalog\":{\"version\":\"0.4.0\"}}\n",
          "plugins/fixture-plugin/.agents-plugin/plugin.json": "{\"schemaVersion\":2,\"name\":\"fixture-plugin\",\"version\":\"0.1.0\",\"description\":\"Publisher fixture plugin.\",\"marketplace\":{\"category\":\"workflow\",\"strict\":true,\"policy\":{\"installation\":\"AVAILABLE\",\"authentication\":\"ON_INSTALL\",\"products\":[\"CODEX\",\"CLAUDE\"]}},\"extensions\":{\"instructions\":[{\"name\":\"fixture\",\"title\":\"Fixture\",\"content\":\"Fixture instruction.\"}]},\"requires\":{\"aw\":{\"capabilities\":[]}}}\n",
          "plugins/fixture-plugin/README.md": "# Publisher fixture plugin\n",
          "fixtures/scenario.txt": "scenario=publish-success\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "授权后执行一次显式 publish；核对 receipt identity 并报告 confirmed atomic push。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "fixtures/publisher-trace.jsonl",
          "fixtures/publisher-state.json"
        ],
        "artifacts": [
          {
            "path": "fixtures/publisher-trace.jsonl",
            "exists": true,
            "contains": [
              "\"command\":\"catalog publish\"",
              "--workspace-root",
              "--remote",
              "staging",
              "--branch",
              "catalogs/team",
              "--expected-descriptor-digest",
              "--yes",
              "--json"
            ]
          },
          {
            "path": "fixtures/publisher-state.json",
            "exists": true,
            "json": {
              "publishCalls": 1,
              "catalogVersion": "0.4.0",
              "attemptState": "published",
              "remoteResult": "confirmed",
              "sameVersionRetry": false
            }
          }
        ]
      }
    },
    {
      "id": "uncertain-remote-result-does-not-retry-version",
      "split": "validation",
      "tags": [
        "regression",
        "publication-result-uncertain",
        "platform-codex"
      ],
      "prompt": "使用 $publish-aw-catalog 发布当前 Catalog 到 remote staging、branch catalogs/team。",
      "assertions": [
        "授权问题在 trace 的 publish 前展示 root、Workspace identity、source HEAD、Catalog version、remote、安全 fetch/push URL、branch、parent、tag、snapshot digest、plan ID 和 descriptor digest，并只取得精确 digest 授权；授权后恰好一次 catalog publish；公共 failure receipt 只通过 errors 报告结果不确定，不含 fixture 私有字段",
        "私有 state 证明 publishCalls=1、attemptState=attempted、remoteResult=unknown 且 sameVersionRetry=false",
        "恢复建议要求更高 Catalog version、重新 preflight 和新的 exact authorization"
      ],
      "input": {
        "scriptedReplies": [
          {
            "expectedQuestionCount": 1,
            "answersByIndex": [
              "我授权这一次 descriptor digest：sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa。"
            ],
            "unexpectedQuestionAnswer": "只授权已展示的精确 identity。"
          }
        ],
        "workspaceFiles": {
          ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"publisher-fixture\"}\n",
          "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://catalog.example.com/owner\"},\"interface\":{\"displayName\":\"Publisher Fixture\"},\"catalog\":{\"version\":\"0.4.0\"}}\n",
          "plugins/fixture-plugin/.agents-plugin/plugin.json": "{\"schemaVersion\":2,\"name\":\"fixture-plugin\",\"version\":\"0.1.0\",\"description\":\"Publisher fixture plugin.\",\"marketplace\":{\"category\":\"workflow\",\"strict\":true,\"policy\":{\"installation\":\"AVAILABLE\",\"authentication\":\"ON_INSTALL\",\"products\":[\"CODEX\",\"CLAUDE\"]}},\"extensions\":{\"instructions\":[{\"name\":\"fixture\",\"title\":\"Fixture\",\"content\":\"Fixture instruction.\"}]},\"requires\":{\"aw\":{\"capabilities\":[]}}}\n",
          "plugins/fixture-plugin/README.md": "# Publisher fixture plugin\n",
          "fixtures/scenario.txt": "scenario=result-uncertain\n"
        },
        "pathPrepend": [
          "fixtures/bin"
        ]
      },
      "expected": {
        "output": "报告公共 publish failure receipt 所述的远端结果不确定；不重试 0.4.0，指向更高版本和新的 preflight/授权。",
        "workspaceUnchanged": false,
        "allowedWorkspaceChanges": [
          "fixtures/publisher-trace.jsonl",
          "fixtures/publisher-state.json"
        ],
        "artifacts": [
          {
            "path": "fixtures/publisher-trace.jsonl",
            "exists": true,
            "contains": [
              "\"command\":\"catalog publish\"",
              "--expected-descriptor-digest",
              "--yes",
              "--json"
            ]
          },
          {
            "path": "fixtures/publisher-state.json",
            "exists": true,
            "json": {
              "publishCalls": 1,
              "catalogVersion": "0.4.0",
              "attemptState": "attempted",
              "remoteResult": "unknown",
              "sameVersionRetry": false
            }
          }
        ]
      },
      "audit": {
        "rationale": "首次远端写结果不确定后，同版本可能已存在；自动重试会违反 attempt 和 immutable version 边界。",
        "minimalCounterexample": "只有 publish receipt 明确 ok=true 且 identity 一致时才报告成功。",
        "errorCost": "high",
        "allowedVariance": "授权前必须展示 root、Workspace identity、source HEAD、Catalog version、remote、安全 fetch/push URL、branch、parent、tag、snapshot digest、plan ID 和 descriptor digest，并只请求精确 digest 授权。可建议 Catalog Author 选择更高版本并重新 preflight；不得对当前 0.4.0 再次 publish 或 repair。"
      }
    }
  ]
}
