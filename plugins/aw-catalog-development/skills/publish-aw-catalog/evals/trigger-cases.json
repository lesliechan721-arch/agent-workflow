{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "publish-aw-catalog",
    "participants": [
      "author-aw-catalog"
    ],
    "defaultGrader": "mechanical",
    "policy": {
      "optimization": "precision-first",
      "falseNegativeCost": "high",
      "falsePositiveCost": "critical",
      "rationale": "清晰 publication 意图应加载 Publisher；准备和本地开发不应触发远端发布。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": true
    }
  },
  "cases": [
    {
      "id": "publish_explicit_target",
      "split": "validation",
      "tags": [
        "representative",
        "explicit-publication"
      ],
      "input": {
        "query": "发布 Workspace ./catalog 到 remote staging、branch catalogs/team。",
        "expected": {
          "loadedSkills": [
            "publish-aw-catalog"
          ]
        }
      }
    },
    {
      "id": "publish_missing_target_details",
      "split": "validation",
      "tags": [
        "boundary",
        "publication-target-required"
      ],
      "input": {
        "query": "把这个 Catalog 发布出去。",
        "expected": {
          "loadedSkills": [
            "publish-aw-catalog"
          ]
        }
      },
      "audit": {
        "rationale": "发布意图应路由到 Publisher，但缺少 root、remote 或 branch 时不能运行 plan。",
        "minimalCounterexample": "只要求 build 或准备验证结果且不要发布时使用 Catalog Author。"
      }
    },
    {
      "id": "prepare_without_publication",
      "split": "validation",
      "tags": [
        "boundary",
        "catalog-authoring"
      ],
      "input": {
        "query": "维护 Catalog 并准备好 build/validate 结果，但不要发布。",
        "expected": {
          "loadedSkills": [
            "author-aw-catalog"
          ]
        }
      },
      "audit": {
        "rationale": "准备和验证由 Catalog Author 拥有。",
        "minimalCounterexample": "明确要求远端 publication 时加载 Publisher。"
      }
    }
  ]
}
