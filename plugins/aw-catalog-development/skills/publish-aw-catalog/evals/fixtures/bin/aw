#!/usr/bin/env node

import {
  appendFileSync,
  existsSync,
  readFileSync,
  realpathSync,
  writeFileSync,
} from 'node:fs';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

const fixtureBin = realpathSync(path.dirname(fileURLToPath(import.meta.url)));
const forwardedPath = (process.env.PATH ?? '').split(path.delimiter).filter((entry) => {
  if (entry === '') return true;
  try {
    return realpathSync(entry) !== fixtureBin;
  } catch {
    return path.resolve(entry) !== fixtureBin;
  }
}).join(path.delimiter);
if (forwardedPath === '') {
  process.stderr.write('Publisher Eval fixture could not find the next aw on PATH.\n');
  process.exit(9);
}

const args = process.argv.slice(2);
const root = realpathSync(process.cwd());
const scenario = readFileSync('fixtures/scenario.txt', 'utf8').trim().replace(/^scenario=/u, '');
const tracePath = path.join(root, 'fixtures', 'publisher-trace.jsonl');
const statePath = path.join(root, 'fixtures', 'publisher-state.json');
const planDigest = 'sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
const pendingPlanDigest = 'sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd';
const snapshotDigest = 'sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';
const remoteIdentityDigest = 'sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc';
const sourceHead = '0123456789abcdef0123456789abcdef01234567';
const expectedCommit = 'fedcba9876543210fedcba9876543210fedcba98';
const remote = 'staging';
const branch = 'catalogs/team';
const descriptor = {
  schemaVersion: 1,
  workspaceIdentity: 'publisher-fixture',
  sourceHead,
  remote: { name: remote, identityDigest: remoteIdentityDigest },
  branch,
  parent: null,
  tag: 'catalog-v0.4.0',
  snapshotDigest,
};

const commandLength = args[0] === 'catalog' && args[1] === 'publish' ? 3 : 2;
appendFileSync(tracePath, `${JSON.stringify({
  command: args.slice(0, commandLength).join(' '),
  args,
})}\n`, 'utf8');

function emit(receipt) {
  process.stdout.write(`${JSON.stringify(receipt)}\n`);
}

function optionValue(name) {
  const index = args.indexOf(name);
  return index >= 0 ? args[index + 1] : undefined;
}

function hasOption(name) {
  return args.includes(name);
}

function baseReceipt(repositoryPath) {
  return {
    ok: true,
    workspaceRoot: root,
    workspaceRootResolvedFrom: 'explicit',
    workspaceIdentity: descriptor.workspaceIdentity,
    catalogVersion: '0.4.0',
    channel: 'latest',
    remote,
    remoteResolvedFrom: 'explicit',
    remoteUrl: 'https://catalog.example.com/repository.git',
    fetchUrl: 'https://catalog.example.com/repository.git',
    pushUrl: 'https://catalog.example.com/repository.git',
    branch,
    branchResolvedFrom: 'explicit',
    parent: descriptor.parent,
    tag: descriptor.tag,
    expectedCommit,
    sourceHead,
    pluginCount: 0,
    snapshotDigest,
    planDigest,
    descriptor,
    journalPath: path.join(root, '.aw', 'publish', '0.4.0.json'),
    repositoryPath,
  };
}

function readState() {
  return existsSync(statePath)
    ? JSON.parse(readFileSync(statePath, 'utf8'))
    : null;
}

function writeState(state) {
  writeFileSync(statePath, `${JSON.stringify(state, null, 2)}\n`, 'utf8');
}

function fail(command, message) {
  emit({ command, ok: false, errors: [{ message }] });
  process.stderr.write(`${message}\n`);
  process.exit(1);
}

function targetArgumentsValid() {
  const workspaceRoot = optionValue('--workspace-root');
  return workspaceRoot !== undefined
    && path.resolve(root, workspaceRoot) === root
    && optionValue('--remote') === remote
    && optionValue('--branch') === branch
    && hasOption('--json');
}

if (args[0] === 'self' && args[1] === 'check') {
  const result = spawnSync('aw', args, {
    env: { ...process.env, PATH: forwardedPath },
    stdio: 'inherit',
  });
  if (result.error) {
    process.stderr.write(`${result.error.message}\n`);
    process.exit(9);
  }
  process.exit(result.status ?? 9);
}

if (args[0] === 'catalog' && args[1] === 'publish' && args[2] === 'plan') {
  if (!targetArgumentsValid()) {
    fail('catalog:publish:plan', 'Publisher plan did not use the explicit Workspace root, remote, branch, and JSON output.');
  }
  if (scenario === 'plan-failure') {
    fail('catalog:publish:plan', 'Catalog publish plan fixture failed before an authorization identity was created.');
  }
  const state = scenario === 'uncertain-recovery' ? 'uncertain' : 'prepared';
  writeState({
    planCalls: 1,
    applyCalls: 0,
    state,
    lastPlanDigest: planDigest,
    reconciliation: null,
  });
  emit({
    command: 'catalog:publish:plan',
    state,
    ...baseReceipt(path.join(root, '.aw', 'publish', '0.4.0.repo')),
  });
  process.exit(0);
}

if (args[0] === 'catalog' && args[1] === 'publish' && args[2] === 'apply') {
  if (!targetArgumentsValid()
    || optionValue('--expected-plan-digest') !== planDigest
    || !hasOption('--yes')) {
    fail('catalog:publish:apply', 'Publisher apply arguments do not match the authorized plan.');
  }
  const existing = readState();
  if (!existing || existing.lastPlanDigest !== planDigest) {
    fail('catalog:publish:apply', 'Publisher apply has no matching prepared or uncertain plan.');
  }
  if (scenario === 'authorized-plan-drift-or-corrupt-pending') {
    if (existing.applyCalls > 0) {
      writeState({
        ...existing,
        applyCalls: existing.applyCalls + 1,
      });
      fail('catalog:publish:apply', 'Publisher must stop after a pending plan drift or corruption failure.');
    }
    writeState({
      planCalls: existing.planCalls,
      applyCalls: 1,
      state: 'prepared',
      lastPlanDigest: planDigest,
      authorizedPlanDigest: optionValue('--expected-plan-digest'),
      pendingPlanDigest,
      reconciliation: null,
      stopReason: 'plan-drift-or-corrupt-pending',
      requiresVersionBump: true,
    });
    fail(
      'catalog:publish:apply',
      'Pending plan digest changed and its journal or isolated repository is missing or corrupt. Stop and bump Catalog version before a new plan.',
    );
  }
  const reconciliation = scenario === 'uncertain-recovery' ? 'already-remote' : 'atomic';
  writeState({
    planCalls: existing.planCalls,
    applyCalls: existing.applyCalls + 1,
    state: 'published',
    lastPlanDigest: planDigest,
    reconciliation,
  });
  emit({
    command: 'catalog:publish:apply',
    state: 'published',
    commit: expectedCommit,
    reconciliation,
    ...baseReceipt(null),
  });
  process.exit(0);
}

process.stderr.write(`Unexpected Publisher Eval fixture command: ${args.join(' ')}\n`);
process.exit(9);
