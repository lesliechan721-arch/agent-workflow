{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "review-aw-catalog",
    "participants": [
      "author-aw-catalog",
      "review-aw-plugin",
      "review-aw-workflow"
    ],
    "policy": {
      "optimization": "precision-first",
      "falseNegativeCost": "high",
      "falsePositiveCost": "critical",
      "rationale": "Catalog composition Review 必须保持只读，并与单插件和业务 workflow Review 分离。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": true
    }
  },
  "cases": [
    {
      "id": "review_catalog_composition",
      "split": "validation",
      "tags": [
        "representative",
        "catalog-review"
      ],
      "input": {
        "query": "只读评审当前 AW Catalog 的 identity、metadata、inventory、依赖图和已有 snapshot evidence。",
        "expected": {
          "loadedSkills": [
            "review-aw-catalog"
          ]
        }
      }
    },
    {
      "id": "review_single_plugin",
      "split": "validation",
      "tags": [
        "boundary",
        "plugin-review"
      ],
      "input": {
        "query": "只读评审 plugins/status-tools 的 Skill prompt 和 lifecycle 设计。",
        "expected": {
          "loadedSkills": [
            "review-aw-plugin"
          ]
        }
      },
      "audit": {
        "rationale": "单插件内部质量由 Plugin Reviewer 拥有。",
        "minimalCounterexample": "核对整个 inventory 和 manifest dependency graph 时使用 Catalog Reviewer。"
      }
    },
    {
      "id": "review_business_workflow",
      "split": "validation",
      "tags": [
        "boundary",
        "workflow-review"
      ],
      "input": {
        "query": "评审 plugin-a 到 plugin-b 的用户 handoff、失败传播和业务 owner。",
        "expected": {
          "loadedSkills": [
            "review-aw-workflow"
          ]
        }
      },
      "audit": {
        "rationale": "跨插件业务行为不是 Catalog composition。",
        "minimalCounterexample": "只核对 manifest dependency graph 时使用 Catalog Reviewer。"
      }
    },
    {
      "id": "repair_catalog",
      "split": "validation",
      "tags": [
        "boundary",
        "catalog-authoring"
      ],
      "input": {
        "query": "修复当前 Catalog inventory 和依赖环，并重新生成 snapshot。",
        "expected": {
          "loadedSkills": [
            "author-aw-catalog"
          ]
        }
      },
      "audit": {
        "rationale": "修复和重新生成是写操作。",
        "minimalCounterexample": "只识别并报告问题时使用 Catalog Reviewer。"
      }
    }
  ]
}
