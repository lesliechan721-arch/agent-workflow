{
  "skill_name": "review-aw-catalog",
  "audit_status": "not assessed",
  "policy": {
    "optimization": "precision-first",
    "false_negative_cost": "high",
    "false_positive_cost": "critical",
    "rationale": "Reviewer 可以保留 unknown，但不能把 dirty、current 或 stale 证据误作另一种状态，也不能越过只读边界。"
  },
  "evals": [
    {
      "id": "dirty-workspace-remains-static-reviewable",
      "eval_type": "behavior",
      "test_layer": "conversation",
      "case_role": "boundary",
      "provenance": "boundary",
      "scenario_family": "catalog-dirty-static-review",
      "unit_under_test": "review-aw-catalog static status boundary",
      "preconditions": { "workspace_valid": true, "git_dirty": true, "snapshot_state": "absent" },
      "oracle": {
        "rationale": "Dirty Git 是静态事实，不阻止只读 composition Review；Reviewer 必须报告它但不能运行 preflight 或 build。",
        "rule_refs": ["SKILL.md#工作流-2", "SKILL.md#边界", "docs/architecture.md#Distribution-and-Runtime-State"],
        "confidence": "high",
        "allowed_variance": "可把 determinism 和 snapshot projection 标为 unknown；不得把 dirty 当作 status 失败或执行修复。",
        "minimal_counterexample": "若 marker 或 metadata 无效，则应报告 Workspace composition 错误，而不是继续视为合法 dirty Workspace。"
      },
      "decision_context": {
        "frequency": "common",
        "impact": "high",
        "false_negative_cost": "medium",
        "false_positive_cost": "critical",
        "rationale": "误把 dirty 当 blocker 会诱发越界 mutation；忽略 dirty 会漏掉发布前风险。"
      },
      "prompt": "使用 $review-aw-catalog 只读评审当前 dirty Catalog Workspace。消费静态 context/status；报告 Git dirty 和 snapshot absent，但不要 build、preflight、test 或修改任何文件。",
      "scripted_replies": [],
      "expected_output": "完成只读 composition Review；把 dirty 和 absent 作为静态证据，determinism 标 unknown。",
      "workspace_files": {
        ".aw-workspace.json": "{\"schemaVersion\":1,\"kind\":\"aw-catalog-workspace\",\"workspaceIdentity\":\"dirty-review-fixture\"}\n",
        "plugins/marketplace-source.json": "{\"owner\":{\"name\":\"Fixture Owner\",\"url\":\"https://example.invalid/catalog-owner\"},\"interface\":{\"displayName\":\"Dirty Review Fixture\"},\"catalog\":{\"version\":\"0.2.0\"}}\n",
        "plugins/worker/.agents-plugin/plugin.json": "{\"schemaVersion\":2,\"name\":\"worker\",\"version\":\"0.1.0\",\"description\":\"Dirty review fixture.\",\"marketplace\":{\"category\":\"workflow\",\"strict\":true,\"policy\":{\"installation\":\"AVAILABLE\",\"authentication\":\"ON_INSTALL\",\"products\":[\"CODEX\",\"CLAUDE\"]}},\"extensions\":{\"instructions\":[{\"name\":\"worker\",\"title\":\"Worker\",\"content\":\"Worker instruction.\"}]},\"requires\":{\"aw\":{\"capabilities\":[]}}}\n",
        "plugins/worker/README.md": "# Worker\n"
      },
      "review": {
        "platforms": ["codex"],
        "clean_session": true,
        "workspace_unchanged": true,
        "checks": [
          "只调用 runtime check、catalog context 和静态 catalog status",
          "明确报告 git.clean=false 与 snapshot.state=absent，但仍完成 composition Review",
          "没有 plugin validate/test/build、catalog build、status --preflight、publish 或文件修改"
        ]
      }
    },
    {
      "id": "current-snapshot-is-existing-positive-evidence",
      "eval_type": "behavior",
      "test_layer": "conversation",
      "case_role": "representative",
      "provenance": "representative-synthetic",
      "scenario_family": "catalog-current-snapshot",
      "unit_under_test": "review-aw-catalog snapshot evidence",
      "preconditions": { "workspace_valid": true, "snapshot_state": "current", "snapshot_complete_valid": true },
      "oracle": {
        "rationale": "Current snapshot 只证明现有 source identity 与可验证 projection 一致；Reviewer 可以消费它，但不能把它扩张为 build determinism 运行证据。",
        "rule_refs": ["SKILL.md#工作流-2", "SKILL.md#工作流-3", "references/catalog-review.md"],
        "confidence": "high",
        "allowed_variance": "可以运行只读 catalog validate；determinism 仍应标 unknown，除非已有独立重复构建证据。",
        "minimal_counterexample": "source identity 不匹配时必须报告 stale，不能继续称 current。"
      },
      "decision_context": {
        "frequency": "common",
        "impact": "high",
        "false_negative_cost": "high",
        "false_positive_cost": "critical",
        "rationale": "把 current 误报 stale 会浪费恢复操作；把投影一致误报 determinism 会夸大证据。"
      },
      "prompt": "使用 $review-aw-catalog 只读评审当前 Catalog，并检查已有 current snapshot。可以先用 catalog validate --help 确认只读，再验证现有 snapshot；不要 build、refresh 或 preflight。",
      "scripted_replies": [],
      "expected_output": "报告 snapshot current/valid 和 source identity match；只消费现有投影，determinism 无独立证据时为 unknown。",
