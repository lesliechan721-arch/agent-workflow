{
  "schemaVersion": 1,
  "plugin": "codex-subagent-guide",
  "profiles": [
    {
      "id": "project-default",
      "scope": "project",
      "config": {},
      "triggerPreference": "default",
      "runModel": true,
      "requiredForRelease": true
    },
    {
      "id": "user-default",
      "scope": "user",
      "config": {},
      "triggerPreference": "default",
      "runModel": false,
      "requiredForRelease": true
    },
    {
      "id": "project-nondefault",
      "scope": "project",
      "config": {
        "simpleTaskModel": "eval-simple-model",
        "simpleTaskReasoningEffort": "high",
        "generalTaskModel": "eval-general-model",
        "generalTaskReasoningEffort": "xhigh",
        "complexTaskModel": "eval-complex-model",
        "complexTaskReasoningEffort": "max",
        "planningReviewTaskModel": "eval-plan-review-model",
        "planningReviewTaskReasoningEffort": "high",
        "minimumInitialWaitMinutes": 2
      },
      "triggerPreference": "default",
      "runModel": false,
      "requiredForRelease": true
    },
    {
      "id": "user-nondefault",
      "scope": "user",
      "config": {
        "simpleTaskModel": "eval-simple-model",
        "simpleTaskReasoningEffort": "high",
        "generalTaskModel": "eval-general-model",
        "generalTaskReasoningEffort": "xhigh",
        "complexTaskModel": "eval-complex-model",
        "complexTaskReasoningEffort": "max",
        "planningReviewTaskModel": "eval-plan-review-model",
        "planningReviewTaskReasoningEffort": "high",
        "minimumInitialWaitMinutes": 2
      },
      "triggerPreference": "default",
      "runModel": false,
      "requiredForRelease": true
    }
  ],
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "skill": "codex-subagent-guide",
      "cases": "./evals/trigger-cases.json",
      "fixtureModule": "./evals/trigger-fixture.mjs",
      "observeSpawnAgent": true,
      "isolation": "standard",
      "strictNegativeSplits": [],
      "profiles": ["project-default"],
      "defaultRuns": 3,
      "releaseSplits": ["validation", "sanity"],
      "requiredForRelease": true,
      "perRunTimeoutMs": 180000
    },
    {
      "id": "routing",
      "kind": "command",
      "entry": "./evals/run-routing-evals.mjs",
      "profiles": ["project-default"],
      "defaultRuns": 3,
      "releaseSplits": [],
      "requiredForRelease": true,
      "perRunTimeoutMs": 180000,
      "suiteTimeoutMs": 43200000,
      "supports": ["runs", "case", "codexBin", "timeout"]
    }
  ]
}
