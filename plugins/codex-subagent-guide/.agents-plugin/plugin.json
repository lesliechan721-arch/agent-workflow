{
  "name": "codex-subagent-guide",
  "version": "0.1.8",
  "description": "在用户、项目规则或其它技能已明确要求使用子代理后，选择任务 role，并指导自定义参数、上下文 fork、事件等待和清理。",
  "compatibility": {
    "aw": {
      "minVersion": "1.0.0-beta.31"
    }
  },
  "marketplace": {
    "category": "workflow",
    "tags": ["codex", "subagent", "reasoning", "wait"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": ["CODEX"]
    }
  },
  "interface": {
    "displayName": "Codex Subagent Guide",
    "shortDescription": "子代理任务分类、参数选择、上下文继承、等待与清理原则",
    "capabilities": ["Skills", "Agents"]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/render-artifacts.test.mjs",
        "./scripts/trigger-evals.test.mjs",
        "./scripts/routing-evals.test.mjs"
      ]
    }
  },
  "config": {
    "schema": {
      "simpleTaskModel": {
        "type": "string",
        "title": "简单任务模型",
        "default": "gpt-5.6-luna",
        "description": "简单任务 agent type 使用的模型，适用于低歧义、边界清晰、成功标准明确的探索、检索、结果验证、简单代码及其他简单任务。"
      },
      "simpleTaskReasoningEffort": {
        "type": "enum",
        "title": "简单任务推理强度",
        "values": ["low", "medium", "high", "xhigh", "max"],
        "default": "max",
        "description": "简单任务 agent type 使用的 model_reasoning_effort。"
      },
      "generalTaskModel": {
        "type": "string",
        "title": "通用任务模型",
        "default": "gpt-5.6-sol",
        "description": "通用任务 agent type 使用的模型，适用于超出简单任务范围的常规实现和其它通用交付。"
      },
      "generalTaskReasoningEffort": {
        "type": "enum",
        "title": "通用任务推理强度",
        "values": ["low", "medium", "high", "xhigh", "max"],
        "default": "medium",
        "description": "通用任务 agent type 使用的 model_reasoning_effort。"
      },
      "complexTaskModel": {
        "type": "string",
        "title": "复杂任务模型",
        "default": "gpt-5.6-sol",
        "description": "复杂任务 agent type 使用的模型，适用于复杂实现、未知根因和调试。"
      },
      "complexTaskReasoningEffort": {
        "type": "enum",
        "title": "复杂任务推理强度",
        "values": ["low", "medium", "high", "xhigh", "max"],
        "default": "high",
        "description": "复杂任务 agent type 使用的 model_reasoning_effort。"
      },
      "planningReviewTaskModel": {
        "type": "string",
        "title": "计划与审核任务模型",
        "default": "gpt-5.6-sol",
        "description": "计划与审核 agent type 使用的模型，适用于审核、架构设计和实施计划。"
      },
      "planningReviewTaskReasoningEffort": {
        "type": "enum",
        "title": "计划与审核任务推理强度",
        "values": ["low", "medium", "high", "xhigh", "max"],
        "default": "xhigh",
        "description": "计划与审核 agent type 使用的 model_reasoning_effort。"
      },
      "minimumInitialWaitMinutes": {
        "type": "number",
        "title": "首次等待最小窗口（分钟）",
        "default": 10,
        "min": 1,
        "max": 60,
        "description": "用户或任务专用技能没有指定单次等待时，首次响应式 wait_agent 窗口的最短时间。"
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "codex-subagent-guide-skill",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.skill",
        "projectManagedKind": "skill",
        "states": ["present"],
        "refreshKeys": ["minimumInitialWaitMinutes"],
        "skillKey": "codex-subagent-guide",
        "sourceDirs": ["./templates/codex-subagent-guide"]
      },
      {
        "id": "codex-subagent-simple-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["simpleTaskModel", "simpleTaskReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-subagent-simple"
      },
      {
        "id": "codex-subagent-general-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["generalTaskModel", "generalTaskReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-subagent-general"
      },
      {
        "id": "codex-subagent-complex-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["complexTaskModel", "complexTaskReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-subagent-complex"
      },
      {
        "id": "codex-subagent-plan-review-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["planningReviewTaskModel", "planningReviewTaskReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-subagent-plan-review"
      }
    ]
  }
}
