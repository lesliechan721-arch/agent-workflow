{
  "schemaVersion": 4,
  "name": "git-toolkit",
  "version": "0.1.0-beta.8",
  "description": "提供本地 Git 提交，以及覆盖 merge、rebase 与 cherry-pick 的冲突解决与语义协调工作流。",
  "marketplace": {
    "category": "workflow",
    "tags": [
      "git",
      "commit",
      "merge",
      "rebase",
      "cherry-pick",
      "conflicts"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "skills": "./skills",
  "platforms": [
    "codex",
    "claude",
    "antigravity",
    "cursor",
    "opencode",
    "pi",
    "copilot",
    "grok",
    "generic"
  ],
  "interface": {
    "displayName": "Git Toolkit",
    "shortDescription": "精确创建本地提交，或协调 Git merge、rebase 与 cherry-pick 的冲突与语义交互",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {},
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-manifest.v4",
        "aw.plugin-skills.v1",
        "aw.portable-skills.v1"
      ]
    }
  }
}
