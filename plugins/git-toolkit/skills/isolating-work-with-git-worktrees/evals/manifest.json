{
  "version": 1,
  "defaults": {
    "profile": "project-default"
  },
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "git-toolkit": {}
      }
    },
    "user-default": {
      "scope": "user",
      "plugins": {
        "git-toolkit": {}
      }
    }
  },
  "suites": [
    {
      "id": "router",
      "kind": "trigger",
      "cases": "trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation",
        "sanity"
      ]
    },
    {
      "id": "router-diagnostic",
      "kind": "trigger",
      "cases": "trigger-diagnostic-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": false
    },
    {
      "id": "behavior",
      "kind": "custom-process",
      "cases": "evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 300000,
      "requiredForRelease": true,
      "provider": {
        "type": "custom-process",
        "command": [
          "node",
          "run-worktree-evals.mjs"
        ]
      }
    }
  ]
}
