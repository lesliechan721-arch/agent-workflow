{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "isolating-work-with-git-worktrees",
    "participants": [
      "reconciling-git-merges",
      "git-commit"
    ],
    "defaultGrader": "mechanical",
    "policy": {
      "optimization": "recall-first",
      "falseNegativeCost": "high",
      "falsePositiveCost": "low",
      "rationale": "该 suite 只记录完整仓库隔离请求的额外加载成本。若加载后仍正确选择独立 clone，则归为 expected-tradeoff，不得降低核心 linked-worktree 请求的召回。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [],
      "forbidMultipleSkillLoads": true,
      "fixture": "trigger-fixture.mjs"
    }
  },
  "cases": [
    {
      "id": "source_15",
      "split": "sanity",
      "tags": [
        "diagnostic"
      ],
      "input": {
        "query": "这个实验会重写 shared refs、删除 tags 并运行 aggressive gc；给我一个完全独立的仓库副本。",
        "expected": {
          "loadedSkills": []
        }
      }
    },
    {
      "id": "sanity_full_clone",
      "split": "sanity",
      "tags": [
        "diagnostic"
      ],
      "input": {
        "query": "我需要独立的 refs、对象库和 hooks 来做破坏性实验，请准备一个完整 clone。",
        "expected": {
          "loadedSkills": []
        }
      }
    }
  ]
}
