{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "git-commit",
    "policy": {
      "optimization": "critical",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "git-commit 仅由用户显式调用；自然语言提交及相邻请求均不得隐式加载它。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "fixture": "trigger-fixture.mjs"
    }
  },
  "cases": [
    {
      "id": "casual_current_changes",
      "split": "validation",
      "tags": [],
      "input": {
        "query": "支付超时的问题已经修好了，帮我把当前改动提交一下。",
        "expectedLoad": false
      }
    },
    {
      "id": "staged_only",
      "split": "validation",
      "tags": [],
      "input": {
        "query": "我已经 git add 过了，请只把 staged changes 做成一个 commit。",
        "expectedLoad": false
      }
    },
    {
      "id": "commit_and_push",
      "split": "validation",
      "tags": [],
      "input": {
        "query": "核对一下范围，然后把这些改动提交并推送到当前分支。",
        "expectedLoad": false
      }
    },
    {
      "id": "draft_message_only",
      "split": "validation",
      "tags": [
        "boundary"
      ],
      "input": {
        "query": "根据当前 diff 帮我拟一个 commit message 就好，不要真的提交。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "仅拟写 message，且没有显式调用；手动技能不应隐式加载。",
        "minimalCounterexample": "将目标改为实际提交仍不应隐式加载；显式调用的提交路径由行为用例验证。"
      }
    }
  ]
}
