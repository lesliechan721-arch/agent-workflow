{
  "schemaVersion": 3,
  "name": "aw-development-toolkit",
  "version": "0.1.0-beta.8",
  "description": "处理 AW 插件及 Skill 的来源、开发、验证与物化，维护 Catalog，并通过手动入口发布。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.catalog-authoring.v1",
        "aw.catalog-dev-source.v1",
        "aw.catalog-publication.v1",
        "aw.plugin-authoring.v1",
        "aw.plugin-manifest.v3",
        "aw.plugin-skills.v1",
        "aw.portable-skills.v1",
        "aw.review-inspection.v2",
        "aw.review-preparation.v1",
        "aw.self-check.v1",
        "aw.skill-validation.v1"
      ]
    }
  },
  "dependencies": [
    "agent-content-toolkit",
    "agent-skill-toolkit"
  ],
  "skills": "./skills",
  "interface": {
    "displayName": "AW Development Toolkit",
    "shortDescription": "处理 AW 插件与 Skill，提供来源和物化方法",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {}
}
