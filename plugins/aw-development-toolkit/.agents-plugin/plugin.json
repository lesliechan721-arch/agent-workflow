{
  "schemaVersion": 3,
  "name": "aw-development-toolkit",
  "version": "0.1.0-beta.3",
  "description": "创建和维护 AW Catalog/Plugin，按对象分支只读评审 AW 项目，并通过 manual-only 入口发布 Catalog。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.catalog-authoring.v1",
        "aw.catalog-dev-source.v1",
        "aw.catalog-publication.v1",
        "aw.plugin-authoring.v1",
        "aw.plugin-build-config.v1",
        "aw.plugin-manifest.v3",
        "aw.plugin-skills.v1",
        "aw.review-inspection.v2",
        "aw.review-preparation.v1",
        "aw.review-publication.v1",
        "aw.runtime-imports.v1",
        "aw.self-check.v1",
        "aw.skill-validation.v1"
      ]
    }
  },
  "dependencies": [
    "agent-content-toolkit",
    "agent-skill-toolkit"
  ],
  "skills": "./skills",
  "interface": {
    "displayName": "AW Development Toolkit",
    "shortDescription": "开发、评审和显式发布 AW Catalog 与 Plugin",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {}
}
