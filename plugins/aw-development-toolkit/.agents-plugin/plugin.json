{
  "schemaVersion": 3,
  "name": "aw-development-toolkit",
  "version": "0.1.0",
  "description": "创建和维护 AW Catalog/Plugin，按对象分支只读评审 AW 项目，并通过 manual-only 入口发布 Catalog。",
  "dependencies": [
    "agent-content-toolkit",
    "agent-skill-toolkit"
  ],
  "skills": "./skills",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "interface": {
    "displayName": "AW Development Toolkit",
    "shortDescription": "开发、评审和显式发布 AW Catalog 与 Plugin",
    "capabilities": [
      "Skills"
    ]
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.self-check.v1",
        "aw.plugin-authoring.v1",
        "aw.catalog-authoring.v1",
        "aw.catalog-dev-source.v1",
        "aw.catalog-publication.v1",
        "aw.review-preparation.v1",
        "aw.review-inspection.v2",
        "aw.review-publication.v1",
        "aw.skill-validation.v1"
      ]
    }
  },
  "buildConfig": {
    "runtimeExports": [
      {
        "name": "review-publication-reference",
        "source": "./references/report-publication.md",
        "requires": {
          "aw": {
            "capabilities": [
              "aw.review-publication.v1"
            ]
          }
        }
      }
    ],
    "skillRuntimeFiles": [
      {
        "skill": "review-aw",
        "target": "references/report-publication.md",
        "source": "./references/report-publication.md"
      },
      {
        "skill": "review-aw",
        "target": "scripts/check-aw-release.mjs",
        "source": "./scripts/check-aw-release.mjs"
      }
    ]
  },
  "scripts": {
    "tests": {
      "node": [
        "./scripts/contract.test.mjs",
        "./scripts/check-aw-release.test.mjs"
      ]
    }
  }
}
