{
  "schemaVersion": 4,
  "name": "aw-development-toolkit",
  "version": "0.1.0",
  "description": "处理 AW 插件及 Skill 的来源、开发、验证与物化，维护 Catalog，并通过手动入口发布。",
  "platforms": [
    "codex",
    "claude",
    "antigravity",
    "cursor",
    "opencode",
    "pi",
    "gemini",
    "copilot",
    "grok",
    "generic"
  ],
  "dependencies": [
    "agent-content-toolkit",
    "agent-skill-toolkit"
  ],
  "skills": "./skills",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "interface": {
    "displayName": "AW Development Toolkit",
    "shortDescription": "处理 AW 插件与 Skill，提供来源和物化方法",
    "capabilities": [
      "Skills"
    ]
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.self-check.v2",
        "aw.plugin-authoring.v2",
        "aw.portable-skills.v1",
        "aw.catalog-authoring.v2",
        "aw.catalog-dev-source.v2",
        "aw.catalog-publication.v2",
        "aw.review-preparation.v2",
        "aw.review-inspection.v3",
        "aw.skill-validation.v2",
        "aw.managed-commands.v1",
        "aw.claude.sandbox-exclusions.v1",
        "aw.cli-output.v1"
      ]
    }
  },
  "scripts": {
    "tests": {
      "node": [
        "./scripts/contract.test.mjs",
        "./scripts/method-fixtures.test.mjs"
      ]
    }
  }
}
