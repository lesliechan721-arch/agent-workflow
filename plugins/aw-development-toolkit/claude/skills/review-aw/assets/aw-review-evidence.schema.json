{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.invalid/aw-review-evidence.v1.schema.json",
  "title": "AWReviewEvidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "subjects"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "plugin",
            "catalog"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "profile",
          "digest",
          "assessment",
          "evidenceRefs",
          "blockingFindings"
        ],
        "properties": {
          "kind": {
            "enum": [
              "plugin",
              "catalog",
              "skill",
              "workflow",
              "portfolio"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "assessment": {
            "enum": [
              "pass",
              "needs-fixes",
              "not-assessed"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          },
          "blockingFindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "severity",
                "owner"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "enum": [
                    "critical",
                    "major"
                  ]
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "assessment": {
                  "const": "pass"
                }
              }
            },
            "then": {
              "properties": {
                "evidenceRefs": {
                  "minItems": 1
                },
                "blockingFindings": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "assessment": {
                  "const": "needs-fixes"
                }
              }
            },
            "then": {
              "properties": {
                "evidenceRefs": {
                  "minItems": 1
                },
                "blockingFindings": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "$comment": "Semantic authenticity is not proved by schema. Consumer rederives required subjects and current identities. Same-key duplicates/conflicts checked by consumer, not array uniqueItems."
}
