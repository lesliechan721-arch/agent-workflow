{
  "schemaVersion": 2,
  "name": "ask-me",
  "version": "0.1.0-beta.1",
  "description": "通过独立决策访谈、可体验原型或可选 Shape 工作流形成准确共享理解。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "skills": "./skills",
  "interface": {
    "displayName": "Ask Me",
    "shortDescription": "通过问答、原型或完整 Shape 塑造重要决定",
    "capabilities": [
      "Skills"
    ]
  },
  "buildConfig": {
    "templates": {
      "vars": {
        "questionTool": {
          "claude": "`AskUserQuestion`",
          "codex": "`request_user_input`"
        }
      },
      "include": [
        "skills/**/*.md"
      ]
    }
  },
  "scripts": {
    "timeoutMs": 30000
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-build-config.v1",
        "aw.plugin-manifest.v2",
        "aw.plugin-skills.v1"
      ]
    }
  }
}
