{
  "schemaVersion": 3,
  "name": "ask-me",
  "version": "0.1.0-beta.11",
  "description": "通过独立决策访谈、可体验原型或可选 Shape 工作流形成准确共享理解。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "skills": "./skills",
  "distributions": {
    "agentSkills": {
      "skills": "./agent-skills/skills"
    }
  },
  "interface": {
    "displayName": "Ask Me",
    "shortDescription": "通过问答、原型或完整 Shape 塑造重要决定",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {},
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-manifest.v3",
        "aw.plugin-skills.v1",
        "aw.portable-skills.v1"
      ]
    }
  }
}
