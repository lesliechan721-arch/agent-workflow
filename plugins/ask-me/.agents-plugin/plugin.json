{
  "name": "ask-me",
  "version": "0.3.1",
  "description": "在实施前澄清关键歧义，并通过局部澄清、逐轮决策访谈或可体验原型形成共享理解。",
  "compatibility": {
    "aw": {
      "minVersion": "0.0.0"
    }
  },
  "skills": "./skills",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "interface": {
    "displayName": "Ask Me",
    "shortDescription": "澄清关键歧义、逐轮推演重要决定，或用可体验原型帮助用户作出决定",
    "capabilities": [
      "Skills",
      "Instructions"
    ]
  },
  "buildConfig": {
    "templates": {
      "include": [
        "skills/**/*.md"
      ],
      "vars": {
        "questionTool": {
          "claude": "`AskUserQuestion`",
          "codex": "`request_user_input`"
        }
      }
    }
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/contract.test.mjs",
        "./scripts/render-artifacts.test.mjs"
      ]
    }
  },
  "config": {
    "schema": {
      "qualityGateEnabled": {
        "type": "boolean",
        "title": "实施前需求检查",
        "description": "启用后，在非平凡实现前检查是否仍有会影响结果、范围或验收的关键歧义。",
        "default": true
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "ask-me-quality-gate-codex",
        "platform": "codex",
        "scopes": [
          "user",
          "project"
        ],
        "target": "codex.developerInstructionsBlock",
        "projectManagedKind": "instruction",
        "states": [
          "present",
          "disabled"
        ],
        "refreshKeys": [
          "qualityGateEnabled"
        ],
        "requiresCodexProjectConfig": true
      },
      {
        "id": "ask-me-quality-gate-claude",
        "platform": "claude",
        "scopes": [
          "user",
          "project"
        ],
        "target": "claude.skill",
        "states": [
          "present",
          "disabled"
        ],
        "refreshKeys": [
          "qualityGateEnabled"
        ],
        "skillKey": "ask-me-quality-gate"
      }
    ]
  }
}
