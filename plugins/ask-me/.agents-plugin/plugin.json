{
  "name": "ask-me",
  "version": "0.4.1",
  "description": "通过逐轮决策访谈或可体验原型形成共享理解。",
  "compatibility": {
    "aw": {
      "minVersion": "0.0.0"
    }
  },
  "skills": "./skills",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "interface": {
    "displayName": "Ask Me",
    "shortDescription": "逐轮推演重要决定，或用可体验原型帮助用户作出决定",
    "capabilities": [
      "Skills"
    ]
  },
  "buildConfig": {
    "templates": {
      "include": [
        "skills/**/*.md"
      ],
      "vars": {
        "questionTool": {
          "claude": "`AskUserQuestion`",
          "codex": "`request_user_input`"
        }
      }
    }
  },
  "scripts": {
    "tests": {
      "node": [
        "./scripts/contract.test.mjs"
      ]
    }
  }
}
