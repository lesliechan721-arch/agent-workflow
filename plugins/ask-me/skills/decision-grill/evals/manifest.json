{
  "version": 1,
  "defaults": {},
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "ask-me": {}
      }
    },
    "user-default": {
      "scope": "user",
      "plugins": {
        "ask-me": {}
      }
    }
  },
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "cases": "decision-grill-trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation",
        "sanity"
      ]
    },
    {
      "id": "router",
      "kind": "trigger",
      "cases": "ask-me-routing-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 10,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation",
        "sanity"
      ]
    },
    {
      "id": "behavior",
      "kind": "conversation",
      "cases": "decision-grill-release-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "decision-frame",
      "kind": "conversation",
      "cases": "decision-frame-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "decision-comprehension",
      "kind": "conversation",
      "cases": "decision-comprehension-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    }
  ]
}
