      "profiles": ["project-default"],
      "defaultRuns": 3,
      "releaseSplits": ["validation"],
      "requiredForRelease": true,
      "perRunTimeoutMs": 180000
    },
    {
      "id": "behavior",
      "kind": "conversation",
      "skills": ["requirements-clarifier", "decision-grill"],
      "cases": "./requirements-clarifier-evals.json",
      "isolation": "strict",
      "profiles": ["project-default"],
      "defaultRuns": 1,
      "releaseSplits": [],
      "requiredForRelease": true,
      "perRunTimeoutMs": 300000
    }
  ]
}
