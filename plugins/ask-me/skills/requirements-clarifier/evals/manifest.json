{
  "schemaVersion": 2,
  "plugin": "ask-me",
  "skill": "requirements-clarifier",
  "profiles": [
    {
      "id": "project-default",
      "scope": "project",
      "plugins": [{ "name": "ask-me", "config": {} }],
      "runModel": true,
      "requiredForRelease": true
    },
    {
      "id": "user-default",
      "scope": "user",
      "plugins": [{ "name": "ask-me", "config": {} }],
      "runModel": false,
      "requiredForRelease": true
    }
  ],
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "skills": ["requirements-clarifier"],
      "cases": "./requirements-clarifier-trigger-cases.json",
      "fixtureModule": "./trigger-fixture.mjs",
