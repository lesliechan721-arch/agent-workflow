{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "decision-prototype",
    "defaultGrader": "mechanical",
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "漏触发会让讨论无法获得必要的可体验证据，误触发会制造无价值原型并增加写入成本。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "prototype_clickable_ui",
      "split": "validation",
      "tags": [
        "representative",
        "experience-required"
      ],
      "input": {
        "query": "这个审批页面怎么排版我说不清，做一个可点击原型让我试。",
        "expectedLoad": true
      }
    },
    {
      "id": "prototype_visual_options",
      "split": "validation",
      "tags": [
        "representative",
        "experience-required"
      ],
      "input": {
        "query": "先给我两张候选界面图，我看过后再决定交互。",
        "expectedLoad": true
      }
    },
    {
      "id": "prototype_technical_spike",
      "split": "validation",
      "tags": [
        "representative",
        "evidence-required"
      ],
      "input": {
        "query": "用最小技术 spike 验证浏览器端加密方案是否值得选，不要直接做生产实现。",
        "expectedLoad": true
      }
    },
    {
      "id": "prototype_not_spec",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-spec"
      ],
      "input": {
        "query": "已经决定采用方案 B，把它写成开发 Spec。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "决定已经形成，当前交付是记录规格，不需要原型。",
        "minimalCounterexample": "改为需要先看到方案 B 的可操作样例再决定。",
        "errorCost": "high",
        "allowedVariance": "可以加载规格能力，但不应加载 decision-prototype。"
      }
    },
    {
      "id": "prototype_not_implementation",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-implementation"
      ],
      "input": {
        "query": "按现有 Spec 实现审批页面。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "当前任务是正式实现，不是用原型作决定。",
        "minimalCounterexample": "改为正式实现前需要可点击候选页面确认布局。",
        "errorCost": "high",
        "allowedVariance": "可以使用实现能力，但不应加载 decision-prototype。"
      }
    },
    {
      "id": "prototype_not_explanation",
      "split": "validation",
      "tags": [
        "boundary",
        "near-miss-direct-answer"
      ],
      "input": {
        "query": "解释这三个 UI 方案的优缺点，不需要制作原型。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "用户明确只要一次性分析，并排除原型。",
        "minimalCounterexample": "改为需要实际看到或操作三个方案后再选择。",
        "errorCost": "high",
        "allowedVariance": "可以直接回答，但不应加载 decision-prototype。"
      }
    }
  ]
}
