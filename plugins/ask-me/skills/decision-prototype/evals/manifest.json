{
  "version": 1,
  "defaults": {},
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "ask-me": {}
      }
    },
    "user-default": {
      "scope": "user",
      "plugins": {
        "ask-me": {}
      }
    }
  },
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "cases": "trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "router",
      "kind": "trigger",
      "cases": "ask-me-prototype-routing-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 10,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation",
        "sanity"
      ]
    },
    {
      "id": "behavior",
      "kind": "conversation",
      "cases": "decision-prototype-release-evals.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "feedback",
      "kind": "conversation",
      "cases": "prototype-feedback-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "review-lifecycle",
      "kind": "conversation",
      "cases": "prototype-review-lifecycle-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    }
  ]
}
