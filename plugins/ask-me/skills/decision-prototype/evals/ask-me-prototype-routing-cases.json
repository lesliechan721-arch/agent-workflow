{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "decision-prototype",
    "participants": [
      "decision-grill"
    ],
    "defaultGrader": "mechanical",
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "两个相邻 Skill 的错误路由会让用户被重复提问、过早制作原型或缺少必要体验证据。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [],
      "forbidMultipleSkillLoads": true
    }
  },
  "cases": [
    {
      "id": "route_local_gap",
      "split": "validation",
      "tags": [
        "boundary",
        "ask-me-capability-routing"
      ],
      "input": {
        "query": "实现订单导出，但导出全部还是当前筛选结果还没定。",
        "expected": {
          "loadedSkills": []
        },
        "useProjectRules": true
      },
      "audit": {
        "rationale": "这是具体实现中的局部材料歧义，不需要原型或完整访谈；局部实施澄清能力已迁出 Ask-Me。",
        "minimalCounterexample": "若必须操作候选导出界面后才能决定，则应加载 decision-prototype。",
        "errorCost": "high",
        "allowedVariance": "可以先调查事实，但不应加载 Ask-Me 的任一 participant Skill。"
      }
    },
    {
      "id": "route_decision_tree",
      "split": "validation",
      "tags": [
        "boundary",
        "ask-me-capability-routing"
      ],
      "input": {
        "query": "围绕新的权限模型逐轮提问我，直到目标、取舍和失败路径都清楚。",
        "expected": {
          "loadedSkills": [
            "decision-grill"
          ]
        },
        "useProjectRules": true
      },
      "audit": {
        "rationale": "用户明确要求多轮决策访谈。",
        "minimalCounterexample": "若只剩一个必须体验候选方案的问题，则应加载 decision-prototype。",
        "errorCost": "high",
        "allowedVariance": "问题顺序可不同，但只应加载 decision-grill。"
      }
    },
    {
      "id": "route_clickable_prototype",
      "split": "validation",
      "tags": [
        "representative",
        "ask-me-capability-routing"
      ],
      "input": {
        "query": "做一个可点击审批流程让我操作，再根据反馈确定最终交互。",
        "expected": {
          "loadedSkills": [
            "decision-prototype"
          ]
        },
        "useProjectRules": true
      }
    },
    {
      "id": "route_technical_spike",
      "split": "validation",
      "tags": [
        "representative",
        "ask-me-capability-routing"
      ],
      "input": {
        "query": "先用最小 spike 测一下这条加密路线是否可行，再决定是否采用。",
        "expected": {
          "loadedSkills": [
            "decision-prototype"
          ]
        },
        "useProjectRules": true
      }
    },
    {
      "id": "route_direct_comparison",
      "split": "sanity",
      "tags": [
        "boundary",
        "ask-me-capability-routing"
      ],
      "input": {
        "query": "直接比较这三个 UI 方案并推荐一个，不要做原型，也不要逐轮问我。",
        "expected": {
          "loadedSkills": []
        },
        "useProjectRules": true
      },
      "audit": {
        "rationale": "这是一次性比较，用户明确排除访谈和原型。",
        "minimalCounterexample": "若用户需要看到或操作候选方案再决定，则应加载 decision-prototype。",
        "errorCost": "high",
        "allowedVariance": "可以直接回答，但不应加载任一 participant Skill。"
      }
    },
    {
      "id": "route_prototype_reopens_tree",
      "split": "sanity",
      "tags": [
        "boundary",
        "prototype-handoff"
      ],
      "input": {
        "query": "刚才原型暴露了权限、回退和审计三个相互依赖的决定，请逐轮和我重新推演。",
        "expected": {
          "loadedSkills": [
            "decision-grill"
          ]
        },
        "useProjectRules": true
      },
      "audit": {
        "rationale": "原型反馈已经转化为多项相互依赖决定，应回到决策访谈。",
        "minimalCounterexample": "若只需比较一个具体界面选项，则应继续使用 decision-prototype。",
        "errorCost": "high",
        "allowedVariance": "可以引用原型证据，但只应加载 decision-grill。"
      }
    }
  ]
}
