{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrototypeReviewConfig",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "question",
    "mode",
    "options",
    "stopCondition"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "choice",
        "guided",
        "annotation",
        "controlled-edit",
        "high-fidelity"
      ]
    },
    "decisionFrame": {
      "type": "object",
      "additionalProperties": true
    },
    "stopCondition": {
      "type": "string",
      "minLength": 1
    },
    "allowOther": {
      "type": "boolean",
      "default": true
    },
    "allowAnnotations": {
      "type": "boolean",
      "default": true
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "artifact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "html",
              "image",
              "text",
              "metrics"
            ]
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "guidedQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "editableTokens": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1
      }
    }
  },
  "additionalProperties": false
}
