{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrototypeReviewConfig",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "question",
    "decisionContext",
    "options",
    "stopCondition"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "question": { "type": "string", "minLength": 1 },
    "decisionContext": {
      "type": "object",
      "required": ["goal", "priorities", "constraints"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "priorities": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "selectionMode": {
      "enum": ["single", "multiple", "none"],
      "default": "single"
    },
    "htmlExecution": {
      "enum": ["static", "sandboxed"],
      "default": "static"
    },
    "stopCondition": { "type": "string", "minLength": 1 },
    "allowOther": { "type": "boolean", "default": true },
    "allowAnnotations": { "type": "boolean", "default": false },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "artifact"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["html", "image", "text", "metrics"] },
          "artifact": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "guidedQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "selectionMode": {
            "enum": ["single", "multiple", "freeform"],
            "default": "single"
          },
          "choices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "editableCssVariables": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": false
}
