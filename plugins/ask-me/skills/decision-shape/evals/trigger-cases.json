{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "decision-shape",
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "漏触发会让复杂决策缺少统一塑形；误触发会给单一问题增加不必要流程。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation",
        "sanity"
      ],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "shape_complex_product_direction",
      "split": "validation",
      "tags": [
        "representative",
        "complex-shape"
      ],
      "input": {
        "query": "把这个新的团队协作产品方向通过问答和必要原型完整塑形，最后形成共享理解。",
        "expectedLoad": true
      }
    },
    {
      "id": "shape_architecture_with_evidence",
      "split": "validation",
      "tags": [
        "representative",
        "complex-shape"
      ],
      "input": {
        "query": "帮我把新的运行时架构想清楚。有些问题需要讨论，有些需要做小实验。",
        "expectedLoad": true
      }
    },
    {
      "id": "single_grill_near_miss",
      "split": "sanity",
      "tags": [
        "boundary",
        "leaf-near-miss"
      ],
      "input": {
        "query": "围绕权限模型逐轮问我，直到失败路径和取舍都清楚。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "这是明确的单一访谈任务，应由 decision-grill 独立完成。",
        "minimalCounterexample": "如果用户要求同时塑形多个相互依赖的决定，并允许在问答与 Prototype 之间选择，则应加载 decision-shape。",
        "errorCost": "high",
        "allowedVariance": "不得因为问题复杂就自动升级宏 Shape。"
      }
    },
    {
      "id": "single_prototype_near_miss",
      "split": "sanity",
      "tags": [
        "boundary",
        "leaf-near-miss"
      ],
      "input": {
        "query": "做两个审批页面方案让我点一下选。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "这是一个明确 Prototype 问题。",
        "minimalCounterexample": "如果页面候选只是多个相互依赖决定中的一个证据分支，并要求形成完整共享理解，则应加载 decision-shape。",
        "errorCost": "high",
        "allowedVariance": "应由 decision-prototype 处理。"
      }
    },
    {
      "id": "one_shot_analysis_near_miss",
      "split": "validation",
      "tags": [
        "boundary",
        "one-shot"
      ],
      "input": {
        "query": "一次性比较这三个架构方案并给出建议。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "一次性比较不是多轮 Shape。",
        "minimalCounterexample": "如果用户要求逐轮校准多个决定、按需制作 Prototype 并维护当前 Shape，则应加载 decision-shape。",
        "errorCost": "high",
        "allowedVariance": "直接回答或使用其它评估能力。"
      }
    }
  ]
}
