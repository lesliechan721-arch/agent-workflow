{
  "version": 1,
  "defaults": {},
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "ask-me": {}
      }
    },
    "user-default": {
      "scope": "user",
      "plugins": {
        "ask-me": {}
      }
    }
  },
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "cases": "trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation",
        "sanity"
      ]
    },
    {
      "id": "router",
      "kind": "trigger",
      "cases": "routing-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 5,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation",
        "sanity"
      ]
    },
    {
      "id": "behavior",
      "kind": "conversation",
      "cases": "behavior-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "shared-frame",
      "kind": "conversation",
      "cases": "shared-frame-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "prototype-evidence",
      "kind": "conversation",
      "cases": "prototype-evidence-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": false,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "independent-delivery-trigger",
      "kind": "trigger",
      "cases": "independent-delivery-trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 180000,
      "requiredForRelease": false
    },
    {
      "id": "independent-delivery-behavior",
      "kind": "conversation",
      "cases": "independent-delivery-behavior-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 300000,
      "requiredForRelease": false
    }
  ]
}
