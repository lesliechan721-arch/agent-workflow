{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "decision-shape",
    "participants": [
      "decision-grill",
      "decision-prototype"
    ],
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "漏选叶子会阻止当前材料问题取得答案；误选或同时加载叶子会增加无关流程并破坏叶子独立性。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "macro_routes_discussion_to_grill",
      "split": "validation",
      "tags": [
        "representative",
        "shape-routing"
      ],
      "input": {
        "query": "用 decision-shape 继续当前产品方向。现在最上游问题是安全和兼容的取舍，可以通过讨论决定。",
        "expected": {
          "loadedSkills": [
            "decision-shape",
            "decision-grill"
          ]
        }
      }
    },
    {
      "id": "macro_routes_evidence_to_prototype",
      "split": "validation",
      "tags": [
        "representative",
        "shape-routing"
      ],
      "input": {
        "query": "用 decision-shape 继续。现在的问题是审批页信息层级，必须让用户实际操作候选方案才能决定。",
        "expected": {
          "loadedSkills": [
            "decision-shape",
            "decision-prototype"
          ]
        }
      }
    },
    {
      "id": "direct_grill_bypasses_macro",
      "split": "sanity",
      "tags": [
        "boundary",
        "direct-leaf"
      ],
      "input": {
        "query": "使用 decision-grill 围绕当前迁移计划逐轮访谈我。",
        "expected": {
          "loadedSkills": [
            "decision-grill"
          ]
        }
      },
      "audit": {
        "rationale": "直接叶子请求不加载宏。",
        "minimalCounterexample": "如果用户要求完成跨多个问题的整体塑形，并由宏能力决定何时访谈或制作 Prototype，则应先加载 decision-shape。",
        "errorCost": "high",
        "allowedVariance": "只加载 decision-grill。"
      }
    },
    {
      "id": "direct_prototype_bypasses_macro",
      "split": "sanity",
      "tags": [
        "boundary",
        "direct-leaf"
      ],
      "input": {
        "query": "使用 decision-prototype 做一个 API consumer 示例让我决定接口。",
        "expected": {
          "loadedSkills": [
            "decision-prototype"
          ]
        }
      },
      "audit": {
        "rationale": "直接叶子请求不加载宏。",
        "minimalCounterexample": "如果 Prototype 只是整体决策塑形中的一个证据分支，并且还要归一其它开放决定，则应先加载 decision-shape。",
        "errorCost": "high",
        "allowedVariance": "只加载 decision-prototype。"
      }
    },
    {
      "id": "semantic_macro_routes_discussion",
      "split": "validation",
      "tags": [
        "representative",
        "semantic-shape-routing"
      ],
      "input": {
        "query": "帮我把明年的产品定价方向完整塑形。当前最上游的是增长和简单性的取舍，这一题可以通过逐轮讨论决定。",
        "expected": {
          "loadedSkills": [
            "decision-shape",
            "decision-grill"
          ]
        }
      }
    },
    {
      "id": "semantic_macro_routes_evidence",
      "split": "validation",
      "tags": [
        "representative",
        "semantic-shape-routing"
      ],
      "input": {
        "query": "帮我把新的审批体验完整想清楚。当前最上游的是信息层级，必须让我实际操作两个候选页面后才能决定。",
        "expected": {
          "loadedSkills": [
            "decision-shape",
            "decision-prototype"
          ]
        }
      }
    },
    {
      "id": "semantic_single_interview_stays_leaf",
      "split": "sanity",
      "tags": [
        "boundary",
        "semantic-leaf-routing"
      ],
      "input": {
        "query": "围绕权限模型逐轮问我，把失败路径和核心取舍收住，并交付这一个决定的记录。",
        "expected": {
          "loadedSkills": [
            "decision-grill"
          ]
        }
      },
      "audit": {
        "rationale": "这是一个有界访谈结果，叶子可以独立完成，不需要宏 Shape。",
        "minimalCounterexample": "若还要在多个相互依赖决定和 Prototype 证据之间切换并维护整体共享理解，则应加载 decision-shape。",
        "errorCost": "high",
        "allowedVariance": "只加载 decision-grill。"
      }
    },
    {
      "id": "semantic_single_prototype_stays_leaf",
      "split": "sanity",
      "tags": [
        "boundary",
        "semantic-leaf-routing"
      ],
      "input": {
        "query": "做两个审批页面候选让我实际点一下，收集反馈后确定这一处信息层级。",
        "expected": {
          "loadedSkills": [
            "decision-prototype"
          ]
        }
      },
      "audit": {
        "rationale": "这是一个单一 Prototype 问题，叶子可以独立完成，不需要宏 Shape。",
        "minimalCounterexample": "若这一原型只是多个相互依赖决定中的一个证据分支，并要求维护整体共享理解，则应加载 decision-shape。",
        "errorCost": "high",
        "allowedVariance": "只加载 decision-prototype。"
      }
    },
    {
      "id": "semantic_one_shot_analysis_loads_none",
      "split": "sanity",
      "tags": [
        "boundary",
        "semantic-near-miss-routing"
      ],
      "input": {
        "query": "一次性比较这三个架构方案，说明主要取舍并给出建议。",
        "expected": {
          "loadedSkills": []
        }
      },
      "audit": {
        "rationale": "一次性分析不需要访谈、Prototype 或持续 Shape。",
        "minimalCounterexample": "若用户要求逐轮校准多个决定并按需取得体验证据，则应加载 decision-shape。",
        "errorCost": "high",
        "allowedVariance": "直接回答或使用范围外的分析能力；不得加载三个 Ask Me Skill。"
      }
    }
  ]
}
