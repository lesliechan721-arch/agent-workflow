{
  "schemaVersion": 3,
  "name": "agent-skill-toolkit",
  "version": "0.1.0-beta.11",
  "description": "创建和维护 Agent Skill；由用户启动单体、工作流和公开能力评审或简化，并独立审核 Skill Eval。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "dependencies": [
    "agent-content-toolkit"
  ],
  "skills": "./skills",
  "interface": {
    "displayName": "Agent Skill Toolkit",
    "shortDescription": "创建 Skill、手动评审与简化，并独立审核 Eval",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {
    "node": {
      "packageRoot": "./tooling"
    }
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-build-config.v1",
        "aw.plugin-manifest.v3",
        "aw.plugin-skills.v1"
      ]
    }
  }
}
