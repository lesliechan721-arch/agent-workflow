{
  "schemaVersion": 4,
  "name": "agent-skill-toolkit",
  "version": "0.1.0-beta.19",
  "description": "创建、修改、重构和只读评审 Agent Skill 与多 Skill 组合架构，并独立审核 Skill Eval。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "dependencies": [
    "agent-content-toolkit"
  ],
  "skills": "./skills",
  "platforms": [
    "codex",
    "claude",
    "antigravity",
    "cursor",
    "opencode",
    "pi",
    "copilot",
    "grok",
    "generic"
  ],
  "interface": {
    "displayName": "Agent Skill Toolkit",
    "shortDescription": "创建、重构、评审 Agent Skill 及独立审核 Eval",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {
    "node": {
      "packageRoot": "./tooling"
    }
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-build-config.v1",
        "aw.plugin-manifest.v4",
        "aw.plugin-skills.v1",
        "aw.portable-skills.v1"
      ]
    }
  }
}
