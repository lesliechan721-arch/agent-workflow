{
  "schemaVersion": 4,
  "name": "agent-skill-toolkit",
  "version": "0.1.0",
  "description": "创建、修改、重构和只读评审 Agent Skill 与多 Skill 组合架构，并独立审核 Skill Eval。",
  "platforms": [
    "codex",
    "claude",
    "antigravity",
    "cursor",
    "opencode",
    "pi",
    "copilot",
    "grok",
    "generic"
  ],
  "dependencies": [
    "agent-content-toolkit"
  ],
  "skills": "./skills",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "interface": {
    "displayName": "Agent Skill Toolkit",
    "shortDescription": "创建、重构、评审 Agent Skill 及独立审核 Eval",
    "capabilities": [
      "Skills"
    ]
  },
  "buildConfig": {
    "cacheable": true,
    "generatedSkillRuntimeFiles": [
      {
        "skill": "agent-skill",
        "target": "scripts/init-skill.mjs"
      },
      {
        "skill": "agent-skill",
        "target": "scripts/check-skill.mjs"
      },
      {
        "skill": "agent-skill",
        "target": "assets/tooling-NOTICE.txt"
      }
    ]
  },
  "scripts": {
    "tests": {
      "node": [
        "./scripts/contract.test.mjs",
        "./scripts/tooling.test.mjs"
      ]
    },
    "node": {
      "packageRoot": "./tooling",
      "build": {
        "runner": "node",
        "path": "./scripts/build-tools.mjs"
      }
    }
  }
}
