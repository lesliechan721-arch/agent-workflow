{
  "schemaVersion": 3,
  "name": "agent-skill-toolkit",
  "version": "0.1.0-beta.9",
  "description": "创建、评审和简化 Agent Skill，独立审核 Skill Eval，并评审跨 Skill 工作流与公开能力架构。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "dependencies": [
    "agent-content-toolkit"
  ],
  "skills": "./skills",
  "interface": {
    "displayName": "Agent Skill Toolkit",
    "shortDescription": "创建、评审、简化 Agent Skill，并审核 Eval 与工作流架构",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {
    "node": {
      "packageRoot": "./tooling"
    }
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-build-config.v1",
        "aw.plugin-manifest.v3",
        "aw.plugin-skills.v1"
      ]
    }
  }
}
