{
  "schemaVersion": 2,
  "name": "agent-skill-toolkit",
  "version": "0.1.0-beta.1",
  "description": "使用共享标准创建或评审单个 Agent Skill，设计或审核 Skill Eval，并评审有界的跨 Skill 工作流。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-build-config.v1",
        "aw.plugin-manifest.v2",
        "aw.plugin-skills.v1",
        "aw.review-publication.v1",
        "aw.runtime-imports.v1",
        "aw.skill-validation.v1"
      ]
    }
  },
  "dependencies": [
    "agent-content-toolkit"
  ],
  "skills": "./skills",
  "interface": {
    "displayName": "Agent Skill Toolkit",
    "shortDescription": "创建和评审 Agent Skill，设计和审核 Eval 与跨 Skill 工作流",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {
    "timeoutMs": 30000,
    "node": {}
  }
}
