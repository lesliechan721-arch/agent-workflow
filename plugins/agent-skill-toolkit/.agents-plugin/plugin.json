{
  "schemaVersion": 3,
  "name": "agent-skill-toolkit",
  "version": "0.1.0",
  "description": "创建和维护 Agent Skill；由用户启动单体、工作流和公开能力评审或简化，并独立审核 Skill Eval。",
  "dependencies": [
    "agent-content-toolkit"
  ],
  "skills": "./skills",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "interface": {
    "displayName": "Agent Skill Toolkit",
    "shortDescription": "创建 Skill、手动评审与简化，并独立审核 Eval",
    "capabilities": [
      "Skills"
    ]
  },
  "buildConfig": {
    "cacheable": true,
    "skillRuntimeFiles": [
      {
        "skill": "author-agent-skill",
        "target": "references/skill-invocation.md",
        "source": "./references/skill-invocation.md"
      },
      {
        "skill": "review-agent-skill",
        "target": "references/skill-invocation.md",
        "source": "./references/skill-invocation.md"
      },
      {
        "skill": "author-agent-skill",
        "target": "references/skill-composition.md",
        "source": "./references/skill-composition.md"
      },
      {
        "skill": "review-agent-skill",
        "target": "references/skill-composition.md",
        "source": "./references/skill-composition.md"
      },
      {
        "skill": "simplify-agent-skill",
        "target": "references/skill-composition.md",
        "source": "./references/skill-composition.md"
      },
      {
        "skill": "author-agent-skill",
        "target": "references/skill-format.md",
        "source": "./references/skill-format.md"
      },
      {
        "skill": "review-agent-skill",
        "target": "references/skill-format.md",
        "source": "./references/skill-format.md"
      },
      {
        "skill": "simplify-agent-skill",
        "target": "references/skill-format.md",
        "source": "./references/skill-format.md"
      }
    ],
    "generatedSkillRuntimeFiles": [
      {
        "skill": "author-agent-skill",
        "target": "scripts/init-skill.mjs"
      },
      {
        "skill": "author-agent-skill",
        "target": "scripts/check-skill.mjs"
      },
      {
        "skill": "review-agent-skill",
        "target": "scripts/check-skill.mjs"
      },
      {
        "skill": "simplify-agent-skill",
        "target": "scripts/check-skill.mjs"
      },
      {
        "skill": "author-agent-skill",
        "target": "assets/tooling-NOTICE.txt"
      },
      {
        "skill": "review-agent-skill",
        "target": "assets/tooling-NOTICE.txt"
      },
      {
        "skill": "simplify-agent-skill",
        "target": "assets/tooling-NOTICE.txt"
      }
    ]
  },
  "scripts": {
    "tests": {
      "node": [
        "./scripts/contract.test.mjs",
        "./scripts/tooling.test.mjs"
      ]
    },
    "node": {
      "packageRoot": "./tooling",
      "build": {
        "runner": "node",
        "path": "./scripts/build-tools.mjs"
      }
    }
  }
}
