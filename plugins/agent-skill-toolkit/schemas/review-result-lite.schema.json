{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-toolkit.invalid/review-result-lite.schema.json",
  "title": "ReviewResultLite",
  "type": "object",
  "required": [
    "schemaVersion",
    "target",
    "mode",
    "design",
    "complexity",
    "summary",
    "findings",
    "unknowns",
    "evalEvidence",
    "dimensions"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "target": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "mode": { "enum": ["quick", "full", "delta"] },
    "design": { "enum": ["pass", "needs-fixes", "redesign", "fail", "not-assessed"] },
    "complexity": { "enum": ["proportionate", "over-specified", "over-engineered", "not-assessed"] },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "area", "evidenceType", "evidence", "issue", "action"],
        "properties": {
          "severity": { "enum": ["critical", "major", "minor", "advisory"] },
          "area": { "type": "string", "minLength": 1 },
          "evidenceType": {
            "enum": ["observed", "normative", "structural", "official-guidance", "heuristic", "inferred"]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "issue": { "type": "string", "minLength": 1 },
          "affectedScenario": { "type": "string", "minLength": 1 },
          "owner": {
            "enum": ["skill", "schema", "client", "runtime", "script", "role", "eval", "project", "user"]
          },
          "action": { "type": "string", "minLength": 1 },
          "validation": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "severity": { "enum": ["critical", "major"] } },
              "required": ["severity"]
            },
            "then": { "required": ["affectedScenario", "owner", "validation"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evalEvidence": { "enum": ["none", "structural", "executed", "comparative"] },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "score", "confidence", "basis"],
        "properties": {
          "id": {
            "enum": [
              "specification",
              "problem_value",
              "triggering",
              "scope_composition",
              "instruction_design",
              "minimum_control",
              "context_disclosure",
              "architecture",
              "scripts",
              "evals",
              "reliability",
              "maintainability"
            ]
          },
          "score": { "type": ["number", "null"], "minimum": 0, "maximum": 5, "multipleOf": 0.5 },
          "confidence": { "enum": ["high", "medium", "low", "unknown"] },
          "basis": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
