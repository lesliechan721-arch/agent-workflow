{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-toolkit.invalid/review-input-bundle.schema.json",
  "title": "ReviewInputBundle",
  "type": "object",
  "required": [
    "schemaVersion",
    "target",
    "artifacts",
    "environment",
    "orchestration"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "target": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "sourceDigest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent-skill",
            "aw-plugin"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "profile",
          "digest",
          "owner",
          "currentness"
        ],
        "properties": {
          "role": {
            "enum": [
              "source",
              "final",
              "evidence",
              "project-profile"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "currentness": {
            "enum": [
              "current",
              "historical",
              "dirty",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object"
    },
    "orchestration": {
      "type": "object",
      "required": [
        "stageOwner",
        "providedStages"
      ],
      "properties": {
        "stageOwner": {
          "enum": [
            "review-agent-skill",
            "caller"
          ]
        },
        "providedStages": {
          "type": "array",
          "uniqueItems": true,
          "description": "Compact indexes of independently produced results. Each record must be revalidated against resultPath before reuse.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "producer",
              "independentContext",
              "targetDigest",
              "resultPath",
              "resultDigest",
              "schema"
            ],
            "properties": {
              "id": {
                "enum": [
                  "eval-audit",
                  "reference-audit",
                  "source-skill-review",
                  "materialized-profile-review",
                  "eval-result-triage"
                ]
              },
              "producer": {
                "type": "string",
                "minLength": 1
              },
              "independentContext": {
                "const": true,
                "description": "Reusable stages must be produced in an independent context; false is not a completed handoff."
              },
              "targetDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "resultPath": {
                "type": "string",
                "minLength": 1,
                "description": "Workspace-relative path to a validated stage envelope or EvalAuditResult."
              },
              "resultDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "schema": {
                "enum": [
                  "EvalAuditResult",
                  "ReferenceAuditResult",
                  "ReviewResult"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
