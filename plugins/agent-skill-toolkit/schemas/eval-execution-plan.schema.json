{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-toolkit.invalid/schemas/eval-execution-plan.schema.json",
  "title": "EvalExecutionPlan",
  "type": "object",
  "required": ["schemaVersion", "planId", "target", "cases", "audit", "provider", "configurations", "runsPerCase", "timeoutMs", "outputRoot", "capture"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "target": {
      "type": "object",
      "required": ["name", "path", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "object",
      "required": ["paths", "corpusDigest"],
      "properties": {
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "corpusDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["path", "digest", "targetSkillDigest", "caseCorpusDigest", "validity"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "targetSkillDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "caseCorpusDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "validity": { "const": "pass" }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": ["id", "command", "capabilitiesPath", "capabilitiesDigest", "inheritEnvironment"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cwd": { "type": ["string", "null"] },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "capabilitiesPath": { "type": "string", "minLength": 1 },
        "capabilitiesDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "inheritEnvironment": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skillMode"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "skillMode": { "enum": ["with-skill", "without-skill", "previous-version"] },
          "skillPath": { "type": ["string", "null"] },
          "skillDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "env": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "runsPerCase": { "type": "integer", "minimum": 1 },
    "timeoutMs": { "type": "integer", "minimum": 1000 },
    "outputRoot": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "capture": {
      "type": "object",
      "required": ["outputs", "trace", "timing", "usage"],
      "properties": {
        "outputs": { "type": "boolean" },
        "trace": { "type": "boolean" },
        "timing": { "type": "boolean" },
        "usage": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
