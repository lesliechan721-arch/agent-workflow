{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-toolkit.invalid/schemas/eval-audit-result.schema.json",
  "title": "EvalAuditResult",
  "type": "object",
  "required": [
    "schemaVersion",
    "producer",
    "independentContext",
    "auditId",
    "mode",
    "targetSkillDigest",
    "caseCorpusDigest",
    "validity",
    "optimizationPolicy",
    "cases",
    "blockedCases",
    "releaseEligible",
    "failureTriage",
    "recommendedAction"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "producer": {
      "const": "audit-agent-skill-evals"
    },
    "independentContext": {
      "type": "boolean"
    },
    "auditId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "preflight",
        "result-triage"
      ]
    },
    "targetSkillDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "caseCorpusDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "validity": {
      "enum": [
        "pass",
        "unknown",
        "fail"
      ]
    },
    "optimizationPolicy": {
      "enum": [
        "recall-first",
        "precision-first",
        "balanced",
        "critical"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "releaseRelevant",
          "admission",
          "oracleConfidence",
          "findings"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "releaseRelevant": {
            "type": "boolean"
          },
          "admission": {
            "enum": [
              "pass",
              "unknown",
              "fail"
            ]
          },
          "oracleConfidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "blockedCases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "releaseEligible": {
      "type": "boolean"
    },
    "failureTriage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "attribution",
          "action",
          "evidence"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "enum": [
              "skill-defect",
              "oracle-defect",
              "fixture-defect",
              "grader-defect",
              "runtime-or-tool-defect",
              "model-variance",
              "stale-case",
              "insufficient-runs",
              "expected-tradeoff",
              "unknown"
            ]
          },
          "action": {
            "enum": [
              "fix-eval-first",
              "collect-more-data",
              "candidate-skill-fix",
              "accepted-risk",
              "runtime-issue"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "recommendedAction": {
      "enum": [
        "fix-eval-first",
        "collect-more-data",
        "candidate-skill-fix",
        "accepted-risk",
        "runtime-issue"
      ]
    }
  },
  "additionalProperties": false
}
