{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-toolkit.invalid/schemas/eval-run-bundle.schema.json",
  "title": "EvalRunBundle",
  "type": "object",
  "required": [
    "schemaVersion",
    "runner",
    "independentContext",
    "provider",
    "planDigest",
    "targetSkillDigest",
    "caseCorpusDigest",
    "comparisonPlanned",
    "evidenceLevel",
    "runs",
    "aggregate",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "runner": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "independentContext": {
      "type": "boolean"
    },
    "provider": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "targetSkillDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "caseCorpusDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "comparisonPlanned": {
      "type": "boolean"
    },
    "evidenceLevel": {
      "enum": [
        "executed",
        "comparative"
      ]
    },
    "evidenceRequirement": {
      "type": "object",
      "required": [
        "minimumEvidenceLevel",
        "plannedComparisons",
        "comparableComparisons",
        "satisfied"
      ],
      "properties": {
        "minimumEvidenceLevel": {
          "enum": [
            "executed",
            "comparative"
          ]
        },
        "plannedComparisons": {
          "type": "integer",
          "minimum": 0
        },
        "comparableComparisons": {
          "type": "integer",
          "minimum": 0
        },
        "satisfied": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "processManagement": {
      "type": "object",
      "required": [
        "mode",
        "descendantCleanupGuaranteed"
      ],
      "properties": {
        "mode": {
          "enum": [
            "managed",
            "verified-observed",
            "observed"
          ]
        },
        "descendantCleanupGuaranteed": {
          "type": "boolean"
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "verified-observed",
                  "observed"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "limitation"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "configuration",
          "comparisonId",
          "skillMode",
          "skillDigest",
          "runIndex",
          "status",
          "exitCode",
          "durationMs",
          "stdoutPath",
          "stdoutDigest",
          "stderrPath",
          "stderrDigest",
          "usage",
          "grading",
          "artifacts"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "configuration": {
            "type": "string",
            "minLength": 1
          },
          "comparisonId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "skillMode": {
            "enum": [
              "with-skill",
              "without-skill",
              "previous-version"
            ]
          },
          "skillDigest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "runIndex": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "completed",
              "process-failed",
              "timeout",
              "error"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "stdoutPath": {
            "type": "string",
            "minLength": 1
          },
          "stdoutDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "stderrPath": {
            "type": "string",
            "minLength": 1
          },
          "stderrDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "usage": {
            "type": [
              "object",
              "null"
            ]
          },
          "grading": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "grader",
              "result"
            ],
            "properties": {
              "grader": {
                "type": "object",
                "required": [
                  "id",
                  "version"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              },
              "result": {
                "type": "object"
              }
            },
            "additionalProperties": true
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role",
                "path",
                "digest"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "trace",
                    "report",
                    "output",
                    "grading",
                    "other"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "aggregate": {
      "type": "object",
      "required": [
        "cases",
        "configurations",
        "runs",
        "completed",
        "processFailed",
        "timedOut",
        "comparisons"
      ],
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 1
        },
        "configurations": {
          "type": "integer",
          "minimum": 1
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "processFailed": {
          "type": "integer",
          "minimum": 0
        },
        "timedOut": {
          "type": "integer",
          "minimum": 0
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "comparisonId",
              "caseId",
              "runIndex",
              "paired",
              "comparable"
            ],
            "properties": {
              "comparisonId": {
                "type": "string",
                "minLength": 1
              },
              "caseId": {
                "type": "string",
                "minLength": 1
              },
              "runIndex": {
                "type": "integer",
                "minimum": 1
              },
              "paired": {
                "type": "boolean"
              },
              "comparable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
