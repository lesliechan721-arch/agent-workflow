{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "audit-agent-skill-evals",
    "participants": [
      "write-agent-content",
      "review-agent-content",
      "author-agent-skill",
      "review-agent-skill",
      "design-agent-skill-evals",
      "run-aw-skill-evals"
    ],
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "漏触发或误触发会改变权限、上下文或交付 owner。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "preflight",
      "split": "train",
      "tags": [
        "representative"
      ],
      "input": {
        "query": "运行前审核 Skill Eval cases 的 Oracle 和现实性。",
        "expectedLoad": true
      }
    },
    {
      "id": "mixed",
      "split": "train",
      "tags": [
        "representative"
      ],
      "input": {
        "query": "解释负例 1/3 失败是否足以驱动 Skill 修改。",
        "expectedLoad": true
      }
    },
    {
      "id": "triage",
      "split": "train",
      "tags": [
        "representative"
      ],
      "input": {
        "query": "对 Eval 结果做 failure triage 和 change-safety 判断。",
        "expectedLoad": true
      }
    },
    {
      "id": "cost",
      "split": "validation",
      "tags": [
        "representative",
        "release-critical"
      ],
      "input": {
        "query": "审核正负错误代价和 representative/challenge 权重。",
        "expectedLoad": true
      },
      "audit": {
        "errorCost": "high"
      }
    },
    {
      "id": "stale",
      "split": "validation",
      "tags": [
        "representative",
        "release-critical"
      ],
      "input": {
        "query": "检查 Skill 修改后旧 EvalAudit v1 是否与当前 EvalSpec 绑定失配。",
        "expectedLoad": true
      },
      "audit": {
        "errorCost": "high"
      }
    },
    {
      "id": "create",
      "split": "train",
      "tags": [
        "boundary"
      ],
      "input": {
        "query": "直接创建一套新 Eval cases。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "minimalCounterexample": "改变主要交付后标签翻转。"
      }
    },
    {
      "id": "run",
      "split": "train",
      "tags": [
        "boundary"
      ],
      "input": {
        "query": "运行项目专有 plugin Eval。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "minimalCounterexample": "改变主要交付后标签翻转。"
      }
    },
    {
      "id": "skill_review",
      "split": "validation",
      "tags": [
        "boundary",
        "release-critical"
      ],
      "input": {
        "query": "不看 Eval，直接评审整个 Skill。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "minimalCounterexample": "改变主要交付后标签翻转。",
        "errorCost": "high"
      }
    },
    {
      "id": "skill_fix",
      "split": "validation",
      "tags": [
        "boundary",
        "release-critical"
      ],
      "input": {
        "query": "根据单个失败直接修改 Skill。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "minimalCounterexample": "改变主要交付后标签翻转。",
        "errorCost": "high"
      }
    },
    {
      "id": "publish",
      "split": "validation",
      "tags": [
        "boundary",
        "release-critical"
      ],
      "input": {
        "query": "发布项目 Review 报告。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "minimalCounterexample": "改变主要交付后标签翻转。",
        "errorCost": "high"
      }
    }
  ]
}
