{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "design-agent-skill-evals",
    "participants": [
      "write-agent-content",
      "review-agent-content",
      "author-agent-skill",
      "review-agent-skill",
      "audit-agent-skill-evals",
      "run-aw-skill-evals"
    ],
    "defaultGrader": "mechanical",
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "漏触发或误触发会改变权限、上下文或交付 owner。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "trigger",
      "split": "train",
      "tags": [
        "representative"
      ],
      "input": {
        "query": "为 Skill 设计 trigger 和 behavior eval cases。",
        "expectedLoad": true
      }
    },
    {
      "id": "minimal_pair",
      "split": "train",
      "tags": [
        "representative"
      ],
      "input": {
        "query": "补一组 minimal pair 和 regression cases。",
        "expectedLoad": true
      }
    },
    {
      "id": "oracle_edit",
      "split": "train",
      "tags": [
        "representative"
      ],
      "input": {
        "query": "修改 Eval suite 的 Oracle、assertion 和 run policy。",
        "expectedLoad": true
      }
    },
    {
      "id": "cost_policy",
      "split": "validation",
      "tags": [
        "representative",
        "release-critical"
      ],
      "input": {
        "query": "为高误触发成本 Skill 设计 precision-first suite。",
        "expectedLoad": true
      },
      "audit": {
        "errorCost": "high"
      }
    },
    {
      "id": "fixture",
      "split": "validation",
      "tags": [
        "representative",
        "release-critical"
      ],
      "input": {
        "query": "为 behavior eval 创建真实 fixture 和可观察 assertion。",
        "expectedLoad": true
      },
      "audit": {
        "errorCost": "high"
      }
    },
    {
      "id": "audit",
      "split": "train",
      "tags": [
        "boundary"
      ],
      "input": {
        "query": "只读审核现有 Eval Oracle 是否正确。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "minimalCounterexample": "改变主要交付后标签翻转。"
      }
    },
    {
      "id": "run",
      "split": "train",
      "tags": [
        "boundary"
      ],
      "input": {
        "query": "运行这些 Eval 并解释失败。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "minimalCounterexample": "改变主要交付后标签翻转。"
      }
    },
    {
      "id": "skill_fix",
      "split": "validation",
      "tags": [
        "boundary",
        "release-critical"
      ],
      "input": {
        "query": "根据失败直接修改生产 Skill。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "minimalCounterexample": "改变主要交付后标签翻转。",
        "errorCost": "high"
      }
    },
    {
      "id": "full_author",
      "split": "validation",
      "tags": [
        "boundary",
        "release-critical"
      ],
      "input": {
        "query": "创建完整 Skill 和 eval。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "minimalCounterexample": "改变主要交付后标签翻转。",
        "errorCost": "high"
      }
    },
    {
      "id": "review",
      "split": "validation",
      "tags": [
        "boundary",
        "release-critical"
      ],
      "input": {
        "query": "完整评审 Skill 的设计和发布证据。",
        "expectedLoad": false
      },
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "minimalCounterexample": "改变主要交付后标签翻转。",
        "errorCost": "high"
      }
    }
  ]
}
