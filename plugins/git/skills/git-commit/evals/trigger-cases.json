{
  "schemaVersion": 1,
  "skill": "git-commit",
  "cases": [
    {
      "id": "casual_current_changes",
      "split": "train",
      "query": "支付超时的问题已经修好了，帮我把当前改动提交一下。",
      "should_load_skill": true
    },
    {
      "id": "staged_only",
      "split": "train",
      "query": "我已经 git add 过了，请只把 staged changes 做成一个 commit。",
      "should_load_skill": true
    },
    {
      "id": "specific_files",
      "split": "train",
      "query": "只提交 README.md 和 docs/install.md 这次文档调整，其它本地改动别动。",
      "should_load_skill": true
    },
    {
      "id": "english_commit",
      "split": "train",
      "query": "Commit these changes with a useful summary of what changed.",
      "should_load_skill": true
    },
    {
      "id": "commit_and_push",
      "split": "train",
      "query": "核对一下范围，然后把这些改动提交并推送到当前分支。",
      "should_load_skill": true
    },
    {
      "id": "scoped_fix_commit",
      "split": "train",
      "query": "把配置加载修复创建成一个 Git commit，scope 使用 cli，body 用几条说明主要变化。",
      "should_load_skill": true
    },
    {
      "id": "draft_message_only",
      "split": "train",
      "query": "根据当前 diff 帮我拟一个 commit message 就好，不要真的提交。",
      "should_load_skill": false
    },
    {
      "id": "review_message_only",
      "split": "train",
      "query": "评审一下 `fix(cli): 修复安装失败` 这个 commit message 是否合适。",
      "should_load_skill": false
    },
    {
      "id": "status_only",
      "split": "train",
      "query": "看看现在 git status 是什么，解释一下哪些文件 staged 了。",
      "should_load_skill": false
    },
    {
      "id": "stage_only",
      "split": "train",
      "query": "只把 src/app.ts 加入暂存区，先不要创建 commit。",
      "should_load_skill": false
    },
    {
      "id": "push_existing",
      "split": "train",
      "query": "本地 commit 已经有了，把它 push 到 origin 当前分支。",
      "should_load_skill": false
    },
    {
      "id": "amend_history",
      "split": "train",
      "query": "用 amend 把漏掉的 CHANGELOG 合进上一个 commit。",
      "should_load_skill": false
    },
    {
      "id": "terse_commit",
      "split": "validation",
      "query": "帮我 git commti 一下，正文别只写标题。",
      "should_load_skill": true
    },
    {
      "id": "documentation_commit",
      "split": "validation",
      "query": "安装指南已经更新完，请把文档变更提交掉。",
      "should_load_skill": true
    },
    {
      "id": "mixed_language_staged",
      "split": "validation",
      "query": "pls commit 已暂存的 docs changes，别带上 workspace 里其它东西。",
      "should_load_skill": true
    },
    {
      "id": "implicit_commit_then_push",
      "split": "validation",
      "query": "把这批修改记录进 Git 历史，再推到当前远端分支。",
      "should_load_skill": true
    },
    {
      "id": "explain_last_commit",
      "split": "validation",
      "query": "最近一次 commit 改了什么？按模块解释给我。",
      "should_load_skill": false
    },
    {
      "id": "squash_history",
      "split": "validation",
      "query": "把最近三个 commits rebase squash 成一个，保留第一条 message。",
      "should_load_skill": false
    },
    {
      "id": "non_git_commitment",
      "split": "validation",
      "query": "Can you commit to the Friday deadline，并把审批表单提交给财务？这里不是 Git 操作。",
      "should_load_skill": false
    },
    {
      "id": "merge_operation",
      "split": "validation",
      "query": "把 feature 分支 merge 进当前分支，按 Git 默认流程处理。",
      "should_load_skill": false
    }
  ]
}
