{
  "version": 1,
  "suite": {
    "kind": "trigger",
    "unitUnderTest": "write-agent-content",
    "participants": [
      "review-agent-content",
      "author-agent-skill",
      "review-agent-skill",
      "design-agent-skill-evals",
      "audit-agent-skill-evals",
      "run-aw-skill-evals"
    ],
    "policy": {
      "optimization": "balanced",
      "falseNegativeCost": "high",
      "falsePositiveCost": "high",
      "rationale": "漏触发或误触发会改变权限、上下文或交付 owner。"
    },
    "runtime": {
      "observeSpawnAgent": false,
      "isolation": "strict",
      "strictNegativeSplits": [
        "validation"
      ],
      "forbidMultipleSkillLoads": false
    }
  },
  "cases": [
    {
      "id": "agents_rewrite",
      "split": "train",
      "tags": [
        "representative",
        "core"
      ],
      "input": {
        "query": "重写 AGENTS.md，让模型知道不同目录何时读取 reference。",
        "expectedLoad": true
      }
    },
    {
      "id": "prompt_edit",
      "split": "train",
      "tags": [
        "representative",
        "core"
      ],
      "input": {
        "query": "把 system prompt 改得更轻、更可执行。",
        "expectedLoad": true
      }
    },
    {
      "id": "role_contract",
      "split": "train",
      "tags": [
        "representative",
        "core"
      ],
      "input": {
        "query": "为 role instruction 写完成边界和输出合同。",
        "expectedLoad": true
      }
    },
    {
      "id": "reference_restructure",
      "split": "validation",
      "tags": [
        "representative",
        "core"
      ],
      "input": {
        "query": "重组一份给 agent 读取的大 reference，按 branch 渐进披露。",
        "expectedLoad": true
      }
    },
    {
      "id": "claude_md",
      "split": "validation",
      "tags": [
        "representative",
        "core"
      ],
      "input": {
        "query": "更新 CLAUDE.md 的项目规则但不创建 Skill。",
        "expectedLoad": true
      }
    },
    {
      "id": "review_only",
      "split": "train",
      "tags": [
        "boundary",
        "author-review"
      ],
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "allowedVariance": "可组合下游能力，但顶层 owner 和权限必须正确。",
        "minimalCounterexample": "改变主要交付后标签翻转。"
      },
      "input": {
        "query": "只读审核 AGENTS.md 是否过重，不修改。",
        "expectedLoad": false
      }
    },
    {
      "id": "full_skill",
      "split": "train",
      "tags": [
        "boundary",
        "skill-author"
      ],
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "allowedVariance": "可组合下游能力，但顶层 owner 和权限必须正确。",
        "minimalCounterexample": "改变主要交付后标签翻转。"
      },
      "input": {
        "query": "创建完整 Agent Skill 包和 eval。",
        "expectedLoad": false
      }
    },
    {
      "id": "skill_behavior",
      "split": "validation",
      "tags": [
        "boundary",
        "skill-author"
      ],
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "allowedVariance": "可组合下游能力，但顶层 owner 和权限必须正确。",
        "minimalCounterexample": "改变主要交付后标签翻转。"
      },
      "input": {
        "query": "修改 Skill 的触发和工作流。",
        "expectedLoad": false
      }
    },
    {
      "id": "explain",
      "split": "validation",
      "tags": [
        "boundary",
        "explain"
      ],
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "allowedVariance": "可组合下游能力，但顶层 owner 和权限必须正确。",
        "minimalCounterexample": "改变主要交付后标签翻转。"
      },
      "input": {
        "query": "解释 prompt 含义，不编辑。",
        "expectedLoad": false
      }
    },
    {
      "id": "user_docs",
      "split": "validation",
      "tags": [
        "boundary",
        "non-agent-content"
      ],
      "audit": {
        "rationale": "请求由相邻能力拥有。",
        "allowedVariance": "可组合下游能力，但顶层 owner 和权限必须正确。",
        "minimalCounterexample": "改变主要交付后标签翻转。"
      },
      "input": {
        "query": "润色普通用户 README。",
        "expectedLoad": false
      }
    }
  ]
}
