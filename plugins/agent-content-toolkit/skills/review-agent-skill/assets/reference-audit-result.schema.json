{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-content-toolkit.invalid/reference-audit-result.schema.json",
  "title": "ReferenceAuditResult",
  "type": "object",
  "required": ["schemaVersion", "target", "activePaths", "references", "findings", "unknowns"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": { "type": "string", "minLength": 1 },
    "activePaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["branch", "loadedReferences"],
        "properties": {
          "branch": { "type": "string", "minLength": 1 },
          "loadedReferences": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "responsibilities", "verdict", "evidence"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "responsibilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "neededContentRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "verdict": { "enum": ["keep", "add-index", "split-by-branch", "inline-core", "move-to-script-or-data", "delete-or-environment-lookup", "needs-ablation"] },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
