{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-content-toolkit.invalid/review-input-bundle.schema.json",
  "title": "ReviewInputBundle",
  "type": "object",
  "required": ["schemaVersion", "target", "artifacts", "environment", "orchestration", "evalAudit", "evalResults"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": {
      "type": "object",
      "required": ["kind", "name", "sourceDigest"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "profile", "digest", "owner", "currentness"],
        "properties": {
          "role": { "enum": ["source", "final", "evidence", "project-profile"] },
          "path": { "type": "string", "minLength": 1 },
          "profile": { "type": ["string", "null"] },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "owner": { "type": "string", "minLength": 1 },
          "currentness": { "enum": ["current", "historical", "dirty", "unknown"] }
        },
        "additionalProperties": false
      }
    },
    "environment": { "type": "object" },
    "orchestration": {
      "type": "object",
      "required": ["stageOwner", "providedStages"],
      "properties": {
        "stageOwner": { "enum": ["review-agent-skill", "caller"] },
        "providedStages": {
          "type": "array",
          "items": { "enum": ["source-bundle", "eval-audit", "reference-audit", "source-skill-review", "materialized-profile-review", "eval-result-triage"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "evalAudit": { "type": ["object", "null"] },
    "evalResults": { "type": "array" }
  },
  "additionalProperties": false
}
