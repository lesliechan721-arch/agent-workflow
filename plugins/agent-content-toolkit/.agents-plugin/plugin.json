{
  "name": "agent-content-toolkit",
  "version": "0.1.0",
  "description": "创建和评审 Agent-facing 文档，并保持最小上下文负担、清楚指针和适度控制。",
  "compatibility": {
    "aw": {
      "minVersion": "0.0.0"
    }
  },
  "skills": "./skills",
  "buildConfig": {
    "cacheable": true,
    "runtimeExports": [
      {
        "name": "content-rules",
        "source": "./standards/rules.json"
      },
      {
        "name": "reference-audit-result-schema",
        "source": "./schemas/reference-audit-result.schema.json"
      }
    ],
    "skillRuntimeFiles": [
      {
        "skill": "review-agent-content",
        "source": "./schemas/reference-audit-result.schema.json",
        "target": "assets/reference-audit-result.schema.json"
      },
      {
        "skill": "review-agent-content",
        "source": "./scripts/validate-json-contract.mjs",
        "target": "scripts/validate-json-contract.mjs"
      }
    ]
  },
  "scripts": {
    "node": {
      "build": {
        "runner": "node",
        "path": "./scripts/build.mjs",
        "args": []
      }
    },
    "tests": {
      "node": [
        "./scripts/contract.test.mjs"
      ]
    }
  },
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  }
}
