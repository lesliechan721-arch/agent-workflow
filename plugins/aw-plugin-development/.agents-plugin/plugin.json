  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-authoring.v1",
        "aw.plugin-build-config.v1",
        "aw.plugin-manifest.v3",
        "aw.plugin-skills.v1",
        "aw.review-publication.v1",
        "aw.runtime-imports.v1",
        "aw.self-check.v1",
        "aw.skill-validation.v1"
      ]
    }
  },
  "dependencies": [
    "agent-content-toolkit",
    "agent-skill-toolkit"
  ],
  "skills": "./skills",
  "interface": {
    "displayName": "AW Plugin Development",
    "shortDescription": "创建、维护和评审 AW 插件及跨插件工作流",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {}
}
