{
  "schemaVersion": 2,
  "name": "aw-plugin-development",
  "version": "0.1.0",
  "description": "创建或维护 AW 插件，评审单个 AW 插件，并评审有界的跨 AW 插件工作流。",
  "dependencies": [
    "agent-content-toolkit",
    "agent-skill-toolkit"
  ],
  "skills": "./skills",
  "buildConfig": {
    "skillRuntimeFiles": [
      {
        "skill": "author-aw-plugin",
        "target": "assets/aw-authoring-context.schema.json",
        "source": "./schemas/aw-authoring-context.schema.json"
      },
      {
        "skill": "author-aw-plugin",
        "target": "scripts/validate-json-contract.mjs",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "validate-json-contract"
        }
      },
      {
        "skill": "author-aw-plugin",
        "target": "assets/skill-design-brief.schema.json",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "skill-design-brief-schema"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/check-aw-plugin-release.mjs",
        "source": "./scripts/check-aw-plugin-release.mjs"
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/review-skill-leaf-plan.mjs",
        "source": "./scripts/review-skill-leaf-plan.mjs"
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/check-agent-skill.mjs",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "check-agent-skill"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/validate-quality-review-result.mjs",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "validate-quality-review-result"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "assets/quality-review-result.schema.json",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "quality-review-result-schema"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "assets/review-dimensions.json",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "review-dimensions"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/validate-json-contract.mjs",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "validate-json-contract"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/validate-eval-audit-result.mjs",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "validate-eval-audit-result"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/corpus-digest.mjs",
        "import": {
          "plugin": "@aw/agent-skill-eval",
          "export": "case-corpus-digest"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/validate-eval-run-bundle.mjs",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "validate-eval-run-bundle"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "assets/eval-audit-result.schema.json",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "eval-audit-result-schema"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "assets/eval-run-bundle.schema.json",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "eval-run-bundle-schema"
        }
      },
      {
        "skill": "review-aw-plugin",
        "target": "references/review-publication.md",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "review-publication-reference"
        }
      },
      {
        "skill": "review-aw-workflow",
        "target": "scripts/discover-aw-workflow.mjs",
        "source": "./scripts/discover-aw-workflow.mjs"
      },
      {
        "skill": "review-aw-workflow",
        "target": "references/review-publication.md",
        "import": {
          "plugin": "agent-skill-toolkit",
          "export": "review-publication-reference"
        }
      }
    ]
  },
  "scripts": {
    "tests": {
      "node": [
        "./scripts/contract.test.mjs",
        "./scripts/plugin-review-target-contract.test.mjs",
        "./scripts/aw-workflow-contract.test.mjs",
        "./scripts/invocation-contract.test.mjs",
        "./scripts/reference-contract.test.mjs",
        "./scripts/authoring-context-contract.test.mjs",
        "./scripts/lightweight-review-contract.test.mjs",
        "./scripts/release-eval-chain-contract.test.mjs"
      ]
    }
  },
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "interface": {
    "displayName": "AW Plugin Development",
    "shortDescription": "创建、维护和评审 AW 插件及跨插件工作流",
    "capabilities": [
      "Skills"
    ]
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-authoring.v1"
      ]
    }
  }
}
