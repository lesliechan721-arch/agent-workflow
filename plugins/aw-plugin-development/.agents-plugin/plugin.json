{
  "name": "aw-plugin-development",
  "version": "0.1.0",
  "description": "通过 AW adapter 组合通用 Agent Skill 与 Agent 内容 toolkit，创建、维护并轻量评审 AW 插件。",
  "compatibility": {
    "aw": { "minVersion": "0.0.0" }
  },
  "skills": "./skills",
  "buildConfig": {
    "cacheable": true,
    "buildImports": [
      {
        "plugin": "@aw/cli",
        "export": "skill-frontmatter-capabilities",
        "env": "AW_PLUGIN_IMPORT_SKILL_FRONTMATTER_CAPABILITIES"
      }
    ],
    "skillRuntimeFiles": [
      {
        "skill": "author-aw-plugin",
        "target": "assets/aw-authoring-context.schema.json",
        "source": "./schemas/aw-authoring-context.schema.json"
      },
      {
        "skill": "author-aw-plugin",
        "target": "scripts/validate-json-contract.mjs",
        "import": { "plugin": "agent-skill-toolkit", "export": "validate-json-contract" }
      },
      {
        "skill": "author-aw-plugin",
        "target": "scripts/validate-eval-audit-result.mjs",
        "import": { "plugin": "agent-skill-toolkit", "export": "validate-eval-audit-result" }
      },
      {
        "skill": "author-aw-plugin",
        "target": "assets/skill-design-brief.schema.json",
        "import": { "plugin": "agent-skill-toolkit", "export": "skill-design-brief-schema" }
      },
      {
        "skill": "author-aw-plugin",
        "target": "assets/eval-audit-result.schema.json",
        "import": { "plugin": "agent-skill-toolkit", "export": "eval-audit-result-schema" }
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/check-aw-plugin-release.mjs",
        "source": "./scripts/check-aw-plugin-release.mjs"
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/check-agent-skill.mjs",
        "import": { "plugin": "agent-skill-toolkit", "export": "check-agent-skill" }
      },
      {
        "skill": "review-aw-plugin",
        "target": "scripts/validate-review-result-lite.mjs",
        "import": { "plugin": "agent-skill-toolkit", "export": "validate-review-result-lite" }
      },
      {
        "skill": "review-aw-plugin",
        "target": "assets/review-result-lite.schema.json",
        "import": { "plugin": "agent-skill-toolkit", "export": "review-result-lite-schema" }
      }
    ]
  },
  "scripts": {
    "node": {
      "build": {
        "runner": "node",
        "path": "./scripts/build-runtime-assets.mjs",
        "args": []
      }
    },
    "tests": {
      "node": [
        "./scripts/contract.test.mjs",
        "./scripts/invocation-contract.test.mjs",
        "./scripts/reference-contract.test.mjs",
        "./scripts/authoring-context-contract.test.mjs",
        "./scripts/lightweight-review-contract.test.mjs"
      ]
    }
  },
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": ["CODEX", "CLAUDE"]
    }
  }
}
