{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aw-plugin-development.invalid/aw-authoring-context.schema.json",
  "title": "AWAuthoringContext",
  "type": "object",
  "required": ["schemaVersion", "repository", "plugin", "pluginRoot", "changeMode", "products", "componentType", "skillInvocation", "allowedFiles", "sourceProfile", "manifestVersionBump", "buildRequired", "validators"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "const": "agent-workflows" },
    "plugin": { "type": "string", "minLength": 1 },
    "pluginRoot": { "type": "string", "minLength": 1 },
    "changeMode": { "enum": ["create", "change"] },
    "products": { "type": "array", "items": { "enum": ["CODEX", "CLAUDE"] }, "minItems": 1, "uniqueItems": true },
    "componentType": { "enum": ["skill", "extension", "slash-command", "mcp", "app", "dynamic-artifact", "unknown"] },
    "skillInvocation": { "enum": [null, "model", "manual", "claude-model-only"] },
    "allowedFiles": { "type": "array", "items": { "type": "string" } },
    "sourceProfile": { "type": "string", "minLength": 1 },
    "manifestVersionBump": { "enum": [null, "major", "minor", "patch"] },
    "buildRequired": { "type": "boolean" },
    "validators": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "componentType": { "const": "skill" } } },
      "then": { "properties": { "skillInvocation": { "enum": ["model", "manual", "claude-model-only"] } } },
      "else": { "properties": { "skillInvocation": { "const": null } } }
    },
    {
      "if": { "properties": { "skillInvocation": { "const": "claude-model-only" } } },
      "then": { "properties": { "products": { "const": ["CLAUDE"] } } }
    }
  ],
  "additionalProperties": false
}
