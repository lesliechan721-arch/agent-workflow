{
  "version": 1,
  "defaults": {},
  "profiles": {
    "project-default": {
      "scope": "project",
      "plugins": {
        "agent-content-toolkit": {},
        "agent-skill-toolkit": {},
        "aw-skill-eval-runner": {},
        "aw-plugin-development": {}
      }
    }
  },
  "suites": [
    {
      "id": "trigger",
      "kind": "trigger",
      "cases": "trigger-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "behavior",
      "kind": "conversation",
      "cases": "behavior-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 420000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    },
    {
      "id": "lightweight-delta",
      "kind": "conversation",
      "cases": "lightweight-delta-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 180000,
      "requiredForRelease": true,
      "releaseSplits": [
        "validation"
      ]
    }
  ]
}
