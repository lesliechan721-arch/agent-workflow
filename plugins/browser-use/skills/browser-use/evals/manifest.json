        "project-default"
      ],
      "runs": 3,
      "timeoutMs": 600000
    },
    {
      "id": "visual",
      "kind": "conversation",
      "cases": "visual-cases.json",
      "profiles": [
        "project-default"
      ],
      "runs": 1,
      "timeoutMs": 600000
    }
  ]
}
