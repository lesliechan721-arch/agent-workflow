{
  "schemaVersion": 3,
  "name": "browser-use",
  "version": "0.1.0-beta.2",
  "description": "以精简的浏览器技能完成网页预览、浏览、交互、截图和按需调试。",
  "marketplace": {
    "category": "workflow",
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": [
        "CODEX",
        "CLAUDE"
      ]
    }
  },
  "skills": "./skills",
  "interface": {
    "displayName": "Browser Use",
    "shortDescription": "轻量网页预览、浏览、交互与检查",
    "capabilities": [
      "Skills"
    ]
  },
  "scripts": {
    "preApply": {
      "path": "./scripts/check-agent-browser.mjs"
    }
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.plugin-manifest.v3",
        "aw.plugin-pre-apply.v1",
        "aw.plugin-skills.v1"
      ]
    }
  }
}
