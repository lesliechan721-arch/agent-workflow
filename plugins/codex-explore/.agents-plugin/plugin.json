{
  "name": "codex-explore",
  "version": "0.2.11",
  "description": "在大量、陌生或边界不明的代码、文档、日志和网页中隔离探索并核验证据。",
  "compatibility": {
    "aw": {
      "minVersion": "1.0.0-beta.31"
    }
  },
  "marketplace": {
    "category": "workflow",
    "tags": ["codex", "explorer", "research"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": ["CODEX"]
    }
  },
  "interface": {
    "displayName": "Codex Explore",
    "shortDescription": "Codex 行为只读的大型证据探索与核验",
    "capabilities": ["Skills", "Instructions", "Agents"]
  },
  "extensions": {
    "instructions": [
      {
        "name": "delegation-authorization",
        "title": "Codex Explore 子代理授权",
        "content": "调用 `codex-explore` 技能且 Gate 通过时，视为用户同意在该工作流中启用子代理；Gate 未通过时不得启动子代理。"
      }
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": [
        "./scripts/render-artifacts.test.mjs",
        "./scripts/trigger-evals.test.mjs",
        "./scripts/model-selection-evals.test.mjs",
        "./scripts/workflow-evals.test.mjs",
        "./scripts/liveness-evals.test.mjs"
      ]
    }
  },
  "config": {
    "schema": {
      "quickModel": {
        "type": "string",
        "title": "Quick 探索模型",
        "default": "gpt-5.6-luna",
        "description": "quick 探索 role 使用的模型。"
      },
      "quickReasoningEffort": {
        "type": "enum",
        "title": "Quick 探索推理强度",
        "values": ["low", "medium", "high", "xhigh", "max", "ultra"],
        "default": "medium",
        "description": "quick 探索 role 使用的 model_reasoning_effort。"
      },
      "standardModel": {
        "type": "string",
        "title": "Standard 探索模型",
        "default": "gpt-5.6-luna",
        "description": "standard 探索 role 使用的模型。"
      },
      "standardReasoningEffort": {
        "type": "enum",
        "title": "Standard 探索推理强度",
        "values": ["low", "medium", "high", "xhigh", "max", "ultra"],
        "default": "high",
        "description": "standard 探索 role 使用的 model_reasoning_effort。"
      },
      "deepModel": {
        "type": "string",
        "title": "Deep 探索模型",
        "default": "gpt-5.6-luna",
        "description": "deep 探索 role 使用的模型。"
      },
      "deepReasoningEffort": {
        "type": "enum",
        "title": "Deep 探索推理强度",
        "values": ["low", "medium", "high", "xhigh", "max", "ultra"],
        "default": "xhigh",
        "description": "deep 探索 role 使用的 model_reasoning_effort。"
      },
      "minimumInitialWaitMinutes": {
        "type": "number",
        "title": "首次响应式等待窗口（分钟）",
        "default": 10,
        "min": 1,
        "max": 60,
        "description": "用户未明确指定时，主代理首次响应式等待应使用的最小单次窗口。"
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "codex-explore-skill",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.skill",
        "projectManagedKind": "skill",
        "states": ["present"],
        "refreshKeys": ["minimumInitialWaitMinutes"],
        "skillKey": "codex-explore",
        "sourceDirs": ["./templates/codex-explore"]
      },
      {
        "id": "codex-explore-quick-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["quickModel", "quickReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore-quick"
      },
      {
        "id": "codex-explore-standard-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["standardModel", "standardReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore-standard"
      },
      {
        "id": "codex-explore-deep-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["deepModel", "deepReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore-deep"
      },
      {
        "id": "codex-explore-custom-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": [],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore-custom"
      }
    ]
  }
}
