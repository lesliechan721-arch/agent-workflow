{
  "name": "codex-explore",
  "version": "0.1.4",
  "description": "为 Codex 提供只读探索 workflow，支持代码库、多源资料与证据整合。",
  "skills": "./skills",
  "skillTriggers": {
    "codex-explore": {
      "allowInstallOverride": true
    }
  },
  "marketplace": {
    "category": "workflow",
    "tags": ["codex", "explorer", "research"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": ["CODEX"]
    }
  },
  "interface": {
    "displayName": "Codex Explore",
    "shortDescription": "Codex 只读探索与多源证据整合",
    "capabilities": ["Skills", "Instructions", "Agents"]
  },
  "extensions": {
    "instructions": [
      {
        "name": "delegation-authorization",
        "title": "Codex Explore 子代理授权",
        "content": "只有主 agent 可以在 `$codex-explore`、`codex-explore` 技能 Gate 通过后启动第一层 Codex Explore 子代理；这份授权不传递给探索子代理。Gate 未通过时不得启动任何子代理。"
      }
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": ["./scripts/render-artifacts.test.mjs"]
    }
  },
  "config": {
    "schema": {
      "explorerModel": {
        "type": "string",
        "title": "探索模型",
        "default": "gpt-5.4-mini",
        "description": "Codex Explore 默认受管子代理使用的模型；skill 不会回退到内置 explorer。"
      },
      "modelReasoningEffort": {
        "type": "enum",
        "title": "探索推理强度",
        "values": ["low", "medium", "high", "xhigh"],
        "default": "medium",
        "description": "Codex Explore 默认受管子代理使用的推理强度；skill 不会回退到内置 explorer。"
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "codex-explore-skill",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.skill",
        "projectManagedKind": "skill",
        "states": ["present"],
        "refreshKeys": ["explorerModel", "modelReasoningEffort"],
        "skillKey": "codex-explore"
      },
      {
        "id": "codex-explore-agent-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["explorerModel", "modelReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore-agent"
      }
    ]
  }
}
