{
  "name": "codex-explore",
  "version": "0.1.15",
  "description": "为 Codex 提供只读探索工作流，适合跨代码、文档、日志和网页整理证据。",
  "compatibility": {
    "aw": {
      "minVersion": "0.0.0"
    }
  },
  "skillTriggers": {
    "codex-explore": {
      "defaultTrigger": "auto",
      "allowDynamicTrigger": true
    }
  },
  "marketplace": {
    "category": "workflow",
    "tags": ["codex", "explorer", "research"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": ["CODEX"]
    }
  },
  "interface": {
    "displayName": "Codex Explore",
    "shortDescription": "Codex 只读探索与证据整理",
    "capabilities": ["Skills", "Instructions", "Agents"]
  },
  "extensions": {
    "instructions": [
      {
        "name": "delegation-authorization",
        "title": "Codex Explore 子代理授权",
        "content": "调用 `codex-explore` 技能且 Gate 通过时，视为用户同意在该工作流中启用子代理；Gate 未通过时不得启动子代理。"
      }
    ]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": ["./scripts/render-artifacts.test.mjs"]
    }
  },
  "config": {
    "schema": {
      "explorerModel": {
        "type": "string",
        "title": "探索模型",
        "default": "gpt-5.6-luna",
        "description": "Codex Explore 专用 role 使用的默认模型。"
      },
      "modelReasoningEffort": {
        "type": "enum",
        "title": "探索推理强度",
        "values": ["low", "medium", "high", "xhigh", "max"],
        "default": "medium",
        "description": "Codex Explore 专用 role 使用的推理强度。"
      },
      "minimumInitialWaitMinutes": {
        "type": "number",
        "title": "首次最小等待时间（分钟）",
        "default": 10,
        "min": 1,
        "max": 60,
        "description": "用户未明确指定时，主代理首次等待探索结果的最短时间。"
      },
      "convergenceWaitMinutes": {
        "type": "number",
        "title": "催促后等待时间（分钟）",
        "default": 5,
        "min": 1,
        "max": 30,
        "description": "主代理要求子代理尽快收敛后，再等待结果的时间。"
      }
    }
  },
  "buildConfig": {
    "fileRules": {
      "codex": {
        "include": ["templates/**"],
        "exclude": []
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "codex-explore-skill",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.skill",
        "projectManagedKind": "skill",
        "states": ["present"],
        "refreshKeys": [
          "explorerModel",
          "modelReasoningEffort",
          "minimumInitialWaitMinutes",
          "convergenceWaitMinutes"
        ],
        "skillKey": "codex-explore"
      },
      {
        "id": "codex-explore-agent-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["explorerModel", "modelReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explore-agent"
      }
    ]
  }
}
