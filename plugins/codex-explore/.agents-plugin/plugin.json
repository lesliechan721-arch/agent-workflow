{
  "name": "codex-explore",
  "version": "0.1.0",
  "description": "为 Codex 提供轻量指令和只读代码库探索流程。",
  "skills": "./skills",
  "skillTriggers": {
    "codex-explore": {
      "allowInstallOverride": true
    }
  },
  "marketplace": {
    "category": "workflow",
    "tags": ["codex", "explorer", "research"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": ["CODEX"]
    }
  },
  "interface": {
    "displayName": "Codex Explore",
    "shortDescription": "Codex 只读代码库探索",
    "capabilities": ["Skills"]
  },
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "tests": {
      "node": ["./scripts/render-artifacts.test.mjs"]
    }
  },
  "config": {
    "schema": {
      "enableLightweightInstruction": {
        "type": "boolean",
        "title": "启用轻量指令",
        "default": true,
        "description": "是否安装轻量指令，让主 Codex agent 使用内置 explorer role。"
      },
      "explorerModel": {
        "type": "string",
        "title": "探索模型",
        "default": "gpt-5.4-mini",
        "description": "使用内置 explorer role 时传入的模型。"
      },
      "modelReasoningEffort": {
        "type": "enum",
        "title": "探索推理强度",
        "values": ["low", "medium", "high", "xhigh"],
        "default": "medium",
        "description": "启动 explorer 任务时传入的推理强度。"
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "lightweight-instruction",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.developerInstructionsBlock",
        "projectManagedKind": "instruction",
        "states": ["present", "disabled"],
        "refreshKeys": ["enableLightweightInstruction", "explorerModel", "modelReasoningEffort"],
        "requiresCodexProjectConfig": true
      },
      {
        "id": "codex-explorer-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["explorerModel", "modelReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explorer"
      }
    ]
  },
  "buildConfig": {
    "fileRules": {
      "codex": {
        "include": ["instructions/**", "roles/**"],
        "exclude": []
      }
    }
  }
}
