      "subagentCommands": {
        "type": "array",
        "title": "外部执行器",
        "description": "注册可信内建或自定义工作区适配器；key 大小写敏感，native 为保留值。配置不替代任务授权。",
        "default": [],
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "required": true,
              "validation": {
                "minLength": 1
              }
            },
            "adapter": {
              "type": "string",
              "required": true,
              "choices": {
                "allowCustom": false,
                "presets": [
                  {
                    "id": "codex",
                    "title": "codex",
                    "value": "codex"
                  },
                  {
                    "id": "claude-code",
                    "title": "claude-code",
                    "value": "claude-code"
                  },
                  {
                    "id": "antigravity",
                    "title": "antigravity",
                    "value": "antigravity"
                  },
                  {
                    "id": "custom",
                    "title": "custom",
                    "value": "custom"
                  },
                  {
                    "id": "custom-managed",
                    "title": "自定义（托管命令）",
                    "value": "custom-managed"
                  }
                ]
              }
            },
            "description": {
              "type": "string",
              "title": "执行器说明",
              "description": "给主代理参考的定位或选型提示，会渲染在选型与自省的可用执行器表中。",
              "validation": {
                "minLength": 1,
                "maxLength": 512
              }
            },
            "modelsPolicy": {
              "type": "string",
              "title": "模型目录策略",
              "description": "省略时为 merge（动态自省与静态 models 合并补充）；设为 override 且 models 非空时，直接以静态 models 为生效目录并跳过动态探测。",
              "choices": {
                "allowCustom": false,
                "presets": [
                  {
                    "id": "merge",
                    "title": "合并补充（默认）",
                    "value": "merge",
                    "recommended": true
                  },
                  {
                    "id": "override",
                    "title": "静态白名单覆盖",
                    "value": "override"
                  }
                ]
              }
            },
            "models": {
              "type": "array",
              "title": "静态模型声明",
              "description": "可选。内建执行器可留空由动态自省获取；填写后在 merge 模式下补充/覆盖说明并作为离线兜底，在 override 模式下作为生效白名单。",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "title": "模型 ID",
                    "required": true,
                    "validation": {
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "description": {
                    "type": "string",
                    "title": "适用说明",
                    "validation": {
                      "minLength": 1,
                      "maxLength": 512
                    }
                  },
                  "efforts": {
                    "type": "array",
                    "title": "支持的推理强度",
                    "items": {
                      "type": "string",
                      "validation": {
                        "minLength": 1,
                        "maxLength": 64
                      }
                    },
                    "validation": {
                      "maxItems": 16,
                      "uniqueItems": true
                    }
                  },
                  "default": {
                    "type": "boolean",
                    "title": "默认模型"
                  }
                },
                "additionalProperties": false
              },
              "validation": {
                "maxItems": 64,
                "uniqueBy": "id"
              }
            },
            "communication": {
              "type": "boolean",
              "title": "父子通讯",
              "description": "省略时开启；设为 false 时不建立 AW 通讯桥，也不注入通讯工具和指令。开启仍须通过本次适配器能力检查。"
            },
            "resume": {
              "type": "boolean",
              "title": "恢复执行",
              "description": "省略时开启；允许向已结束的代理发送新消息来恢复原会话。与父子通讯独立，开启仍须通过适配器能力检查。"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string",
                "validation": {
                  "maxLength": 4096,
                  "pattern": "^[^\\x00]*$"
                }
              },
              "validation": {
                "maxItems": 128
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "validation": {
                  "maxLength": 4096,
                  "pattern": "^[^\\x00]*$"
                }
              },
              "validation": {
                "key": {
                  "maxLength": 4096,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            },
            "envFrom": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "validation": {
                  "maxLength": 4096,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "validation": {
                "key": {
                  "maxLength": 4096,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            }
          },
          "additionalProperties": false,
          "variants": {
            "discriminator": "adapter",
            "cases": {
              "codex": {
                "properties": {
                  "codexProfile": {
                    "type": "string",
                    "title": "Codex 配置 Profile",
                    "description": "从本次有效 CODEX_HOME 读取同名 .config.toml，完整传递配置；AW 显式 model/effort 仍优先。",
                    "validation": {
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^[^\\x00]*[^\\s\\x00][^\\x00]*$"
                    }
                  },
                  "codexCliSource": {
                    "type": "string",
                    "title": "Codex CLI 来源",
                    "description": "省略时使用 auto：先查 PATH，仅没有可执行入口时查 App 内嵌 CLI。cli 只查 PATH；app 只查 App。",
                    "choices": {
                      "allowCustom": false,
                      "presets": [
                        {
                          "id": "auto",
                          "title": "auto",
                          "value": "auto",
                          "recommended": true
                        },
                        {
                          "id": "cli",
                          "title": "cli",
                          "value": "cli"
                        },
                        {
                          "id": "app",
                          "title": "app",
                          "value": "app"
                        }
                      ]
                    }
                  },
                  "codexBypassHookTrust": {
                    "type": "boolean",
                    "title": "跳过 Codex Hook 信任检查",
                    "description": "省略时关闭。设为 true 会执行本次线程已启用但未受信任或内容已修改的普通 hook；不授予工具审批或沙箱绕过权限。"
                  },
                  "permissionMode": {
                    "type": "string",
                    "title": "权限模式",
                    "description": "省略时为默认，保留用户和项目权限。自动使用后端自动审批；完整权限使用官方 bypass，Codex 同时取消自身沙箱。与父子通讯及 Hook 信任独立。",
                    "choices": {
                      "allowCustom": false,
                      "presets": [
                        {
                          "id": "default",
                          "title": "默认",
                          "value": "default",
                          "recommended": true
                        },
                        {
                          "id": "auto",
                          "title": "自动",
                          "value": "auto"
                        },
                        {
                          "id": "full-access",
                          "title": "完整权限",
                          "value": "full-access"
                        }
                      ]
                    }
                  }
                }
              },
              "claude-code": {
                "properties": {
                  "permissionMode": {
                    "type": "string",
                    "title": "权限模式",
                    "description": "省略时为默认，保留用户和项目权限。自动使用后端自动审批；完整权限使用官方 bypass，Codex 同时取消自身沙箱。与父子通讯及 Hook 信任独立。",
                    "choices": {
                      "allowCustom": false,
                      "presets": [
                        {
                          "id": "default",
                          "title": "默认",
                          "value": "default",
                          "recommended": true
                        },
                        {
                          "id": "auto",
                          "title": "自动",
                          "value": "auto"
                        },
                        {
                          "id": "full-access",
                          "title": "完整权限",
                          "value": "full-access"
                        }
                      ]
                    }
                  }
                }
              },
              "antigravity": {
                "properties": {
                  "permissionMode": {
                    "type": "string",
                    "title": "权限模式",
                    "description": "省略时为默认，保留用户和项目权限。自动使用后端自动审批；完整权限使用官方 bypass，Codex 同时取消自身沙箱。与父子通讯及 Hook 信任独立。",
                    "choices": {
                      "allowCustom": false,
                      "presets": [
                        {
                          "id": "default",
                          "title": "默认",
                          "value": "default",
                          "recommended": true
                        },
                        {
                          "id": "auto",
                          "title": "自动",
                          "value": "auto"
                        },
                        {
                          "id": "full-access",
                          "title": "完整权限",
                          "value": "full-access"
                        }
                      ]
                    }
                  }
                }
              },
              "custom": {
                "properties": {
                  "command": {
                    "type": "string",
                    "required": true,
                    "validation": {
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
                    }
                  },
                  "entrypoint": {
                    "type": "string",
                    "validation": {
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
                    }
                  }
                }
              },
              "custom-managed": {
                "properties": {
                  "commandId": {
                    "type": "string",
                    "title": "托管命令名称或 ID",
                    "description": "支持 <来源>/<插件>、<来源>/<插件>/<平台>（目标包需配置时）或用户命令 cmdu_… ID。",
                    "required": true,
                    "validation": {
                      "maxLength": 256,
                      "pattern": "^(?:[a-z][a-z0-9-]{0,31}/[a-z0-9]+(?:-[a-z0-9]+)*(?:/(?:codex|claude|antigravity|cursor|opencode|pi|copilot|grok))?|cmdu_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
                    }
                  },
                  "subcommand": {
                    "type": "string",
