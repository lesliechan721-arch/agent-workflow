{
  "schemaVersion": 4,
  "name": "agent-subagent",
  "version": "0.2.0-beta.1",
  "description": "组织已授权的通用子代理委派、原生与外部执行器自省、执行配置与跨平台调度。",
  "marketplace": {
    "category": "workflow",
    "tags": [
      "subagent",
      "delegation",
      "execution",
      "introspection"
    ],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL"
    }
  },
  "requires": {
    "aw": {
      "capabilities": [
        "aw.cli-output.v2",
        "aw.managed-commands.v2",
        "aw.native-tools.v3",
        "aw.platform-components.v3",
        "aw.platform-render-context.v2",
        "aw.plugin-build-config.v1",
        "aw.plugin-config-array.v1",
        "aw.plugin-config-suggestions.v1",
        "aw.plugin-config-summary.v1",
        "aw.plugin-config-unique-by.v1",
        "aw.plugin-config-value-ref.v1",
        "aw.plugin-config.v2",
        "aw.plugin-config.v3",
        "aw.plugin-config.v4",
        "aw.plugin-config.v5",
        "aw.plugin-manifest.v4",
        "aw.portable-skills.v1"
      ]
    }
  },
  "platforms": [
    "codex",
    "claude",
    "antigravity",
    "cursor",
    "opencode",
    "pi",
    "copilot",
    "grok",
    "generic"
  ],
  "interface": {
    "displayName": "Agent Subagent",
    "shortDescription": "通用子代理委派、执行器自省与跨平台调度",
    "capabilities": [
      "Skills",
      "Agents"
    ]
  },
  "extensions": {
    "permissions": [
      {
        "name": "subagent-commands",
        "allow": [
          {
            "argsPrefix": [
              "start"
            ]
          },
          {
            "argsPrefix": [
              "send"
            ]
          },
          {
            "argsPrefix": [
              "wait"
            ]
          },
          {
            "argsPrefix": [
              "result"
            ]
          },
          {
            "argsPrefix": [
              "stop"
            ]
          },
          {
            "argsPrefix": [
              "inspect"
            ]
          }
        ]
      }
    ]
  },
  "buildConfig": {
    "fileRules": {
      "codex": {
        "include": [
          "skills/spawn-subagent/evals/fixtures/*.mjs"
        ],
        "exclude": []
      }
    }
  },
  "scripts": {
    "node": {
      "packageRoot": "./scripts"
    },
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    },
    "config": {
      "suggestions": {
        "runner": "node",
        "path": "./scripts/config-suggestions.mjs",
        "timeoutMs": 10000
      }
    }
  },
  "config": {
    "schemaVersion": 5,
    "fields": {
      "simpleTaskProfile": {
        "type": "object",
        "title": "简单任务配置",
        "description": "simple 档位的执行器、模型与推理强度偏好；默认沿用宿主原生默认。",
        "default": {
          "executor": "native"
        },
        "required": true,
        "properties": {
          "executor": {
            "type": "string",
            "title": "执行器",
            "description": "native 或 subagentCommands 中的稳定 key；省略时按 native 解释。",
            "valueRef": {
              "field": "subagentCommands",
              "key": "key",
              "include": [
                "native"
              ]
            },
            "validation": {
              "minLength": 1
            }
          },
          "model": {
            "type": "string",
            "title": "模型",
            "description": "留空沿用宿主/后端默认；外部执行器留空时可在调度期通过 inspect 按任务难度自省选型。",
            "suggestions": {
              "provider": "executor-models",
              "dependsOn": [
                "executor"
              ]
            },
            "validation": {
              "minLength": 1
            }
          },
          "reasoningEffort": {
            "type": "string",
            "title": "推理强度",
            "description": "推理强度偏好；留空沿用宿主/后端默认，实际支持范围由所选执行器与模型决定。",
            "suggestions": {
              "provider": "executor-efforts",
              "dependsOn": [
                "executor",
                "model"
              ]
            },
            "choices": {
              "allowCustom": true,
              "presets": [
                {
                  "id": "low",
                  "title": "low",
                  "value": "low"
                },
                {
                  "id": "medium",
                  "title": "medium",
                  "value": "medium"
                },
                {
                  "id": "high",
                  "title": "high",
                  "value": "high"
                },
                {
                  "id": "xhigh",
                  "title": "xhigh",
                  "value": "xhigh"
                },
                {
                  "id": "max",
                  "title": "max",
                  "value": "max"
                }
              ]
            },
            "validation": {
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      },
