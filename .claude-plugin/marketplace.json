      "interface": {
        "displayName": "Agent Content Toolkit",
        "shortDescription": "创建和评审 Agent-facing 文档，控制上下文负担、指针与完成边界",
        "capabilities": [
          "Skills"
        ]
      },
      "category": "workflow",
      "strict": true,
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL",
        "products": [
          "CODEX",
          "CLAUDE"
        ]
      }
    },
    {
      "name": "agent-skill-toolkit",
      "source": "./plugins/agent-skill-toolkit",
      "description": "使用共享标准创建或评审单个 Agent Skill，设计或审核 Skill Eval，并评审有界的跨 Skill 工作流。",
      "interface": {
        "displayName": "Agent Skill Toolkit",
        "shortDescription": "创建和评审 Agent Skill，设计和审核 Eval 与跨 Skill 工作流",
        "capabilities": [
          "Skills"
        ]
      },
      "category": "workflow",
      "strict": true,
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL",
        "products": [
          "CODEX",
          "CLAUDE"
