{
  "name": "aw",
  "owner": {
    "name": "Leslie Chan",
    "url": "https://github.com/lesliechan721-arch/agent-workflow"
  },
  "interface": {
    "displayName": "Agent Workflows"
  },
  "plugins": [
    {
      "name": "agent-content-toolkit",
      "source": "./plugins/agent-content-toolkit",
      "description": "创建、修改或评价给 Agent 读取的内容；统一事实依据、指针、信息层级、最小控制、完成条件、输出需要与剪枝方法。",
      "interface": {
        "displayName": "Agent Content Toolkit",
        "shortDescription": "设计和评价最小、可达、可执行的 Agent-facing 内容",
        "capabilities": [
          "Skills"
        ]
      },
      "category": "workflow",
      "strict": true,
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL",
        "products": [
          "CODEX",
          "CLAUDE"
        ]
      }
    },
    {
      "name": "agent-skill-toolkit",
      "source": "./plugins/agent-skill-toolkit",
      "description": "创建、评审和简化 Agent Skill，独立审核 Skill Eval，并评审跨 Skill 工作流与公开能力架构。",
      "interface": {
        "displayName": "Agent Skill Toolkit",
        "shortDescription": "创建、评审、简化 Agent Skill，并审核 Eval 与工作流架构",
        "capabilities": [
          "Skills"
        ]
      },
      "category": "workflow",
      "strict": true,
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL",
        "products": [
          "CODEX",
          "CLAUDE"
        ]
      }
    },
    {
      "name": "aw-development-toolkit",
      "source": "./plugins/aw-development-toolkit",
      "description": "创建和维护 AW Catalog/Plugin，按对象分支只读评审 AW 项目，并通过 manual-only 入口发布 Catalog。",
      "interface": {
        "displayName": "AW Development Toolkit",
        "shortDescription": "开发、评审和显式发布 AW Catalog 与 Plugin",
        "capabilities": [
          "Skills"
        ]
      },
      "category": "workflow",
      "strict": true,
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL",
        "products": [
          "CODEX",
          "CLAUDE"
        ]
      }
    },
    {
      "name": "aw-skill-eval-runner",
      "source": "./plugins/aw-skill-eval-runner",
      "description": "准备、独立审核并通过 aw-skill-eval 执行 Agent Skill Eval，验证结果并按需归因异常。",
      "interface": {
        "displayName": "AW Skill Eval Runner",
        "shortDescription": "准备、审核并执行 Agent Skill Eval，验证结果",
        "capabilities": [
          "Skills"
        ]
      },
      "category": "workflow",
      "strict": true,
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL",
        "products": [
          "CODEX",
          "CLAUDE"
        ]
      }
    },
    {
      "name": "browser-use",
      "source": "./plugins/browser-use",
      "description": "以精简的浏览器技能完成网页预览、浏览、交互、截图和按需调试。",
      "interface": {
        "displayName": "Browser Use",
        "shortDescription": "轻量网页预览、浏览、交互与检查",
        "capabilities": [
          "Skills"
        ]
      },
      "category": "workflow",
      "strict": true,
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL",
        "products": [
          "CODEX",
          "CLAUDE"
        ]
      }
    },
    {
      "name": "decision-kit",
      "source": "./plugins/decision-kit",
      "description": "主题对齐、可体验决策与项目领域知识维护；按需组合，保留真实确认与清楚的独立职责。",
      "interface": {
        "displayName": "Decision Kit",
        "shortDescription": "对齐重要选择，验证原型，维护领域语言与决定",
        "capabilities": [
          "Skills"
        ]
      },
      "category": "workflow",
      "strict": true,
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "dev-workflow",
      "source": "./plugins/dev-workflow",
      "description": "从需求设计到实现交付的可组合工作流，项目规范与本地过程资料分工清楚。",
      "interface": {
        "displayName": "Dev Workflow",
        "shortDescription": "先设计或完整交付；本地恢复、独立审查和有界修复",
        "capabilities": [
          "Skills"
        ]
      },
      "category": "workflow",
      "tags": [
        "development",
        "spec",
        "implementation",
        "review"
      ],
      "strict": true,
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    },
    {
      "name": "git-toolkit",
      "source": "./plugins/git-toolkit",
      "description": "提供本地 Git 提交、worktree 隔离，以及需要协调双方意图的 Git merge 工作流。",
      "interface": {
        "displayName": "Git Toolkit",
        "shortDescription": "精确创建本地提交、安全隔离 Git worktree，或协调 Git merge 双方意图",
        "capabilities": [
          "Skills"
        ]
      },
      "category": "workflow",
      "tags": [
        "git",
        "commit",
        "worktree",
        "merge",
        "conflicts"
      ],
      "strict": true,
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    }
  ]
}
