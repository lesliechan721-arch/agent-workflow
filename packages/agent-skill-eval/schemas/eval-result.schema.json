{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-eval.invalid/schemas/eval-result.schema.json",
  "title": "EvalResult",
  "type": "object",
  "required": ["version", "specDigest", "auditDigest", "targetDigest", "caseDigest", "provider", "startedAt", "finishedAt", "runs", "summary"],
  "properties": {
    "version": { "const": 1 },
    "specDigest": { "$ref": "#/$defs/digest" },
    "auditDigest": { "$ref": "#/$defs/digest" },
    "targetDigest": { "$ref": "#/$defs/digest" },
    "caseDigest": { "$ref": "#/$defs/digest" },
    "provider": { "$ref": "#/$defs/provider" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseId", "variant", "attempt", "status", "durationMs", "outputDir", "usage", "grade", "error"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "variant": { "enum": ["current", "without-skill", "previous-version"] },
          "attempt": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["completed", "failed", "timeout"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "outputDir": { "$ref": "#/$defs/relativePath" },
          "usage": { "type": ["object", "null"] },
          "grade": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["passed", "score"],
                "properties": {
                  "passed": { "type": "boolean" },
                  "score": { "type": ["number", "null"] },
                  "details": { "type": "object" }
                },
                "additionalProperties": false
              }
            ]
          },
          "error": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            ]
          },
          "artifacts": {
            "$ref": "#/$defs/workflowArtifacts"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["passed", "failed", "timeout", "error"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "codex-workflow" } }
          }
        }
      },
      "then": {
        "properties": {
          "runs": {
            "items": {
              "if": { "properties": { "status": { "const": "completed" } } },
              "then": {
                "required": ["artifacts"],
                "properties": { "usage": { "type": "object" } }
              },
              "else": { "not": { "required": ["artifacts"] } }
            }
          }
        }
      },
      "else": {
        "properties": {
          "runs": { "items": { "not": { "required": ["artifacts"] } } }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "workflowArtifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["path", "role"],
            "properties": {
              "path": { "const": "workflow-evidence.json" },
              "role": { "const": "evidence" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["path", "role"],
            "properties": {
              "path": { "const": "workflow-trace.json" },
              "role": { "const": "trace" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["path", "role"],
            "properties": {
              "path": { "const": "model-output.txt" },
              "role": { "const": "output" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["path", "role"],
            "properties": {
              "path": { "const": "provider-result.json" },
              "role": { "const": "result" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "provider": {
      "oneOf": [
        { "enum": ["codex-trigger", "codex-conversation"] },
        {
          "type": "object",
          "required": ["type", "command"],
          "properties": {
            "type": { "const": "custom-process" },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "command", "allowedModels"],
          "properties": {
            "type": { "const": "codex-workflow" },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "allowedModels": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
