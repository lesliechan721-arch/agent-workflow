{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-eval.invalid/schemas/aw-skill-eval-execution-plan.schema.json",
  "title": "AwSkillEvalExecutionPlan",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "target",
    "cases",
    "provider",
    "runtimeInputs",
    "configurations",
    "runsPerCase",
    "timeoutMs",
    "outputRoot",
    "capture"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "planId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "minimumEvidenceLevel": { "enum": ["executed", "comparative"] },
    "target": {
      "type": "object",
      "required": ["name", "path", "digest"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "object",
      "required": ["paths", "corpusDigest"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "corpusDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": [
        "id",
        "command",
        "describeCommand",
        "capabilitiesPath",
        "capabilitiesDigest",
        "inheritEnvironment"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "describeCommand": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "type": ["string", "null"] },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "capabilitiesPath": { "type": "string", "minLength": 1 },
        "capabilitiesDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "inheritEnvironment": { "type": "boolean" },
        "environmentAllowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "runtimeInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path", "digest"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": { "const": "directory" },
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skillMode", "comparisonId"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "skillMode": { "enum": ["with-skill", "without-skill", "previous-version"] },
          "comparisonId": {
            "type": ["string", "null"],
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "skillPath": { "type": ["string", "null"] },
          "skillDigest": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "runsPerCase": { "type": "integer", "minimum": 1 },
    "timeoutMs": { "type": "integer", "minimum": 1000 },
    "outputRoot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "capture": {
      "type": "object",
      "required": ["outputs", "trace", "timing", "usage"],
      "properties": {
        "outputs": { "type": "boolean" },
        "trace": { "type": "boolean" },
        "timing": { "type": "boolean" },
        "usage": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
