{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aw.dev/schemas/workflow-fixture-action.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "input"],
  "properties": {
    "command": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{ "const": "node" }, { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//).+$" }]
    },
    "input": {},
    "pathPrepend": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//).+$" } }
  }
}
