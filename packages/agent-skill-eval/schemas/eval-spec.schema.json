{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-eval.invalid/schemas/eval-spec.schema.json",
  "title": "EvalSpec",
  "type": "object",
  "required": ["version", "source", "workspace", "target", "cases", "provider", "runs", "timeoutMs", "baseline", "outputDir"],
  "properties": {
    "version": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["plugin", "skill", "suite", "profile"],
      "properties": {
        "plugin": { "type": "string", "minLength": 1 },
        "skill": { "type": "string", "minLength": 1 },
        "suite": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "workspace": { "$ref": "#/$defs/pathDigest" },
    "target": { "$ref": "#/$defs/pathDigest" },
    "cases": { "$ref": "#/$defs/pathDigest" },
    "provider": {
      "oneOf": [
        { "enum": ["codex-trigger", "codex-conversation"] },
        {
          "type": "object",
          "required": ["type", "command"],
          "properties": {
            "type": { "const": "custom-process" },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "runs": { "type": "integer", "minimum": 1 },
    "timeoutMs": { "type": "integer", "minimum": 1 },
    "baseline": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "none" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "without-skill" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "target"],
          "properties": {
            "type": { "const": "previous-version" },
            "target": { "$ref": "#/$defs/pathDigest" }
          },
          "additionalProperties": false
        }
      ]
    },
    "outputDir": { "$ref": "#/$defs/relativePath" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "pathDigest": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
