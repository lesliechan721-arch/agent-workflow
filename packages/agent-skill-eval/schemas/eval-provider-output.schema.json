{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-eval.invalid/schemas/eval-provider-output.schema.json",
  "title": "EvalProviderOutput",
  "type": "object",
  "required": ["schemaVersion", "provider", "usage", "grading", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "usage": { "type": ["object", "null"] },
    "grading": { "type": ["object", "null"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["trace", "report", "output", "other"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
