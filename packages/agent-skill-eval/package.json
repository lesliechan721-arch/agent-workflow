{
  "name": "@lesliechan721/agent-skill-eval",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "aw-skill-eval": "./dist/bin.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/embed-schemas.mjs",
    "build:dev": "tsc -p tsconfig.dev.json && node scripts/embed-schemas.mjs",
    "windows-job:refresh": "node scripts/refresh-windows-job-helper.mjs",
    "windows-job:reproducibility": "node scripts/reproduce-windows-job-helper.mjs",
    "windows-job:verify": "node scripts/verify-windows-job-helper.mjs",
    "test": "pnpm run test:unit",
    "test:unit": "node ../../scripts/test/run-vitest.mjs run --project pure --maxWorkers=2 && node ../../scripts/test/run-vitest.mjs run --project filesystem-isolated --maxWorkers=2 && node ../../scripts/test/run-vitest.mjs run --project process-lifecycle --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:dist": "node ../../scripts/test/run-vitest.mjs run --config vitest.dist.config.ts",
    "prepublishOnly": "node ../../scripts/release/reject-direct-publish.mjs"
  },
  "dependencies": {
    "fs-extra": "^11.3.0",
    "toml-eslint-parser": "^1.0.3"
  },
  "optionalDependencies": {
    "@lesliechan721/aw-windows-job-win32-arm64": "workspace:0.1.0",
    "@lesliechan721/aw-windows-job-win32-x64": "workspace:0.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
