{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-workflows.dev/plugin-manifest-v3.json",
  "title": "PluginManifestSourceV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "version", "description", "marketplace"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "requires": { "$ref": "#/$defs/requires" },
    "skills": { "$ref": "#/$defs/pluginPath" },
    "slashCommands": { "$ref": "#/$defs/pluginPath" },
    "mcpServers": { "$ref": "#/$defs/pluginPath" },
    "apps": { "$ref": "#/$defs/pluginPath" },
    "distributions": { "$ref": "#/$defs/distributions" },
    "marketplace": { "$ref": "#/$defs/marketplace" },
    "interface": { "$ref": "#/$defs/interface" },
    "extensions": { "$ref": "#/$defs/extensions" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "buildConfig": { "$ref": "#/$defs/buildConfig" },
    "scripts": { "$ref": "#/$defs/scripts" },
    "config": { "$ref": "#/$defs/config" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|(?:[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:0|[1-9][0-9]*|(?:[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "pluginPath": {
      "type": "string",
      "pattern": "^\\./"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aw"],
      "properties": {
        "aw": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^aw\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\.v[1-9][0-9]*$"
              }
            }
          }
        }
      }
    },
    "runtimeExportRequires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aw"],
      "properties": {
        "aw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilities"],
          "properties": {
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^aw\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\.v[1-9][0-9]*$"
              }
            }
          }
        }
      }
    },
    "distributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentSkills": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": { "$ref": "#/$defs/pluginPath" }
          }
        }
      }
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "strict", "policy"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "strict": { "type": "boolean" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["installation", "authentication"],
          "properties": {
            "installation": { "enum": ["AVAILABLE", "NOT_AVAILABLE", "INSTALLED_BY_DEFAULT"] },
            "authentication": { "enum": ["ON_INSTALL", "ON_USE"] },
            "products": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "platformOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "claude": { "type": ["object", "null"] }, "codex": { "type": ["object", "null"] } }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "content"],
      "properties": {
        "name": { "type": "string" }, "title": { "type": "string" }, "content": { "type": "string" },
        "paths": { "$ref": "#/$defs/stringArray" }, "agentOverrides": { "$ref": "#/$defs/platformOverrides" }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" }, "allow": { "$ref": "#/$defs/stringArray" },
        "ask": { "$ref": "#/$defs/stringArray" }, "deny": { "$ref": "#/$defs/stringArray" },
        "agentOverrides": { "$ref": "#/$defs/platformOverrides" }
      }
    },
    "hook": {
      "type": "object", "additionalProperties": false, "required": ["event", "command"],
      "properties": {
        "event": { "type": "string" }, "matcher": { "type": "string" }, "command": { "type": "string" },
        "agentOverrides": { "$ref": "#/$defs/platformOverrides" }
      }
    },
    "nativeHook": {
      "type": "object", "additionalProperties": false, "required": ["event", "command"],
      "properties": { "event": { "type": "string" }, "matcher": { "type": "string" }, "command": { "type": "string" } }
    },
    "agent": {
      "type": "object", "additionalProperties": false, "required": ["name", "description", "prompt"],
      "properties": {
        "name": { "type": "string" }, "description": { "type": "string" }, "prompt": { "type": "string" },
        "tools": { "$ref": "#/$defs/stringArray" }, "agentOverrides": { "$ref": "#/$defs/platformOverrides" }
      }
    },
    "extensions": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "instructions": { "type": "array", "items": { "$ref": "#/$defs/instruction" } },
        "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
        "hooks": { "type": "array", "items": { "$ref": "#/$defs/hook" } },
        "nativeHooks": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "claude": { "type": "array", "items": { "$ref": "#/$defs/nativeHook" } },
            "codex": { "type": "array", "items": { "$ref": "#/$defs/nativeHook" } }
          }
        },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/agent" } }
      }
    },
    "importReference": {
      "type": "object", "additionalProperties": false, "required": ["plugin", "export"],
      "properties": { "plugin": { "type": "string" }, "export": { "type": "string" } }
    },
    "codexSkillDelivery": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["mode", "identity", "renderProfile"],
          "properties": {
            "mode": { "const": "codex-native" }, "identity": { "const": "shared" }, "renderProfile": { "const": "user" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["mode"],
          "properties": { "mode": { "const": "aw-extension" } }
        }
      ]
    },
    "artifactRuntimeImports": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "plugin", "export"],
        "properties": {
          "name": { "type": "string" }, "plugin": { "type": "string" }, "export": { "type": "string" },
          "resolved": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "digest", "providerPluginId", "providerVersion", "source", "requiredCapabilities", "capabilitySetDigest"],
            "properties": {
              "path": { "type": "string" }, "digest": { "type": "string" }, "providerPluginId": { "type": "string" },
              "providerVersion": { "$ref": "#/$defs/semver" }, "source": { "type": "string" },
              "requiredCapabilities": { "$ref": "#/$defs/runtimeExportRequires/properties/aw/properties/capabilities" },
              "capabilitySetDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "artifactTarget": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "scopes", "target", "states", "refreshKeys", "delivery"],
          "properties": {
            "id": { "type": "string" }, "platform": { "enum": ["codex", "claude"] },
            "distribution": { "const": "agent-skills" }, "scopes": { "type": "array", "items": { "enum": ["user", "project"] } },
            "target": { "const": "codex.skill" }, "kind": { "enum": ["instruction", "codexRole", "skill"] },
            "projectManagedKind": { "enum": ["skill", "mcpServer", "instruction", "permission", "hook", "agent"] },
            "states": { "type": "array", "items": { "enum": ["present", "disabled"] } },
            "refreshKeys": { "$ref": "#/$defs/stringArray" }, "requiresCodexProjectConfig": { "type": "boolean" },
            "delivery": { "$ref": "#/$defs/codexSkillDelivery" },
            "roleKey": { "type": "string" }, "skillKey": { "type": "string" }, "sourceDirs": { "$ref": "#/$defs/stringArray" },
            "runtimeImports": { "$ref": "#/$defs/artifactRuntimeImports" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "scopes", "target", "states", "refreshKeys"],
          "properties": {
            "id": { "type": "string" }, "platform": { "enum": ["codex", "claude"] },
            "distribution": { "const": "agent-skills" }, "scopes": { "type": "array", "items": { "enum": ["user", "project"] } },
            "target": { "enum": ["codex.developerInstructionsBlock", "codex.agentRole", "claude.skill", "agent-skills.skill"] },
            "kind": { "enum": ["instruction", "codexRole", "skill"] },
            "projectManagedKind": { "enum": ["skill", "mcpServer", "instruction", "permission", "hook", "agent"] },
            "states": { "type": "array", "items": { "enum": ["present", "disabled"] } },
            "refreshKeys": { "$ref": "#/$defs/stringArray" }, "requiresCodexProjectConfig": { "type": "boolean" },
            "roleKey": { "type": "string" }, "skillKey": { "type": "string" }, "sourceDirs": { "$ref": "#/$defs/stringArray" },
            "runtimeImports": { "$ref": "#/$defs/artifactRuntimeImports" }
          }
        }
      ]
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "properties": { "targets": { "type": "array", "items": { "$ref": "#/$defs/artifactTarget" } } }
    },
    "fileRules": {
      "type": "object", "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": { "include": { "$ref": "#/$defs/stringArray" }, "exclude": { "$ref": "#/$defs/stringArray" } }
    },
    "buildConfig": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "cacheable": { "const": true },
        "templates": {
          "type": "object", "additionalProperties": false, "required": ["vars", "include"],
          "properties": {
            "vars": { "type": "object", "additionalProperties": { "$ref": "#/$defs/platformTemplateValue" } },
            "include": { "$ref": "#/$defs/stringArray" }
          }
        },
        "fileRules": {
          "type": "object", "additionalProperties": false,
          "properties": { "claude": { "$ref": "#/$defs/fileRules" }, "codex": { "$ref": "#/$defs/fileRules" } }
        },
        "manifestOverrides": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "claude": {
              "type": "object", "additionalProperties": false,
              "properties": { "commands": { "type": "string" }, "outputStyles": { "type": "string" }, "lspServers": {}, "userConfig": {}, "channels": {} }
            },
            "codex": { "type": "object", "maxProperties": 0 }
          }
        },
        "runtimeExports": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "source", "requires"], "properties": { "name": { "type": "string" }, "source": { "type": "string" }, "requires": { "$ref": "#/$defs/runtimeExportRequires" } } } },
        "buildImports": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["plugin", "export", "env"], "properties": { "plugin": { "type": "string" }, "export": { "type": "string" }, "env": { "type": "string" } } } },
        "skillRuntimeFiles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["skill", "target"], "properties": { "skill": { "type": "string" }, "target": { "type": "string" }, "platforms": { "type": "array", "items": { "enum": ["codex", "claude"] } }, "distributions": { "type": "array", "items": { "const": "agent-skills" } }, "source": { "type": "string" }, "import": { "$ref": "#/$defs/importReference" } } } },
        "generatedSkillRuntimeFiles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["skill", "target"], "properties": { "skill": { "type": "string" }, "target": { "type": "string" }, "distributions": { "type": "array", "items": { "const": "agent-skills" } } } } }
      }
    },
    "platformTemplateValue": {
      "type": "object", "additionalProperties": false, "required": ["claude", "codex"],
      "properties": {
        "claude": { "anyOf": [{ "type": "string" }, { "type": "boolean" }] },
        "codex": { "anyOf": [{ "type": "string" }, { "type": "boolean" }] }
      }
    },
    "scriptEntry": {
      "type": "object", "additionalProperties": false, "required": ["runner", "path"],
      "properties": { "runner": { "const": "node" }, "path": { "type": "string" }, "args": { "$ref": "#/$defs/stringArray" } }
    },
    "preApply": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/pluginPath" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 1800000 }
      }
    },
    "scripts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "preApply": { "$ref": "#/$defs/preApply" },
        "helpers": { "type": "object", "additionalProperties": false, "required": ["config"], "properties": { "config": { "type": "string" } } },
        "node": { "type": "object", "additionalProperties": false, "properties": { "packageRoot": { "type": "string" }, "build": { "$ref": "#/$defs/scriptEntry" } } },
        "artifacts": { "type": "object", "additionalProperties": false, "properties": { "render": { "$ref": "#/$defs/scriptEntry" } } },
        "tests": { "type": "object", "additionalProperties": false, "properties": { "node": { "$ref": "#/$defs/stringArray" } } }
      }
    },
    "configStringValidation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "pattern": { "type": "string", "maxLength": 512 },
        "format": { "enum": ["identifier", "slug", "semver", "url", "hostname", "email"] }
      },
      "if": { "properties": { "pattern": true }, "required": ["pattern"] },
      "then": { "properties": { "maxLength": true }, "required": ["maxLength"] }
    },
    "configNumberValidation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "integer": { "type": "boolean" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "multipleOf": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "configObjectValidation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "minProperties": { "type": "integer", "minimum": 0, "maximum": 32 },
        "maxProperties": { "type": "integer", "minimum": 0, "maximum": 32 },
        "key": { "$ref": "#/$defs/configStringValidation" }
      }
    },
    "configArrayValidation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "minItems": { "type": "integer", "minimum": 0, "maximum": 128 },
        "maxItems": { "type": "integer", "minimum": 0, "maximum": 128 },
        "uniqueItems": { "type": "boolean" }
      }
    },
    "configStringPreset": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }, "value": { "type": "string" }, "recommended": { "const": true }
      }
    },
    "configNumberPreset": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }, "value": { "type": "number" }, "recommended": { "const": true }
      }
    },
    "configBooleanPreset": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }, "value": { "type": "boolean" }, "recommended": { "const": true }
      }
    },
    "configObjectPreset": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "value": { "type": "object", "maxProperties": 32, "propertyNames": { "not": { "enum": ["__proto__", "constructor", "prototype"] } }, "additionalProperties": { "$ref": "#/$defs/configScalar" } },
        "recommended": { "const": true }
      }
    },
    "configStringChoices": {
      "type": "object", "additionalProperties": false, "required": ["allowCustom", "presets"],
      "not": { "properties": { "allowCustom": { "const": false }, "presets": { "type": "array", "maxItems": 0 } }, "required": ["allowCustom", "presets"] },
      "properties": {
        "allowCustom": { "type": "boolean" },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/configStringPreset" } }
      }
    },
    "configNumberChoices": {
      "type": "object", "additionalProperties": false, "required": ["allowCustom", "presets"],
      "not": { "properties": { "allowCustom": { "const": false }, "presets": { "type": "array", "maxItems": 0 } }, "required": ["allowCustom", "presets"] },
      "properties": {
        "allowCustom": { "type": "boolean" },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/configNumberPreset" } }
      }
    },
    "configBooleanChoices": {
      "type": "object", "additionalProperties": false, "required": ["allowCustom", "presets"],
      "not": { "properties": { "allowCustom": { "const": false }, "presets": { "type": "array", "maxItems": 0 } }, "required": ["allowCustom", "presets"] },
      "properties": {
        "allowCustom": { "type": "boolean" },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/configBooleanPreset" } }
      }
    },
    "configObjectChoices": {
      "type": "object", "additionalProperties": false, "required": ["allowCustom", "presets"],
      "not": { "properties": { "allowCustom": { "const": false }, "presets": { "type": "array", "maxItems": 0 } }, "required": ["allowCustom", "presets"] },
      "properties": {
        "allowCustom": { "type": "boolean" },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/configObjectPreset" } }
      }
    },
    "configScalar": {
      "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
    },
    "configArrayObjectValue": {
      "type": "object", "maxProperties": 32,
      "propertyNames": { "not": { "enum": ["__proto__", "constructor", "prototype"] } },
      "additionalProperties": { "$ref": "#/$defs/configScalar" }
    },
    "configArrayValue": {
      "anyOf": [
        { "type": "array", "maxItems": 128, "items": { "type": "string" } },
        { "type": "array", "maxItems": 128, "items": { "type": "number" } },
        { "type": "array", "maxItems": 128, "items": { "type": "boolean" } },
        { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/configArrayObjectValue" } }
      ]
    },
    "configArrayPreset": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }, "value": { "$ref": "#/$defs/configArrayValue" },
        "recommended": { "const": true }
      }
    },
    "configArrayChoices": {
      "type": "object", "additionalProperties": false, "required": ["allowCustom", "presets"],
      "not": { "properties": { "allowCustom": { "const": false }, "presets": { "type": "array", "maxItems": 0 } }, "required": ["allowCustom", "presets"] },
      "properties": {
        "allowCustom": { "type": "boolean" },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/configArrayPreset" } }
      }
    },
    "configStringField": {
      "oneOf": [
        { "$ref": "#/$defs/configPlainStringField" },
        { "$ref": "#/$defs/configSensitiveStringField" }
      ]
    },
    "configPlainStringField": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "string" }, "title": { "type": "string" }, "description": { "type": "string" },
        "default": { "type": "string" }, "required": { "type": "boolean" }, "sensitive": { "const": false },
        "choices": { "$ref": "#/$defs/configStringChoices" }, "validation": { "$ref": "#/$defs/configStringValidation" }
      }
    },
    "configSensitiveStringField": {
      "type": "object", "additionalProperties": false, "required": ["type", "sensitive"],
      "properties": {
        "type": { "const": "string" }, "title": { "type": "string" }, "description": { "type": "string" },
        "required": { "type": "boolean" }, "sensitive": { "const": true },
        "validation": { "$ref": "#/$defs/configStringValidation" }
      }
    },
    "configNumberField": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "number" }, "title": { "type": "string" }, "description": { "type": "string" },
        "default": { "type": "number" }, "required": { "type": "boolean" }, "sensitive": false,
        "choices": { "$ref": "#/$defs/configNumberChoices" }, "validation": { "$ref": "#/$defs/configNumberValidation" }
      }
    },
    "configBooleanField": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "boolean" }, "title": { "type": "string" }, "description": { "type": "string" },
        "default": { "type": "boolean" }, "required": { "type": "boolean" }, "sensitive": false,
        "choices": { "$ref": "#/$defs/configBooleanChoices" }
      }
    },
    "configScalarField": {
      "oneOf": [{ "$ref": "#/$defs/configStringField" }, { "$ref": "#/$defs/configNumberField" }, { "$ref": "#/$defs/configBooleanField" }]
    },
    "configScalarChildField": {
      "oneOf": [
        { "$ref": "#/$defs/configStringChildField" }, { "$ref": "#/$defs/configNumberChildField" }, { "$ref": "#/$defs/configBooleanChildField" }
      ]
    },
    "configStringChildField": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "string" }, "title": { "type": "string" }, "description": { "type": "string" },
        "required": { "type": "boolean" }, "sensitive": false,
        "choices": { "$ref": "#/$defs/configStringChoices" }, "validation": { "$ref": "#/$defs/configStringValidation" }
      }
    },
    "configNumberChildField": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "number" }, "title": { "type": "string" }, "description": { "type": "string" },
        "required": { "type": "boolean" }, "sensitive": false,
        "choices": { "$ref": "#/$defs/configNumberChoices" }, "validation": { "$ref": "#/$defs/configNumberValidation" }
      }
    },
    "configBooleanChildField": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "boolean" }, "title": { "type": "string" }, "description": { "type": "string" },
        "required": { "type": "boolean" }, "sensitive": false,
        "choices": { "$ref": "#/$defs/configBooleanChoices" }
      }
    },
    "configScalarDynamicField": {
      "oneOf": [
        { "$ref": "#/$defs/configStringDynamicField" }, { "$ref": "#/$defs/configNumberDynamicField" }, { "$ref": "#/$defs/configBooleanDynamicField" }
      ]
    },
    "configStringDynamicField": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "string" }, "title": { "type": "string" }, "description": { "type": "string" },
        "sensitive": false, "choices": { "$ref": "#/$defs/configStringChoices" },
        "validation": { "$ref": "#/$defs/configStringValidation" }
      }
    },
    "configNumberDynamicField": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "number" }, "title": { "type": "string" }, "description": { "type": "string" },
        "sensitive": false, "choices": { "$ref": "#/$defs/configNumberChoices" },
        "validation": { "$ref": "#/$defs/configNumberValidation" }
      }
    },
    "configBooleanDynamicField": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "const": "boolean" }, "title": { "type": "string" }, "description": { "type": "string" },
        "sensitive": false, "choices": { "$ref": "#/$defs/configBooleanChoices" }
      }
    },
    "configFixedObjectField": {
      "type": "object", "additionalProperties": false, "required": ["type", "properties"],
      "properties": {
        "type": { "const": "object" }, "title": { "type": "string" }, "description": { "type": "string" },
        "default": { "type": "object", "maxProperties": 32, "propertyNames": { "not": { "enum": ["__proto__", "constructor", "prototype"] } }, "additionalProperties": { "$ref": "#/$defs/configScalar" } },
        "required": { "type": "boolean" }, "sensitive": false,
        "choices": { "$ref": "#/$defs/configObjectChoices" },
        "properties": { "type": "object", "maxProperties": 32, "propertyNames": { "not": { "enum": ["__proto__", "constructor", "prototype"] } }, "additionalProperties": { "$ref": "#/$defs/configScalarChildField" } },
        "additionalProperties": { "const": false },
        "validation": { "$ref": "#/$defs/configObjectValidation" }
      }
    },
    "configKeyValueObjectField": {
      "type": "object", "additionalProperties": false, "required": ["type", "additionalProperties"],
      "properties": {
        "type": { "const": "object" }, "title": { "type": "string" }, "description": { "type": "string" },
        "default": { "type": "object", "maxProperties": 32, "propertyNames": { "not": { "enum": ["__proto__", "constructor", "prototype"] } }, "additionalProperties": { "$ref": "#/$defs/configScalar" } },
        "required": { "type": "boolean" }, "sensitive": false,
        "choices": { "$ref": "#/$defs/configObjectChoices" },
        "additionalProperties": { "$ref": "#/$defs/configScalarDynamicField" },
        "validation": { "$ref": "#/$defs/configObjectValidation" }
      }
    },
    "configObjectField": {
      "oneOf": [
        { "$ref": "#/$defs/configFixedObjectField" },
        { "$ref": "#/$defs/configKeyValueObjectField" }
      ]
    },
    "configField": {
      "oneOf": [
        { "$ref": "#/$defs/configStringField" }, { "$ref": "#/$defs/configNumberField" },
        { "$ref": "#/$defs/configBooleanField" }, { "$ref": "#/$defs/configObjectField" }
      ]
    },
    "configReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {
        "$ref": {"type": "string", "pattern": "^#/config/definitions/[A-Za-z][A-Za-z0-9_]*$"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "default": {
          "oneOf": [
            {"$ref": "#/$defs/configScalar"},
            {"$ref": "#/$defs/configArrayValue"},
            {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {"not": {"enum": ["__proto__", "constructor", "prototype"]}},
              "additionalProperties": {"$ref": "#/$defs/configScalar"}
            }
          ]
        },
        "required": {"type": "boolean"}
      }
    },
    "configChildReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {
        "$ref": {"type": "string", "pattern": "^#/config/definitions/[A-Za-z][A-Za-z0-9_]*$"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "required": {"type": "boolean"}
      }
    },
    "configDynamicReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {"$ref": {"type": "string", "pattern": "^#/config/definitions/[A-Za-z][A-Za-z0-9_]*$"}, "title": {"type": "string"}, "description": {"type": "string"}}
    },
    "configV3FixedObjectField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "object"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "default": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"not": {"enum": ["__proto__", "constructor", "prototype"]}},
          "additionalProperties": {"$ref": "#/$defs/configScalar"}
        },
        "required": {"type": "boolean"},
        "sensitive": false,
        "choices": {"$ref": "#/$defs/configObjectChoices"},
        "properties": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"not": {"enum": ["__proto__", "constructor", "prototype"]}},
          "additionalProperties": {"oneOf": [{"$ref": "#/$defs/configScalarChildField"}, {"$ref": "#/$defs/configChildReference"}]}
        },
        "additionalProperties": {"const": false},
        "validation": {"$ref": "#/$defs/configObjectValidation"}
      }
    },
    "configV3KeyValueObjectField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "additionalProperties"],
      "properties": {
        "type": {"const": "object"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "default": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"not": {"enum": ["__proto__", "constructor", "prototype"]}},
          "additionalProperties": {"$ref": "#/$defs/configScalar"}
        },
        "required": {"type": "boolean"},
        "sensitive": false,
        "choices": {"$ref": "#/$defs/configObjectChoices"},
        "additionalProperties": {"oneOf": [{"$ref": "#/$defs/configScalarDynamicField"}, {"$ref": "#/$defs/configDynamicReference"}]},
        "validation": {"$ref": "#/$defs/configObjectValidation"}
      }
    },
    "configArrayFixedObjectItem": {
      "type": "object", "additionalProperties": false, "required": ["type", "properties"],
      "properties": {
        "type": {"const": "object"}, "title": {"type": "string"}, "description": {"type": "string"},
        "sensitive": false,
        "choices": {"$ref": "#/$defs/configObjectChoices"},
        "properties": {
          "type": "object", "maxProperties": 32,
          "propertyNames": {"not": {"enum": ["__proto__", "constructor", "prototype"]}},
          "additionalProperties": {"oneOf": [{"$ref": "#/$defs/configScalarChildField"}, {"$ref": "#/$defs/configChildReference"}]}
        },
        "additionalProperties": {"const": false},
        "validation": {"$ref": "#/$defs/configObjectValidation"}
      }
    },
    "configArrayKeyValueObjectItem": {
      "type": "object", "additionalProperties": false, "required": ["type", "additionalProperties"],
      "properties": {
        "type": {"const": "object"}, "title": {"type": "string"}, "description": {"type": "string"},
        "sensitive": false,
        "choices": {"$ref": "#/$defs/configObjectChoices"},
        "additionalProperties": {"oneOf": [{"$ref": "#/$defs/configScalarDynamicField"}, {"$ref": "#/$defs/configDynamicReference"}]},
        "validation": {"$ref": "#/$defs/configObjectValidation"}
      }
    },
    "configArrayItemReference": {
      "type": "object", "additionalProperties": false, "required": ["$ref"],
      "properties": {
        "$ref": {"type": "string", "pattern": "^#/config/definitions/[A-Za-z][A-Za-z0-9_]*$"},
        "title": {"type": "string"}, "description": {"type": "string"}
      }
    },
    "configArrayItem": {
      "oneOf": [
        {"$ref": "#/$defs/configScalarDynamicField"},
        {"$ref": "#/$defs/configArrayFixedObjectItem"},
        {"$ref": "#/$defs/configArrayKeyValueObjectItem"},
        {"$ref": "#/$defs/configArrayItemReference"}
      ]
    },
    "configArrayField": {
      "type": "object", "additionalProperties": false, "required": ["type", "items"],
      "properties": {
        "type": {"const": "array"}, "title": {"type": "string"}, "description": {"type": "string"},
        "default": {"$ref": "#/$defs/configArrayValue"}, "required": {"type": "boolean"}, "sensitive": false,
        "items": {"$ref": "#/$defs/configArrayItem"},
        "choices": {"$ref": "#/$defs/configArrayChoices"},
        "validation": {"$ref": "#/$defs/configArrayValidation"}
      }
    },
    "configV3Field": {
      "oneOf": [
        {"$ref": "#/$defs/configScalarField"},
        {"$ref": "#/$defs/configV3FixedObjectField"},
        {"$ref": "#/$defs/configV3KeyValueObjectField"},
        {"$ref": "#/$defs/configArrayField"},
        {"$ref": "#/$defs/configReference"}
      ]
    },
    "configJoinSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "parts", "separator", "missing"],
      "properties": {
        "kind": {"const": "join"},
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {"path": {"type": "string", "maxLength": 128, "pattern": "^/(?:[^~/]|~[01])*$"}, "format": {"enum": ["raw", "choiceTitle"]}}
          }
        },
        "separator": {"type": "string", "maxLength": 8},
        "missing": {"type": "string"}
      }
    },
    "configV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "object",
          "propertyNames": {"not": {"enum": ["__proto__", "constructor", "prototype"]}},
          "additionalProperties": {"$ref": "#/$defs/configField"}
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "fields"],
                "properties": {
                  "id": {"type": "string"},
                  "title": {"type": "string"},
                  "description": {"type": "string"},
                  "fields": {"$ref": "#/$defs/stringArray"},
                  "advanced": {"type": "boolean"}
                }
              }
            }
          }
        }
      }
    },
    "configV3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "fields"],
      "properties": {
        "fields": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$", "not": {"enum": ["__proto__", "constructor", "prototype"]}},
          "additionalProperties": {"$ref": "#/$defs/configV3Field"}
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "fields"],
                "properties": {
                  "id": {"type": "string"},
                  "title": {"type": "string"},
                  "description": {"type": "string"},
                  "fields": {"$ref": "#/$defs/stringArray"},
                  "advanced": {"type": "boolean"}
                }
              }
            },
            "summaries": {
              "type": "object",
              "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$", "not": {"enum": ["__proto__", "constructor", "prototype"]}},
              "additionalProperties": {"$ref": "#/$defs/configJoinSummary"}
            },
            "fieldViews": {
              "type": "object",
              "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$", "not": {"enum": ["__proto__", "constructor", "prototype"]}},
              "additionalProperties": {
                "oneOf": [
                  {"type": "object", "additionalProperties": false, "required": ["summary"], "properties": {"summary": {"type": "string"}}},
                  {"type": "object", "additionalProperties": false, "required": ["itemSummary"], "properties": {"itemSummary": {"type": "string"}}}
                ]
              }
            }
          }
        },
        "schemaVersion": {"const": 3},
        "definitions": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$", "not": {"enum": ["__proto__", "constructor", "prototype"]}},
          "additionalProperties": {"$ref": "#/$defs/configV3Field"}
        }
      }
    },
    "config": {"oneOf": [{"$ref": "#/$defs/configV2"}, {"$ref": "#/$defs/configV3"}]},
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
