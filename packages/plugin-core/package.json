{
  "name": "@lesliechan721/aw-plugin-core",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./schemas/plugin-manifest-v2.json": "./schemas/plugin-manifest-v2.json"
  },
  "files": [
    "dist/",
    "schemas/"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && pnpm run generate:check && tsc -p tsconfig.json",
    "generate": "node scripts/generate-manifest-types.mjs",
    "generate:check": "node scripts/generate-manifest-types.mjs --check",
    "test": "pnpm run build && vitest run",
    "test:unit": "pnpm run build && vitest run tests/unit",
    "prepublishOnly": "node ../../scripts/release/reject-direct-publish.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fs-extra": "^11.3.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
