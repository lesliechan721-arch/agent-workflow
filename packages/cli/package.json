{
  "name": "@yiliang/aw",
  "version": "1.0.0-beta.27",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aw": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "registry": "https://packages.aliyun.com/5fa510142f8cc15c287b3dcd/npm/npm-registry/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/scripts/bundle-plugins.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:smoke:build": "vitest run --config vitest.smoke.config.ts tests/smoke/build-smoke.test.ts",
    "test:smoke:pack:cli": "vitest run --config vitest.smoke.config.ts tests/smoke/pack-smoke.test.ts",
    "test:smoke:pack:catalog": "vitest run --config vitest.smoke.config.ts tests/smoke/catalog-pack-smoke.test.ts",
    "test:smoke:pack": "pnpm run test:smoke:pack:cli && pnpm run test:smoke:pack:catalog",
    "test:smoke:fetch": "vitest run --config vitest.smoke.config.ts tests/smoke/catalog-fetch-smoke.test.ts",
    "plugin:test": "tsc -p tsconfig.json && node dist/scripts/test-plugin-scripts.js",
    "test:smoke:plugin-scripts": "vitest run --config vitest.smoke.config.ts tests/smoke/plugin-scripts-staging-smoke.test.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "chalk": "^5.4.1",
    "commander": "^14.0.1",
    "fs-extra": "^11.3.0",
    "minimatch": "^10.2.5",
    "toml-eslint-parser": "^1.0.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
