{
  "name": "@lesliechan721/aw",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "aw": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node dist/scripts/bundle-plugins.js",
    "test": "node ../../scripts/test/run-vitest.mjs run",
    "test:unit": "node ../../scripts/test/run-vitest.mjs run tests/unit",
    "test:unit:fast": "node ../../scripts/test/run-vitest.mjs run --config vitest.fast.config.ts",
    "test:integration": "node ../../scripts/test/run-vitest.mjs run tests/integration",
    "test:coverage": "node ../../scripts/test/run-vitest.mjs run --coverage",
    "test:perf": "node ../../scripts/test/run-vitest.mjs run --config vitest.perf.config.ts",
    "test:smoke": "node ../../scripts/test/run-vitest.mjs run --config vitest.smoke.config.ts",
    "test:smoke:build": "node ../../scripts/test/run-vitest.mjs run --config vitest.smoke.config.ts tests/smoke/build-smoke.test.ts",
    "test:smoke:pack:cli": "node ../../scripts/test/run-vitest.mjs run --config vitest.smoke.config.ts tests/smoke/pack-smoke.test.ts",
    "test:smoke:authoring:external": "node ../../scripts/test/run-vitest.mjs run --config vitest.smoke.config.ts tests/smoke/pack-smoke.test.ts -t \"external authoring workflow\"",
    "test:smoke:publish:catalog": "node ../../scripts/test/run-vitest.mjs run --config vitest.smoke.config.ts tests/smoke/catalog-publish-smoke.test.ts",
    "test:smoke:publish:release": "node ../../scripts/test/run-vitest.mjs run --config vitest.smoke.config.ts tests/smoke/release-publish-entry-smoke.test.ts",
    "test:smoke:bootstrap:catalog": "node ../../scripts/test/run-vitest.mjs run --config vitest.smoke.config.ts tests/smoke/catalog-bootstrap-smoke.test.ts",
    "test:smoke:fetch": "pnpm run test:smoke:publish:catalog",
    "test:smoke:ask-me-browser": "node ../../scripts/test/run-vitest.mjs run --config vitest.smoke.config.ts tests/smoke/ask-me-prototype-review-browser.test.ts",
    "plugin:test": "tsc -p tsconfig.json && node dist/scripts/test-plugin-scripts.js",
    "test:smoke:plugin-scripts": "node ../../scripts/test/run-vitest.mjs run --config vitest.smoke.config.ts tests/smoke/plugin-scripts-staging-smoke.test.ts",
    "prepack": "pnpm --dir ../.. build:ensure",
    "prepublishOnly": "node ../../scripts/release/reject-direct-publish.mjs"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@lesliechan721/agent-skill-eval": "workspace:0.1.0",
    "@lesliechan721/aw-plugin-core": "workspace:0.1.0",
    "commander": "^14.0.1",
    "fs-extra": "^11.3.0",
    "ink": "^7.1.1",
    "minimatch": "^10.2.5",
    "pnpm": "10.33.0",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "toml-eslint-parser": "^1.0.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^3.2.4",
    "ink-testing-library": "^4.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
