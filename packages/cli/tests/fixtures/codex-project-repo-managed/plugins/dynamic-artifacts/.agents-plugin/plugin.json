{
  "schemaVersion": 3,
  "name": "dynamic-artifacts",
  "version": "0.1.0",
  "description": "Fixture plugin with Codex dynamic artifact metadata.",
  "skills": "./skills",
  "scripts": {
    "artifacts": {
      "render": {
        "runner": "node",
        "path": "./scripts/render-artifacts.mjs"
      }
    }
  },
  "config": {
    "fields": {
      "enableLightweightInstruction": {
        "type": "boolean",
        "default": true
      },
      "explorerModel": {
        "type": "string",
        "default": "gpt-5.4-mini"
      },
      "modelReasoningEffort": {
        "type": "string",
        "choices": {
          "allowCustom": false,
          "presets": [
            { "id": "low", "title": "Low", "value": "low" },
            { "id": "medium", "title": "Medium", "value": "medium" },
            { "id": "high", "title": "High", "value": "high" },
            { "id": "xhigh", "title": "Extra high", "value": "xhigh" }
          ]
        },
        "default": "medium"
      }
    }
  },
  "artifacts": {
    "targets": [
      {
        "id": "lightweight-instruction",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.developerInstructionsBlock",
        "projectManagedKind": "instruction",
        "states": ["present", "disabled"],
        "refreshKeys": [
          "enableLightweightInstruction",
          "explorerModel",
          "modelReasoningEffort"
        ],
        "requiresCodexProjectConfig": true
      },
      {
        "id": "codex-explorer-role",
        "platform": "codex",
        "scopes": ["user", "project"],
        "target": "codex.agentRole",
        "projectManagedKind": "agent",
        "states": ["present"],
        "refreshKeys": ["explorerModel", "modelReasoningEffort"],
        "requiresCodexProjectConfig": true,
        "roleKey": "codex-explorer"
      }
    ]
  },
  "marketplace": {
    "category": "workflow",
    "tags": ["codex-project", "dynamic-artifacts"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": ["CODEX"]
    }
  },
  "interface": {
    "displayName": "Dynamic Artifacts Fixture",
    "shortDescription": "Dynamic artifact metadata fixture",
    "capabilities": ["Skills", "Dynamic Artifacts"]
  }
}
