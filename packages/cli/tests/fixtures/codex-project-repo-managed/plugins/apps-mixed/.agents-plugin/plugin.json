{
  "name": "apps-mixed",
  "version": "0.1.0",
  "description": "Fixture plugin combining a repo skill with Codex apps; project scope must reject the whole plugin.",
  "compatibility": {
    "aw": {
      "minVersion": "0.0.0"
    }
  },
  "skills": "./skills",
  "skillTriggers": {
    "app-helper": {
      "defaultTrigger": "auto",
      "allowDynamicTrigger": true
    }
  },
  "apps": "./.app.json",
  "marketplace": {
    "category": "workflow",
    "tags": ["codex-project", "skills", "apps"],
    "strict": true,
    "policy": {
      "installation": "AVAILABLE",
      "authentication": "ON_INSTALL",
      "products": ["CODEX"]
    }
  },
  "interface": {
    "displayName": "Apps Mixed Fixture",
    "shortDescription": "Skills plus apps",
    "capabilities": ["Skills", "Apps"]
  }
}
