{
  "name": "agent-workflows",
  "private": true,
  "version": "1.0.0-beta.27",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @yiliang/aw build",
    "test": "pnpm --filter @yiliang/aw test",
    "test:unit": "pnpm --filter @yiliang/aw test:unit",
    "test:integration": "pnpm --filter @yiliang/aw test:integration",
    "test:coverage": "pnpm --filter @yiliang/aw test:coverage",
    "test:smoke": "pnpm --filter @yiliang/aw test:smoke",
    "test:smoke:build": "pnpm --filter @yiliang/aw test:smoke:build",
    "test:smoke:pack:cli": "pnpm --filter @yiliang/aw test:smoke:pack:cli",
    "test:smoke:pack:catalog": "pnpm --filter @yiliang/aw test:smoke:pack:catalog",
    "test:smoke:pack": "pnpm --filter @yiliang/aw test:smoke:pack",
    "test:smoke:fetch": "pnpm --filter @yiliang/aw test:smoke:fetch",
    "plugin:test": "pnpm --filter @yiliang/aw plugin:test --",
    "test:smoke:plugin-scripts": "pnpm --filter @yiliang/aw test:smoke:plugin-scripts",
    "pack:cli": "pnpm --filter @yiliang/aw pack",
    "release:verify:cli": "pnpm test && pnpm test:smoke:build && pnpm test:smoke:pack:cli && pnpm test:smoke:fetch",
    "release:verify:catalog": "pnpm build && pnpm test:smoke:build && pnpm test:smoke:pack:catalog",
    "release:verify:local": "pnpm run release:verify:cli",
    "release:verify": "pnpm run release:verify:cli && pnpm run release:verify:catalog",
    "release:pack:cli": "node scripts/release/pack-cli.mjs",
    "release:pack:catalog": "node scripts/release/pack-catalog.mjs",
    "release:pack": "node scripts/release/pack-release.mjs",
    "release:install:local": "node scripts/release/install-local-tarball.mjs",
    "release:local": "pnpm run release:verify:cli && pnpm run release:pack:cli && pnpm run release:install:local",
    "release:publish:cli:beta": "node scripts/release/publish-cli.mjs beta",
    "release:publish:cli:latest": "node scripts/release/publish-cli.mjs latest",
    "release:publish:catalog:beta": "node scripts/release/publish-catalog.mjs beta",
    "release:publish:catalog:latest": "node scripts/release/publish-catalog.mjs latest",
    "release:publish:beta": "node scripts/release/publish-release.mjs beta",
    "release:publish:latest": "node scripts/release/publish-release.mjs latest",
    "publish:cli": "pnpm run release:publish:cli:latest",
    "publish:cli:raw": "pnpm --filter @yiliang/aw publish --tag latest",
    "publish:cli:beta:raw": "pnpm --filter @yiliang/aw publish --tag beta",
    "version:set": "node scripts/release/sync-version.mjs",
    "version:set:beta": "node scripts/release/sync-version.mjs --kind prerelease",
    "version:set:release": "node scripts/release/sync-version.mjs --kind stable",
    "version:catalog:check": "node scripts/release/sync-version.mjs --target catalog",
    "version:catalog:check:beta": "node scripts/release/sync-version.mjs --target catalog --kind prerelease",
    "version:catalog:check:release": "node scripts/release/sync-version.mjs --target catalog --kind stable"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  }
}
