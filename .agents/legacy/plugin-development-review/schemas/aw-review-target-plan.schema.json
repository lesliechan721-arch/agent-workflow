{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aw-plugin-development.invalid/aw-review-target-plan.schema.json",
  "title": "AWReviewTargetPlan",
  "type": "object",
  "required": [
    "schemaVersion",
    "producer",
    "plugin",
    "pluginSourceDigest",
    "mode",
    "releaseScope",
    "expectedTargets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "producer": { "const": "prepare-aw-review-target-plan" },
    "plugin": { "type": "string", "minLength": 1 },
    "pluginSourceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mode": { "enum": ["quick", "full", "delta", "release-quality"] },
    "releaseScope": {
      "type": "object",
      "required": ["kind", "profiles"],
      "properties": {
        "kind": { "enum": ["all-supported", "explicit", "source-only"] },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["codex-user", "codex-project", "claude-user", "claude-project"]
          }
        }
      },
      "additionalProperties": false
    },
    "expectedTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "targetName", "kind", "profile", "digest", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "targetName": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["aw-plugin-skill", "materialized-skill"] },
          "profile": { "type": ["string", "null"], "minLength": 1 },
          "digest": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "status": { "enum": ["present", "missing"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
